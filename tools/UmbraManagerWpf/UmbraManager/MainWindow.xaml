<Window x:Class="UmbraManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:views="clr-namespace:UmbraManager.Views"
        xmlns:ops="clr-namespace:UmbraManager.Views.Operations"
        xmlns:npcviews="clr-namespace:UmbraManager.Views.Npcs"
        xmlns:adminv="clr-namespace:UmbraManager.Views.Admin"
        xmlns:sysviews="clr-namespace:UmbraManager.Views.SystemPages"
        Title="UmbraManager — UmbraEternum"
        Height="800" Width="1280" MinWidth="1100" MinHeight="700"
        Background="{DynamicResource MaterialDesign.Brush.Background}">
    <materialDesign:DialogHost Identifier="RootDialog">
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem Content="{Binding StatusText}"/>
            <StatusBarItem HorizontalAlignment="Right" Content="{Binding CurrentUserLabel}"/>
        </StatusBar>

        <Border DockPanel.Dock="Top" Background="{StaticResource ManagerBrush.SurfaceAlt}" Padding="12,8" BorderBrush="{StaticResource ManagerBrush.Border}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="☰" Command="{Binding ToggleNavCommand}" Width="40" Margin="0,0,8,0"
                        Style="{StaticResource ManagerCompactButton}"
                        AutomationProperties.Name="Recolher navegação"/>
                <TextBlock DockPanel.Dock="Left" Text="{Binding Breadcrumb}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding AdminConnectedSummary}" VerticalAlignment="Center" Opacity="0.8"/>
                <TextBox Width="240" HorizontalAlignment="Right" Margin="0,0,16,0"
                         Text="{Binding GlobalSearch, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Busca"
                         materialDesign:HintAssist.IsFloating="True"/>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Left" Width="{Binding NavWidth}" Background="{StaticResource ManagerBrush.SurfaceAlt}"
                BorderBrush="{StaticResource ManagerBrush.Border}" BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="UmbraManager" FontWeight="Bold" Margin="12,12,12,8"/>
                <ListBox ItemsSource="{Binding NavRoutes}"
                         SelectedValue="{Binding SelectedNavIndex}"
                         SelectedValuePath="TabIndex"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Visibility" Value="{Binding Visibility}"/>
                            <Setter Property="MinHeight" Value="36"/>
                            <Setter Property="Padding" Value="10,6"/>
                            <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel ToolTip="{Binding Title}">
                                <TextBlock Text="{Binding Group}" FontSize="10" Opacity="0.55">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsNavCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding Title}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsNavCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                    <Setter Property="Text" Value="{Binding ShortLabel}"/>
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="FontSize" Value="16"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid>
            <TabControl Margin="8" SelectedIndex="{Binding SelectedNavIndex}">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter ContentSource="SelectedContent"/>
                    </ControlTemplate>
                </TabControl.Template>
            <!-- Dashboard -->
            <TabItem Header="Dashboard">
                <ops:DashboardView/>
            </TabItem>

            <!-- Servers -->
            <TabItem Header="Servers" Visibility="{Binding TabVisibilityOps}">
                <ops:ServersView/>
            </TabItem>

            <!-- Zones -->
            <TabItem Header="Zones" Visibility="{Binding TabVisibilityOps}">
                <ops:ZonesView/>
            </TabItem>

            <!-- Players -->
            <TabItem Header="Players" Visibility="{Binding TabVisibilityOps}">
                <ops:PlayersView/>
            </TabItem>

            <!-- Logs -->
            <TabItem Header="Logs" Visibility="{Binding TabVisibilityOps}">
                <ops:LogsView/>
            </TabItem>

            <!-- Accounts -->
            <TabItem Header="Accounts" Visibility="{Binding TabVisibilitySuper}">
                <adminv:AccountsView/>
            </TabItem>

            <!-- Items -->
            <TabItem Header="Items" Visibility="{Binding TabVisibilityContent}">
                <views:ItemsEditorView/>
            </TabItem>

            <TabItem Header="Crafting" Visibility="{Binding TabVisibilityContent}">
                <views:CraftingEditorView/>
            </TabItem>

            <TabItem Header="Encantamentos" Visibility="{Binding TabVisibilityContent}">
                <views:EnchantmentsEditorView/>
            </TabItem>

            <TabItem Header="Skills" Visibility="{Binding TabVisibilityContent}">
                <views:SkillsEditorView/>
            </TabItem>
            <TabItem Header="Mob Skills" Visibility="{Binding TabVisibilityContent}">
                <views:MobSkillsEditorView/>
            </TabItem>

            <TabItem Header="Classes" Visibility="{Binding TabVisibilityContent}">
                <views:ClassesEditorView/>
            </TabItem>

            <TabItem Header="Appearance Parts" Visibility="{Binding TabVisibilityContent}">
                <views:AppearancePartsEditorView/>
            </TabItem>

            <TabItem Header="Progressão" Visibility="{Binding TabVisibilityContent}">
                <views:ProgressionEditorView/>
            </TabItem>

            <!-- NPCs -->
            <TabItem Header="NPCs" Visibility="{Binding TabVisibilityContent}">
                <npcviews:NpcEditorView/>
            </TabItem>

            <TabItem Header="Admin Hub" Visibility="{Binding TabVisibilityContent}">
                <adminv:AdminHubView/>
            </TabItem>

            <!-- Config -->
            <TabItem Header="Config" Visibility="{Binding TabVisibilitySuper}">
                <sysviews:ConfigEditorView/>
            </TabItem>

            

            <!-- Rates -->
            <TabItem Header="Rates" Visibility="{Binding TabVisibilitySuper}">
                <adminv:RatesView/>
            </TabItem>

            <!-- Audit -->
            <TabItem Header="Audit" Visibility="{Binding TabVisibilityOps}">
                <adminv:AuditView/>
            </TabItem>

            <!-- GM Console -->
            <TabItem Header="GM Console" Visibility="{Binding TabVisibilityOps}">
                <views:GmConsoleView/>
            </TabItem>

<!-- Scheduler -->
            <TabItem Header="Scheduler" Visibility="{Binding TabVisibilitySuper}">
                <sysviews:SchedulerView/>
            </TabItem>
        </TabControl>
        <Border Background="{StaticResource ManagerBrush.Error}" Padding="12,8" VerticalAlignment="Top"
                AutomationProperties.Name="Erro do editor">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding EditorError}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding EditorError}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding EditorError}" Foreground="White" TextWrapping="Wrap"/>
        </Border>
        <Border Background="#88000000" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                AutomationProperties.Name="Carregando">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="220"/>
                <TextBlock Text="{Binding BusyText}" Margin="0,8,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
        </Grid>
    </DockPanel>
    </materialDesign:DialogHost>
</Window>
