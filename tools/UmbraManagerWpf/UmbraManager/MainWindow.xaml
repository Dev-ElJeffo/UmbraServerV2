<Window x:Class="UmbraManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="UmbraManager — UmbraEternum"
        Height="800" Width="1280"
        Background="{DynamicResource MaterialDesign.Brush.Background}">
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem Content="{Binding StatusText}"/>
        </StatusBar>

        <TabControl Margin="8">
            <!-- Dashboard -->
            <TabItem Header="Dashboard">
                <ScrollViewer>
                    <StackPanel Margin="12">
                        <!-- Linha de KPIs no topo -->
                        <UniformGrid Columns="4" Margin="0,0,0,16">
                            <Border Margin="0,0,8,0" Padding="14,10" CornerRadius="6"
                                    Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
                                <StackPanel>
                                    <TextBlock Text="Players online" FontSize="11" Opacity="0.7"/>
                                    <TextBlock Text="{Binding TotalPlayers}" FontSize="28" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Margin="4,0,4,0" Padding="14,10" CornerRadius="6"
                                    Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
                                <StackPanel>
                                    <TextBlock Text="Zones ativas" FontSize="11" Opacity="0.7"/>
                                    <TextBlock Text="{Binding ActiveZones}" FontSize="28" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Margin="4,0,4,0" Padding="14,10" CornerRadius="6"
                                    Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
                                <StackPanel>
                                    <TextBlock Text="Serviços online" FontSize="11" Opacity="0.7"/>
                                    <TextBlock Text="{Binding OnlineServiceCount}" FontSize="28" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Margin="8,0,0,0" Padding="14,10" CornerRadius="6"
                                    Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
                                <StackPanel>
                                    <TextBlock Text="Admin conectados" FontSize="11" Opacity="0.7"/>
                                    <TextBlock Text="{Binding AdminConnectedSummary}" FontSize="28" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Gráfico CPU -->
                        <Border Padding="10" CornerRadius="6"
                                Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="CPU últimos minutos" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <lvc:CartesianChart Series="{Binding CpuChartSeries}" Height="200"/>
                            </StackPanel>
                        </Border>

                        <!-- Cards detalhados por serviço -->
                        <TextBlock Text="Serviços" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding DashboardCards}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,10,10" Padding="12" CornerRadius="6"
                                            Width="320" BorderThickness="2"
                                            Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="#444"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#4CAF50"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                        <Setter Property="BorderBrush" Value="#E53935"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Linha 1: Nome + LED de status -->
                                            <DockPanel Grid.Row="0" LastChildFill="True">
                                                <Ellipse DockPanel.Dock="Left" Width="12" Height="12"
                                                         Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="#E53935"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                    <Setter Property="Fill" Value="#4CAF50"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="14"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>

                                            <!-- Linha 2: ID + status texto -->
                                            <DockPanel Grid.Row="1" Margin="20,2,0,0">
                                                <TextBlock Text="{Binding ServiceId}" FontFamily="Consolas"
                                                           FontSize="11" Opacity="0.7"/>
                                                <TextBlock Text="{Binding Status}" Margin="10,0,0,0"
                                                           FontSize="11" HorizontalAlignment="Right">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#E53935"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                    <Setter Property="Foreground" Value="#4CAF50"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DockPanel>

                                            <!-- Linha 3: grade de métricas -->
                                            <Grid Grid.Row="2" Margin="20,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="PID" FontSize="10" Opacity="0.6"/>
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Porta" FontSize="10" Opacity="0.6"/>
                                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Uptime" FontSize="10" Opacity="0.6"/>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Pid}" FontFamily="Consolas"/>
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GamePort}" FontFamily="Consolas"/>
                                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding UptimeFormatted}" FontFamily="Consolas"/>
                                            </Grid>

                                            <!-- Linha 4: CPU/RAM/Admin -->
                                            <Grid Grid.Row="3" Margin="20,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="CPU" FontSize="10" Opacity="0.6"/>
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="RAM" FontSize="10" Opacity="0.6"/>
                                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Admin" FontSize="10" Opacity="0.6"/>

                                                <TextBlock Grid.Row="1" Grid.Column="0"
                                                           Text="{Binding CpuPct, StringFormat={}{0:F1}%}"
                                                           FontFamily="Consolas"/>
                                                <TextBlock Grid.Row="1" Grid.Column="1"
                                                           Text="{Binding MemMb, StringFormat={}{0:F0} MB}"
                                                           FontFamily="Consolas"/>
                                                <TextBlock Grid.Row="1" Grid.Column="2"
                                                           Text="{Binding AdminState}"
                                                           FontSize="11" TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <Border Padding="12" CornerRadius="6" Margin="0,8,0,0"
                                Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="Panorama do projeto" FontWeight="SemiBold"/>
                                    <Button DockPanel.Dock="Right" Content="Atualizar panorama"
                                            Command="{Binding RefreshProjectStateCommand}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"/>
                                </DockPanel>
                                <TextBlock Text="{Binding ProjectStateText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <UniformGrid Columns="4">
                                    <TextBlock Text="{Binding SummaryItemCount, StringFormat=Itens: {0}}" Margin="0,0,8,4"/>
                                    <TextBlock Text="{Binding SummaryNpcTemplateCount, StringFormat=NPC Templates: {0}}" Margin="0,0,8,4"/>
                                    <TextBlock Text="{Binding SummaryNpcLootCount, StringFormat=NPC Loot: {0}}" Margin="0,0,8,4"/>
                                    <TextBlock Text="{Binding SummaryExpZoneCount, StringFormat=EXP Zones: {0}}" Margin="0,0,8,4"/>
                                    <TextBlock Text="{Binding SummaryGuildCount, StringFormat=Guilds: {0}}" Margin="0,0,8,4"/>
                                    <TextBlock Text="{Binding SummaryPartyCount, StringFormat=Parties: {0}}" Margin="0,0,8,4"/>
                                    <TextBlock Text="{Binding SummaryAuctionCount, StringFormat=Leilões ativos: {0}}" Margin="0,0,8,4"/>
                                    <TextBlock Text="{Binding SummaryOpenShopCount, StringFormat=Lojas abertas: {0}}" Margin="0,0,8,4"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Servers -->
            <TabItem Header="Servers">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Start All" Command="{Binding StartAllCommand}" Margin="0,0,8,0" Style="{StaticResource MaterialDesignRaisedButton}"/>
                        <Button Content="Stop All" Command="{Binding StopAllCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Servers}" AutoGenerateColumns="False" IsReadOnly="True"
                              RowHeight="36">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="30">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="10" Height="10" HorizontalAlignment="Center"
                                                 VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#E53935"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                            <Setter Property="Fill" Value="#4CAF50"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Serviço" Binding="{Binding Definition.DisplayName}" Width="*"/>
                            <DataGridTextColumn Header="Porta" Binding="{Binding Definition.GamePort}" Width="70"/>
                            <DataGridTextColumn Header="Admin" Binding="{Binding Definition.AdminPort}" Width="70"/>
                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
                            <DataGridTextColumn Header="Admin TCP" Binding="{Binding AdminState}" Width="120"/>
                            <DataGridTextColumn Header="Métricas" Binding="{Binding Stats}" Width="220"/>
                            <DataGridTemplateColumn Header="Ações" Width="280" MinWidth="280">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Start" Margin="2" Padding="8,3" Height="28"
                                                    Command="{Binding DataContext.StartServiceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="Stop" Margin="2" Padding="8,3" Height="28"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                                    Command="{Binding DataContext.StopServiceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="Restart" Margin="2" Padding="8,3" Height="28"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                                    Command="{Binding DataContext.RestartServiceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Zones -->
            <TabItem Header="Zones">
                <DataGrid ItemsSource="{Binding Zones}" AutoGenerateColumns="False" IsReadOnly="True" Margin="8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Zone ID" Binding="{Binding ZoneId}"/>
                        <DataGridTextColumn Header="Nome" Binding="{Binding ZoneName}"/>
                        <DataGridTextColumn Header="Porta" Binding="{Binding Port}"/>
                        <DataGridTextColumn Header="Admin" Binding="{Binding AdminPort}"/>
                        <DataGridTextColumn Header="Players" Binding="{Binding PlayersOnline}"/>
                        <DataGridCheckBoxColumn Header="Online" Binding="{Binding Online}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Players -->
            <TabItem Header="Players">
                <DataGrid ItemsSource="{Binding Players}" AutoGenerateColumns="False" IsReadOnly="True" Margin="8">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Kick"
                                      Command="{Binding PlacementTarget.DataContext.KickPlayerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="Teleport"
                                      Command="{Binding PlacementTarget.DataContext.TeleportPlayerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="Broadcast"
                                      Command="{Binding PlacementTarget.DataContext.BroadcastToZoneCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding PlayerId}"/>
                        <DataGridTextColumn Header="Nome" Binding="{Binding Name}"/>
                        <DataGridTextColumn Header="Zone" Binding="{Binding ZoneService}"/>
                        <DataGridTextColumn Header="X" Binding="{Binding X, StringFormat=F1}"/>
                        <DataGridTextColumn Header="Y" Binding="{Binding Y, StringFormat=F1}"/>
                        <DataGridTextColumn Header="Z" Binding="{Binding Z, StringFormat=F1}"/>
                        <DataGridCheckBoxColumn Header="Morto" Binding="{Binding IsDead}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Logs -->
            <TabItem Header="Logs">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <ComboBox Width="120" Margin="0,0,8,0"
                                  Text="{Binding LogFilter, UpdateSourceTrigger=PropertyChanged}"
                                  materialDesign:HintAssist.Hint="Nível (ALL/DEBUG...)"/>
                        <TextBox Width="200" Margin="0,0,8,0"
                                 Text="{Binding LogSearch, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Buscar texto"/>
                        <Button Content="Exportar tudo" Command="{Binding ExportLogsCommand}" CommandParameter="{x:Null}" Margin="0,0,8,0"/>
                    </StackPanel>
                    <TabControl ItemsSource="{Binding LogTabs}">
                        <TabControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}"/>
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.ContentTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Button DockPanel.Dock="Top" Content="Exportar" HorizontalAlignment="Left" Margin="0,0,0,4"
                                            Command="{Binding DataContext.ExportLogsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding ServiceId}"/>
                                    <ListBox ItemsSource="{Binding Lines}" FontFamily="Consolas" FontSize="11"/>
                                </DockPanel>
                            </DataTemplate>
                        </TabControl.ContentTemplate>
                    </TabControl>
                </DockPanel>
            </TabItem>

            <!-- Accounts -->
            <TabItem Header="Accounts">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Atualizar" Command="{Binding RefreshAccountsCommand}" Margin="0,0,8,0"/>
                        <TextBox Width="220" Text="{Binding BanReason}" materialDesign:HintAssist.Hint="Motivo do ban"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Accounts}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                            <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="*"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                            <DataGridCheckBoxColumn Header="Admin" Binding="{Binding IsAdmin}"/>
                            <DataGridCheckBoxColumn Header="Banido" Binding="{Binding Banned}"/>
                            <DataGridTextColumn Header="Players" Binding="{Binding PlayerCount}" Width="70"/>
                            <DataGridTemplateColumn Header="Ações" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Ban" Margin="2" Padding="6,2"
                                                    Command="{Binding DataContext.BanAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="Unban" Margin="2" Padding="6,2"
                                                    Command="{Binding DataContext.UnbanAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Items -->
            <TabItem Header="Items">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="500"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="460"/>
                    </Grid.ColumnDefinitions>

                    <!-- Lista -->
                    <DockPanel Grid.Column="0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Atualizar" Command="{Binding RefreshItemsCommand}" Margin="0,0,8,0"/>
                            <Button Content="Novo item" Command="{Binding NewItemCommand}" Margin="0,0,8,0"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
                                <TextBox Width="200" Margin="0,0,8,0"
                                         Text="{Binding ItemFilterText, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Buscar nome/descrição"
                                         materialDesign:HintAssist.IsFloating="True"/>
                                <ComboBox Width="120" Margin="0,0,8,0"
                                          ItemsSource="{Binding ItemTypes}"
                                          SelectedValue="{Binding ItemFilterType}"
                                          materialDesign:HintAssist.Hint="Tipo"
                                          materialDesign:HintAssist.IsFloating="True"/>
                                <ComboBox Width="120"
                                          ItemsSource="{Binding ItemRarities}"
                                          SelectedValue="{Binding ItemFilterRarity}"
                                          materialDesign:HintAssist.Hint="Raridade"
                                          materialDesign:HintAssist.IsFloating="True"/>
                            <TextBlock Text="{Binding Items.Count, StringFormat={}{0} itens}"
                                       VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.7"/>
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" RowHeight="34"
                                  HorizontalScrollBarVisibility="Auto"
                                  CanUserResizeColumns="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="55"/>
                                <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="220">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="90"/>
                                <DataGridTextColumn Header="Subtipo" Binding="{Binding Subtype}" Width="90"/>
                                <DataGridTextColumn Header="Slot" Binding="{Binding EquipmentSlot}" Width="90"/>
                                <DataGridTextColumn Header="Raridade" Binding="{Binding Rarity}" Width="90"/>
                                <DataGridTextColumn Header="Lv" Binding="{Binding RequiredLevel}" Width="50"/>
                                <DataGridTextColumn Header="Stack" Binding="{Binding MaxStackSize}" Width="60"/>
                                <DataGridTextColumn Header="Valor" Binding="{Binding Value}" Width="80"/>
                                <DataGridCheckBoxColumn Header="Trade" Binding="{Binding Tradeable}" Width="55"/>
                                <DataGridCheckBoxColumn Header="Refin" Binding="{Binding CanBeRefined}" Width="55"/>
                                <DataGridTemplateColumn Header="Ações" Width="180" MinWidth="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Editar" Padding="8,2" Margin="0,0,4,0" Height="26"
                                                        Command="{Binding DataContext.EditItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="Excluir" Padding="8,2" Height="26"
                                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                                        Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <!-- Splitter -->
                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch" Background="Transparent"
                                  ShowsPreview="True" ResizeBehavior="PreviousAndNext"/>

                    <!-- Formulário criar/editar -->
                    <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1" Padding="14" CornerRadius="4">
                        <DockPanel>
                            <!-- Cabeçalho -->
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <TextBlock Text="{Binding ItemFormTitle}"
                                           FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding ItemFormSubtitle}"
                                           FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding ItemDesignerSummary}"
                                           FontFamily="Consolas" FontSize="11" Margin="0,6,0,0" Opacity="0.8"/>
                            </StackPanel>

                            <!-- Botões em baixo -->
                            <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Limpar" Command="{Binding NewItemCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        HorizontalAlignment="Stretch" Height="36"/>
                                <Button Grid.Column="2"
                                        Content="{Binding ItemSaveButtonText}"
                                        Command="{Binding CreateItemCommand}"
                                        HorizontalAlignment="Stretch" Height="36"
                                        Style="{StaticResource MaterialDesignRaisedButton}"/>
                            </Grid>

                            <!-- Form scrollável -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                                <StackPanel>
                                    <!-- Bloco básico -->
                                    <TextBlock Text="Identificação" FontWeight="SemiBold" Margin="0,0,0,6" Opacity="0.85"/>
                                    <TextBox Text="{Binding NewItemName, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Nome (obrigatório)"
                                             materialDesign:HintAssist.IsFloating="True"
                                             Margin="0,0,0,10"/>
                                    <TextBox Text="{Binding NewItemDescription, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Descrição"
                                             materialDesign:HintAssist.IsFloating="True"
                                             AcceptsReturn="True" Height="64" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>
                                    <TextBox Text="{Binding NewItemIconPath, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Icon path (ex: /Game/UI/Icons/Items/ICO_Sword)"
                                             materialDesign:HintAssist.IsFloating="True"
                                             Margin="0,0,0,16"/>

                                    <!-- Bloco classificação -->
                                    <TextBlock Text="Classificação" FontWeight="SemiBold" Margin="0,0,0,6" Opacity="0.85"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" ItemsSource="{Binding ItemTypes}"
                                                  SelectedValue="{Binding NewItemType}"
                                                  materialDesign:HintAssist.Hint="Tipo"
                                                  materialDesign:HintAssist.IsFloating="True"/>
                                        <ComboBox Grid.Column="2"
                                                  IsEditable="True"
                                                  ItemsSource="{Binding ItemSubtypes}"
                                                  Text="{Binding NewItemSubtype, UpdateSourceTrigger=PropertyChanged}"
                                                  materialDesign:HintAssist.Hint="Subtipo"
                                                  materialDesign:HintAssist.IsFloating="True"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" ItemsSource="{Binding ItemRarities}"
                                                  SelectedValue="{Binding NewItemRarity}"
                                                  materialDesign:HintAssist.Hint="Raridade"
                                                  materialDesign:HintAssist.IsFloating="True"/>
                                        <ComboBox Grid.Column="2" ItemsSource="{Binding ItemCategories}"
                                                  SelectedValue="{Binding NewItemCategory}"
                                                  materialDesign:HintAssist.Hint="Categoria"
                                                  materialDesign:HintAssist.IsFloating="True"/>
                                    </Grid>
                                    <ComboBox ItemsSource="{Binding ItemEquipmentSlots}"
                                              SelectedValue="{Binding NewItemSlot}"
                                              materialDesign:HintAssist.Hint="Slot equipamento"
                                              materialDesign:HintAssist.IsFloating="True"
                                              Margin="0,0,0,16"/>

                                    <!-- Bloco numérico -->
                                    <TextBlock Text="Atributos" FontWeight="SemiBold" Margin="0,0,0,6" Opacity="0.85"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding NewItemRequiredLevel, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="Nível requerido"
                                                 materialDesign:HintAssist.IsFloating="True"/>
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding NewItemMaxStack, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="Stack máximo"
                                                 materialDesign:HintAssist.IsFloating="True"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding NewItemValue, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="Valor (gold)"
                                                 materialDesign:HintAssist.IsFloating="True"/>
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding NewItemWeight, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="Peso (kg)"
                                                 materialDesign:HintAssist.IsFloating="True"/>
                                    </Grid>
                                    <TextBox Text="{Binding NewItemUseCooldownMs, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Cooldown de uso (ms)"
                                             materialDesign:HintAssist.IsFloating="True"
                                             Margin="0,0,0,10"/>

                                    <!-- Flags -->
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,16">
                                        <CheckBox Content="Negociável" IsChecked="{Binding NewItemTradeable}" Margin="0,0,16,0"/>
                                        <CheckBox Content="Refinável"  IsChecked="{Binding NewItemCanBeRefined}"/>
                                    </StackPanel>

                                    <!-- Stats JSON -->
                                    <TextBlock Text="Stats (JSON)" FontWeight="SemiBold" Margin="0,0,0,6" Opacity="0.85"/>
                                    <TextBox Text="{Binding NewItemStatsJson, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="Consolas" FontSize="11"
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             Height="140" VerticalScrollBarVisibility="Auto"
                                             materialDesign:HintAssist.Hint="{}{&quot;strength&quot;:10,&quot;physical_attack&quot;:50}"
                                             materialDesign:HintAssist.IsFloating="True"/>
                                    <TextBlock FontSize="10" Opacity="0.6" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Text="Chaves aceitas: strength, dexterity, intelligence, vitality, physical_attack, magic_attack, physical_defense, magic_defense, accuracy, dodge, critical, resistance, double_attack_rate, double_attack_resistance, health_bonus, mana_bonus, movement"/>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- NPCs -->
            <TabItem Header="NPCs">
                <TabControl Margin="4" SelectedIndex="{Binding NpcSubTabIndex, Mode=TwoWay}">
                    <!-- Templates -->
                    <TabItem Header="Templates">
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="500"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="460"/>
                            </Grid.ColumnDefinitions>

                            <DockPanel Grid.Column="0">
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="Atualizar" Command="{Binding RefreshNpcTemplatesCommand}" Margin="0,0,8,0"/>
                                    <Button Content="Novo template" Command="{Binding NewNpcTemplateCommand}" Margin="0,0,8,0"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"/>
                                    <Button Content="Loot deste mob" Command="{Binding OpenNpcLootForSelectedTemplateCommand}" Margin="0,0,8,0"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            ToolTip="Abre/carrega a tabela de loot do template selecionado"/>
                                    <Button Content="Vendor (venda)" Command="{Binding OpenVendorStockForSelectedTemplateCommand}" Margin="0,0,8,0"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            ToolTip="Abre a aba de estoque de venda do template selecionado"/>
                                    <Button Content="Quests do NPC" Command="{Binding OpenNpcQuestsForSelectedTemplateCommand}" Margin="0,0,8,0"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            ToolTip="Abre a aba de quests do template selecionado"/>
                                    <TextBlock Text="{Binding NpcTemplates.Count, StringFormat={}{0} templates}"
                                               VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.7"/>
                                </StackPanel>

                                <DataGrid ItemsSource="{Binding NpcTemplates}"
                                          SelectedItem="{Binding SelectedNpcTemplate}"
                                          AutoGenerateColumns="False" IsReadOnly="True"
                                          HeadersVisibility="Column" RowHeight="34"
                                          HorizontalScrollBarVisibility="Auto"
                                          CanUserResizeColumns="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="55">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="160">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Lv" Binding="{Binding Level}" Width="40"/>
                                        <DataGridTextColumn Header="Roam" Binding="{Binding RoamRadius, StringFormat=F0}" Width="55"/>
                                        <DataGridTextColumn Header="Aggro" Binding="{Binding AggroRadius, StringFormat=F0}" Width="55"/>
                                        <DataGridTextColumn Header="AtkR" Binding="{Binding AttackRange, StringFormat=F0}" Width="50"/>
                                        <DataGridCheckBoxColumn Header="Hostil" Binding="{Binding IsHostile}" Width="55" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Resumo" Binding="{Binding Summary}" Width="*"/>
                                        <DataGridTemplateColumn Header="Ações" Width="100" MinWidth="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Editar" Padding="8,2" Height="26"
                                                            Command="{Binding DataContext.EditNpcTemplateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>

                            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch" Background="Transparent"
                                          ShowsPreview="True" ResizeBehavior="PreviousAndNext"/>

                            <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1" Padding="14" CornerRadius="4">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                        <TextBlock Text="{Binding NpcFormTitle}"
                                                   FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>
                                        <TextBlock FontSize="11" Opacity="0.7" TextWrapping="Wrap"
                                                   Text="Selecione um template na lista. Spawn grava em npc_instances e envia opcode 100 ao zone em execução (zone_N deve estar online)."/>
                                        <TextBlock Text="{Binding NpcDesignerSummary}"
                                                   FontFamily="Consolas" FontSize="11" Margin="0,6,0,0" Opacity="0.8"/>
                                    </StackPanel>

                                    <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="8"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="Limpar" Command="{Binding NewNpcTemplateCommand}"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                                    HorizontalAlignment="Stretch" Height="36"/>
                                            <Button Grid.Column="2"
                                                    Content="{Binding NpcSaveButtonText}"
                                                    Command="{Binding SaveNpcTemplateCommand}"
                                                    HorizontalAlignment="Stretch" Height="36"
                                                    Style="{StaticResource MaterialDesignRaisedButton}"/>
                                        </Grid>
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="Criar nova instância"
                                                    Command="{Binding SpawnNpcCommand}"
                                                    HorizontalAlignment="Stretch" Height="36"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                                    ToolTip="Cria OUTRA cópia do TEMPLATE selecionado nas coords Zone/X/Y/Z. Não precisa selecionar instância."/>
                                            <Button Grid.Column="2" Content="Atualizar posição"
                                                    Command="{Binding UpdateNpcInstancePositionCommand}"
                                                    HorizontalAlignment="Stretch" Height="36"
                                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                                    ToolTip="Move a INSTÂNCIA já existente (#ID). Não cria cópia nova."/>
                                        </Grid>
                                    </Grid>

                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="Identificação" FontWeight="SemiBold" Margin="0,0,0,6" Opacity="0.85"/>
                                            <TextBox Text="{Binding NewNpcName, UpdateSourceTrigger=PropertyChanged}"
                                                     materialDesign:HintAssist.Hint="Nome (obrigatório)"
                                                     materialDesign:HintAssist.IsFloating="True"
                                                     Margin="0,0,0,10"/>
                                            <TextBox Text="{Binding NewNpcLevel, UpdateSourceTrigger=PropertyChanged}"
                                                     materialDesign:HintAssist.Hint="Level"
                                                     materialDesign:HintAssist.IsFloating="True"
                                                     Margin="0,0,0,16"/>

                                            <TextBlock Text="Vitais" FontWeight="SemiBold" Margin="0,0,0,6" Opacity="0.85"/>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Text="{Binding NewNpcMaxHealth, UpdateSourceTrigger=PropertyChanged}"
                                                         materialDesign:HintAssist.Hint="HP máximo"
                                                         materialDesign:HintAssist.IsFloating="True"/>
                                                <TextBox Grid.Column="2" Text="{Binding NewNpcMaxMana, UpdateSourceTrigger=PropertyChanged}"
                                                         materialDesign:HintAssist.Hint="MP máximo"
                                                         materialDesign:HintAssist.IsFloating="True"/>
                                            </Grid>

                                            <TextBlock Text="Atributos base" FontWeight="SemiBold" Margin="0,0,0,6" Opacity="0.85"/>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Text="{Binding NewNpcStrength, UpdateSourceTrigger=PropertyChanged}"
                                                         materialDesign:HintAssist.Hint="STR" materialDesign:HintAssist.IsFloating="True"/>
                                                <TextBox Grid.Column="2" Text="{Binding NewNpcDexterity, UpdateSourceTrigger=PropertyChanged}"
                                                         materialDesign:HintAssist.Hint="DEX" materialDesign:HintAssist.IsFloating="True"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Text="{Binding NewNpcVitality, UpdateSourceTrigger=PropertyChanged}"
                                                         materialDesign:HintAssist.Hint="VIT" materialDesign:HintAssist.IsFloating="True"/>
                                                <TextBox Grid.Column="2" Text="{Binding NewNpcIntelligence, UpdateSourceTrigger=PropertyChanged}"
                                                         materialDesign:HintAssist.Hint="INT" materialDesign:HintAssist.IsFloating="True"/>
                                            </Grid>
                                            <TextBox Text="{Binding NewNpcLuck, UpdateSourceTrigger=PropertyChanged}"
                                                     materialDesign:HintAssist.Hint="LUCK"
                                                     materialDesign:HintAssist.IsFloating="True"
                                                     Margin="0,0,0,16"/>

                                            <TextBlock Text="Combate" FontWeight="SemiBold" Margin="0,0,0,6" Opacity="0.85"/>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Text="{Binding NewNpcPhysicalAttack, UpdateSourceTrigger=PropertyChanged}"
                                                         materialDesign:HintAssist.Hint="Ataque físico" materialDesign:HintAssist.IsFloating="True"/>
                                                <TextBox Grid.Column="2" Text="{Binding NewNpcMagicAttack, UpdateSourceTrigger=PropertyChanged}"
                                                         materialDesign:HintAssist.Hint="Ataque mágico" materialDesign:HintAssist.IsFloating="True"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Text="{Binding NewNpcPhysicalDefense, UpdateSourceTrigger=PropertyChanged}"
                                                         materialDesign:HintAssist.Hint="Defesa física" materialDesign:HintAssist.IsFloating="True"/>
                                                <TextBox Grid.Column="2" Text="{Binding NewNpcMagicDefense, UpdateSourceTrigger=PropertyChanged}"
                                                         materialDesign:HintAssist.Hint="Defesa mágica" materialDesign:HintAssist.IsFloating="True"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Text="{Binding NewNpcAccuracy, UpdateSourceTrigger=PropertyChanged}"
                                                         materialDesign:HintAssist.Hint="Precisão" materialDesign:HintAssist.IsFloating="True"/>
                                                <TextBox Grid.Column="2" Text="{Binding NewNpcDodge, UpdateSourceTrigger=PropertyChanged}"
                                                         materialDesign:HintAssist.Hint="Esquiva" materialDesign:HintAssist.IsFloating="True"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Text="{Binding NewNpcCritical, UpdateSourceTrigger=PropertyChanged}"
                                                         materialDesign:HintAssist.Hint="Crítico" materialDesign:HintAssist.IsFloating="True"/>
                                                <TextBox Grid.Column="2" Text="{Binding NewNpcCriticalResistance, UpdateSourceTrigger=PropertyChanged}"
                                                         materialDesign:HintAssist.Hint="Resist. crítico" materialDesign:HintAssist.IsFloating="True"/>
                                            </Grid>

                                            <TextBlock Text="Assets UE" FontWeight="SemiBold" Margin="0,0,0,6" Opacity="0.85"/>
                                            <TextBox Text="{Binding NewNpcSkeletalMeshPath, UpdateSourceTrigger=PropertyChanged}"
                                                     materialDesign:HintAssist.Hint="Skeletal mesh path"
                                                     materialDesign:HintAssist.IsFloating="True"
                                                     Margin="0,0,0,10"/>
                                            <TextBox Text="{Binding NewNpcAnimBlueprintPath, UpdateSourceTrigger=PropertyChanged}"
                                                     materialDesign:HintAssist.Hint="Anim Blueprint path"
                                                     materialDesign:HintAssist.IsFloating="True"
                                                     Margin="0,0,0,10"/>
                                            <TextBox Text="{Binding NewNpcRightHandMeshPath, UpdateSourceTrigger=PropertyChanged}"
                                                     materialDesign:HintAssist.Hint="Mesh mão direita (HandGrip_R)"
                                                     materialDesign:HintAssist.IsFloating="True"
                                                     Margin="0,0,0,6"/>
                                            <TextBlock FontSize="11" Opacity="0.65" Margin="0,0,0,4" TextWrapping="Wrap"
                                                       Text="Offset R: colar Relative Loc/Rot/Scale do Details do soquete (Rot = X/Y/Z do UE). Depois zerar o socket no SK."/>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Text="{Binding NewNpcRightHandRelX, UpdateSourceTrigger=PropertyChanged}"
                                                         materialDesign:HintAssist.Hint="R Loc X" materialDesign:HintAssist.IsFloating="True"/>
                                                <TextBox Grid.Column="2" Text="{Binding NewNpcRightHandRelY, UpdateSourceTrigger=PropertyChanged}"
                                                         materialDesign:HintAssist.Hint="R Loc Y" materialDesign:HintAssist.IsFloating="True"/>
                                                <TextBox Grid.Column="4" Text="{Binding NewNpcRightHandRelZ, UpdateSourceTrigger=PropertyChanged}"
                                                         materialDesign:HintAssist.Hint="R Loc Z" materialDesign:HintAssist.IsFloating="True"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Text="{Binding NewNpcRightHandRelRotX, UpdateSourceTrigger=PropertyChanged}"
                                                         materialDesign:HintAssist.Hint="R Rot X" materialDesign:HintAssist.IsFloating="True"/>
                                                <TextBox Grid.Column="2" Text="{Binding NewNpcRightHandRelRotY, UpdateSourceTrigger=PropertyChanged}"
                                                         materialDesign:HintAssist.Hint="R Rot Y" materialDesign:HintAssist.IsFloating="True"/>
                                                <TextBox Grid.Column="4" Text="{Binding NewNpcRightHandRelRotZ, UpdateSourceTrigger=PropertyChanged}"
                                                         materialDesign:HintAssist.Hint="R Rot Z" materialDesign:HintAssist.IsFloating="True"/>
                                                <TextBox Grid.Column="6" Text="{Binding NewNpcRightHandRelScale, UpdateSourceTrigger=PropertyChanged}"
                                                         materialDesign:HintAssist.Hint="R Scale" materialDesign:HintAssist.IsFloating="True"/>
                                            </Grid>
                                            <TextBox Text="{Binding NewNpcLeftHandMeshPath, UpdateSourceTrigger=PropertyChanged}"
                                                     materialDesign:HintAssist.Hint="Mesh mão esquerda (HandGrip_L)"
                                                     materialDesign:HintAssist.IsFloating="True"
                                                     Margin="0,0,0,6"/>
                                            <TextBlock FontSize="11" Opacity="0.65" Margin="0,0,0,4" TextWrapping="Wrap"
                                                       Text="Offset L: colar Relative Loc/Rot/Scale do Details (Rot = X/Y/Z do UE). Depois zerar o socket no SK."/>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Text="{Binding NewNpcLeftHandRelX, UpdateSourceTrigger=PropertyChanged}"
                                                         materialDesign:HintAssist.Hint="L Loc X" materialDesign:HintAssist.IsFloating="True"/>
                                                <TextBox Grid.Column="2" Text="{Binding NewNpcLeftHandRelY, UpdateSourceTrigger=PropertyChanged}"
                                                         materialDesign:HintAssist.Hint="L Loc Y" materialDesign:HintAssist.IsFloating="True"/>
                                                <TextBox Grid.Column="4" Text="{Binding NewNpcLeftHandRelZ, UpdateSourceTrigger=PropertyChanged}"
                                                         materialDesign:HintAssist.Hint="L Loc Z" materialDesign:HintAssist.IsFloating="True"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Text="{Binding NewNpcLeftHandRelRotX, UpdateSourceTrigger=PropertyChanged}"
                                                         materialDesign:HintAssist.Hint="L Rot X" materialDesign:HintAssist.IsFloating="True"/>
                                                <TextBox Grid.Column="2" Text="{Binding NewNpcLeftHandRelRotY, UpdateSourceTrigger=PropertyChanged}"
                                                         materialDesign:HintAssist.Hint="L Rot Y" materialDesign:HintAssist.IsFloating="True"/>
                                                <TextBox Grid.Column="4" Text="{Binding NewNpcLeftHandRelRotZ, UpdateSourceTrigger=PropertyChanged}"
                                                         materialDesign:HintAssist.Hint="L Rot Z" materialDesign:HintAssist.IsFloating="True"/>
                                                <TextBox Grid.Column="6" Text="{Binding NewNpcLeftHandRelScale, UpdateSourceTrigger=PropertyChanged}"
                                                         materialDesign:HintAssist.Hint="L Scale" materialDesign:HintAssist.IsFloating="True"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Text="{Binding NewNpcMeshScale, UpdateSourceTrigger=PropertyChanged}"
                                                         materialDesign:HintAssist.Hint="Mesh scale" materialDesign:HintAssist.IsFloating="True"/>
                                                <TextBox Grid.Column="2" Text="{Binding NewNpcInteractionRadius, UpdateSourceTrigger=PropertyChanged}"
                                                         materialDesign:HintAssist.Hint="Interaction radius" materialDesign:HintAssist.IsFloating="True"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Text="{Binding NewNpcRespawnSeconds, UpdateSourceTrigger=PropertyChanged}"
                                                         materialDesign:HintAssist.Hint="Respawn (s)" materialDesign:HintAssist.IsFloating="True"/>
                                                <TextBox Grid.Column="2" Text="{Binding NewNpcKillExp, UpdateSourceTrigger=PropertyChanged}"
                                                         materialDesign:HintAssist.Hint="Kill EXP" materialDesign:HintAssist.IsFloating="True"/>
                                            </Grid>
                                            <TextBlock Text="AI / combate do mob" FontWeight="SemiBold" Margin="0,0,0,4" Opacity="0.85"/>
                                            <TextBlock FontSize="11" Opacity="0.65" TextWrapping="Wrap" Margin="0,0,0,8"
                                                       Text="Roam = área de passeio em torno do spawn. Aggro = raio que detecta o player. Leash = distância máxima do home (0 = aggro×2). Hostil = pode atacar."/>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Text="{Binding NewNpcRoamRadius, UpdateSourceTrigger=PropertyChanged}"
                                                         materialDesign:HintAssist.Hint="Raio de roam (0 = parado)" materialDesign:HintAssist.IsFloating="True"/>
                                                <TextBox Grid.Column="2" Text="{Binding NewNpcAggroRadius, UpdateSourceTrigger=PropertyChanged}"
                                                         materialDesign:HintAssist.Hint="Raio de aggro (0 = passivo)" materialDesign:HintAssist.IsFloating="True"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Text="{Binding NewNpcLeashRadius, UpdateSourceTrigger=PropertyChanged}"
                                                         materialDesign:HintAssist.Hint="Leash / volta ao home (0 = auto)" materialDesign:HintAssist.IsFloating="True"/>
                                                <TextBox Grid.Column="2" Text="{Binding NewNpcMoveSpeed, UpdateSourceTrigger=PropertyChanged}"
                                                         materialDesign:HintAssist.Hint="Velocidade de movimento" materialDesign:HintAssist.IsFloating="True"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Text="{Binding NewNpcAttackRange, UpdateSourceTrigger=PropertyChanged}"
                                                         materialDesign:HintAssist.Hint="Alcance de ataque" materialDesign:HintAssist.IsFloating="True"/>
                                                <TextBox Grid.Column="2" Text="{Binding NewNpcAttackCooldownMs, UpdateSourceTrigger=PropertyChanged}"
                                                         materialDesign:HintAssist.Hint="Cooldownown do ataque (ms)" materialDesign:HintAssist.IsFloating="True"/>
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <CheckBox Content="Atacável" IsChecked="{Binding NewNpcIsAttackable}" Margin="0,0,16,0"/>
                                                <CheckBox Content="Hostil" IsChecked="{Binding NewNpcIsHostile}" Margin="0,0,16,0"/>
                                                <CheckBox Content="Vendor" IsChecked="{Binding NewNpcHasVendor}" Margin="0,0,16,0"/>
                                                <CheckBox Content="Diálogo de quest" IsChecked="{Binding NewNpcHasQuestDialog}"/>
                                            </StackPanel>
                                            <TextBox Text="{Binding NewNpcDialogTitle, UpdateSourceTrigger=PropertyChanged}"
                                                     materialDesign:HintAssist.Hint="Título de diálogo"
                                                     materialDesign:HintAssist.IsFloating="True"
                                                     Margin="0,0,0,10"/>
                                            <TextBox Text="{Binding NewNpcDialogText, UpdateSourceTrigger=PropertyChanged}"
                                                     materialDesign:HintAssist.Hint="Texto de diálogo"
                                                     materialDesign:HintAssist.IsFloating="True"
                                                     AcceptsReturn="True" Height="72" TextWrapping="Wrap"
                                                     VerticalScrollBarVisibility="Auto" Margin="0,0,0,16"/>

                                            <TextBlock Text="Spawn / posição da instância" FontWeight="SemiBold" Margin="0,0,0,6" Opacity="0.85"/>
                                            <TextBlock FontSize="11" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,4"
                                                       Text="1) Selecione o TEMPLATE na lista. 2) Ajuste Zone/X/Y/Z. 3) Criar nova instância = nova cópia. Atualizar posição = move a instância #ID (precisa selecionar instância)."/>
                                            <TextBlock Text="{Binding SpawnTemplateLabel}" FontWeight="SemiBold"
                                                       Foreground="#FFCE93D8" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding EditingNpcInstanceLabel}" FontWeight="SemiBold"
                                                       Foreground="#FF80CBC4" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                            <TextBox Text="{Binding EditingNpcInstanceId, UpdateSourceTrigger=PropertyChanged}"
                                                     materialDesign:HintAssist.Hint="ID da instância — só para Atualizar posição"
                                                     materialDesign:HintAssist.IsFloating="True"
                                                     Margin="0,0,0,10"/>
                                    <TextBox Text="{Binding SpawnZoneId, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Zone ID (0=zone_0, 1=zone_1)"
                                                     materialDesign:HintAssist.IsFloating="True"
                                                     Margin="0,0,0,10"/>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Text="{Binding SpawnPosX, UpdateSourceTrigger=PropertyChanged}"
                                                         materialDesign:HintAssist.Hint="Pos X" materialDesign:HintAssist.IsFloating="True"/>
                                                <TextBox Grid.Column="2" Text="{Binding SpawnPosY, UpdateSourceTrigger=PropertyChanged}"
                                                         materialDesign:HintAssist.Hint="Pos Y" materialDesign:HintAssist.IsFloating="True"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Text="{Binding SpawnPosZ, UpdateSourceTrigger=PropertyChanged}"
                                                         materialDesign:HintAssist.Hint="Pos Z (default 200)" materialDesign:HintAssist.IsFloating="True"/>
                                                <TextBox Grid.Column="2" Text="{Binding SpawnYaw, UpdateSourceTrigger=PropertyChanged}"
                                                         materialDesign:HintAssist.Hint="Yaw" materialDesign:HintAssist.IsFloating="True"/>
                                            </Grid>
                                            <Button Content="Copiar posição do player"
                                                    Command="{Binding CopySpawnFromPlayerCommand}"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                                    HorizontalAlignment="Stretch" Height="32" Margin="0,0,0,8"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- Instâncias no mundo -->
                    <TabItem Header="Instâncias no mundo">
                        <DockPanel Margin="8">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Atualizar instâncias" Command="{Binding RefreshNpcInstancesCommand}" Margin="0,0,8,0"/>
                                <Button Content="Duplicar em nova posição" Command="{Binding DuplicateNpcInstanceCommand}" Margin="0,0,8,0"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        ToolTip="Usa o template da instância selecionada e cria outra nas coords Zone/X/Y/Z do formulário Templates"/>
                                <TextBox Width="80" Margin="0,0,8,0"
                                         Text="{Binding InstanceZoneFilter, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Filtro zone (0=todas)"
                                         materialDesign:HintAssist.IsFloating="True"/>
                                <TextBlock Text="{Binding NpcInstances.Count, StringFormat={}{0} instância(s)}"
                                           VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.7"/>
                            </StackPanel>

                            <DataGrid ItemsSource="{Binding NpcInstances}"
                                      SelectedItem="{Binding SelectedNpcInstance}"
                                      AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Preencher spawn / editar posição (aba Templates)"
                                                  Command="{Binding PlacementTarget.DataContext.FillSpawnFromInstanceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <MenuItem Header="Duplicar em nova posição"
                                                  Command="{Binding PlacementTarget.DataContext.DuplicateNpcInstanceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <MenuItem Header="Atualizar posição no mundo"
                                                  Command="{Binding PlacementTarget.DataContext.UpdateNpcInstancePositionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <MenuItem Header="Despawar runtime"
                                                  Command="{Binding PlacementTarget.DataContext.DespawnNpcInstanceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <Separator/>
                                        <MenuItem Header="Excluir instância"
                                                  Command="{Binding PlacementTarget.DataContext.DeleteNpcInstanceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Instance ID" Binding="{Binding InstanceId}" Width="90"/>
                                    <DataGridTextColumn Header="Template" Binding="{Binding TemplateLabel}" Width="200"/>
                                    <DataGridTextColumn Header="Zone" Binding="{Binding ZoneId}" Width="55"/>
                                    <DataGridTextColumn Header="X" Binding="{Binding PosX, StringFormat=F1}" Width="80"/>
                                    <DataGridTextColumn Header="Y" Binding="{Binding PosY, StringFormat=F1}" Width="80"/>
                                    <DataGridTextColumn Header="Z" Binding="{Binding PosZ, StringFormat=F1}" Width="80"/>
                                    <DataGridTextColumn Header="Yaw" Binding="{Binding Yaw, StringFormat=F1}" Width="60"/>
                                    <DataGridTextColumn Header="HP" Binding="{Binding CurrentHealth}" Width="70"/>
                                    <DataGridCheckBoxColumn Header="Morto" Binding="{Binding IsDead}" Width="60"/>
                                    <DataGridTextColumn Header="Criado" Binding="{Binding CreatedAt}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>

                    <!-- Loot do mob (template selecionado) -->
                    <TabItem Header="Loot do mob">
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="420"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="420"/>
                            </Grid.ColumnDefinitions>

                            <DockPanel Grid.Column="0">
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding LootTargetLabel}" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Carregar loot" Command="{Binding RefreshNpcLootCommand}" Margin="0,0,8,0"/>
                                        <Button Content="Usar template selecionado" Command="{Binding OpenNpcLootForSelectedTemplateCommand}" Margin="0,0,8,0"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"/>
                                        <Button Content="Nova entrada" Command="{Binding NewNpcLootEntryCommand}" Margin="0,0,8,0"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"/>
                                        <TextBlock Text="{Binding NpcLootEntries.Count, StringFormat={}{0} entradas}"
                                                   VerticalAlignment="Center" Opacity="0.7"/>
                                    </StackPanel>
                                </StackPanel>

                                <DataGrid ItemsSource="{Binding NpcLootEntries}" AutoGenerateColumns="False" IsReadOnly="True"
                                          HeadersVisibility="Column" RowHeight="34">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID" Binding="{Binding LootEntryId}" Width="55"/>
                                        <DataGridTextColumn Header="Tipo" Binding="{Binding EntryKindLabel}" Width="70"/>
                                        <DataGridTextColumn Header="Item / Gold" Binding="{Binding ItemLabel}" Width="*"/>
                                        <DataGridTextColumn Header="Chance" Binding="{Binding DropChanceLabel}" Width="80"/>
                                        <DataGridTextColumn Header="Qtd" Binding="{Binding QuantityLabel}" Width="80"/>
                                        <DataGridCheckBoxColumn Header="Ativo" Binding="{Binding Enabled}" Width="55"/>
                                        <DataGridTextColumn Header="Ord" Binding="{Binding SortOrder}" Width="45"/>
                                        <DataGridTemplateColumn Header="Ações" Width="150">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="Editar" Margin="2" Padding="8,2" Height="26"
                                                                Command="{Binding DataContext.EditNpcLootEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Content="Excluir" Margin="2" Padding="8,2" Height="26"
                                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                                Command="{Binding DataContext.DeleteNpcLootEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>

                            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch" Background="Transparent"
                                          ShowsPreview="True" ResizeBehavior="PreviousAndNext"/>

                            <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1" Padding="14" CornerRadius="4">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="{Binding LootFormTitle}" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>
                                        <TextBlock FontSize="11" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,12"
                                                   Text="Adiciona drops ao template do mob (npc_loot_entries). Chance 0.25 = 25%."/>

                                        <TextBlock Text="Tipo de drop" FontWeight="SemiBold" Margin="0,0,0,6" Opacity="0.85"/>
                                        <ComboBox SelectedIndex="{Binding LootEntryKind, Mode=TwoWay}" Margin="0,0,0,12">
                                            <ComboBoxItem Content="Item"/>
                                            <ComboBoxItem Content="Gold"/>
                                        </ComboBox>

                                        <TextBlock Text="Escolher item" FontWeight="SemiBold" Margin="0,0,0,6" Opacity="0.85"/>
                                        <ComboBox ItemsSource="{Binding Items}"
                                                  DisplayMemberPath="Name"
                                                  SelectedValuePath="Id"
                                                  SelectedValue="{Binding LootItemTemplateId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEditable="True"
                                                  StaysOpenOnEdit="True"
                                                  IsTextSearchEnabled="True"
                                                  Margin="0,0,0,8"
                                                  materialDesign:HintAssist.Hint="Buscar item por nome"
                                                  materialDesign:HintAssist.IsFloating="True"/>
                                        <TextBox Text="{Binding LootItemTemplateId, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="Item Template ID"
                                                 materialDesign:HintAssist.IsFloating="True"
                                                 Margin="0,0,0,12"/>

                                        <TextBlock Text="Chance e quantidade" FontWeight="SemiBold" Margin="0,0,0,6" Opacity="0.85"/>
                                        <TextBox Text="{Binding LootDropChance, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="Chance (0 a 1)"
                                                 materialDesign:HintAssist.IsFloating="True"
                                                 Margin="0,0,0,8"/>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding LootMinQty, UpdateSourceTrigger=PropertyChanged}"
                                                     materialDesign:HintAssist.Hint="Qtd mín."
                                                     materialDesign:HintAssist.IsFloating="True"/>
                                            <TextBox Grid.Column="2" Text="{Binding LootMaxQty, UpdateSourceTrigger=PropertyChanged}"
                                                     materialDesign:HintAssist.Hint="Qtd máx."
                                                     materialDesign:HintAssist.IsFloating="True"/>
                                        </Grid>
                                        <TextBox Text="{Binding LootSortOrder, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="Ordem (sort)"
                                                 materialDesign:HintAssist.IsFloating="True"
                                                 Margin="0,0,0,8"/>
                                        <CheckBox Content="Ativo" IsChecked="{Binding LootEnabled}" Margin="0,0,0,12"/>

                                        <Button Content="Salvar loot" Command="{Binding SaveNpcLootEntryCommand}"
                                                Height="36" Style="{StaticResource MaterialDesignRaisedButton}"
                                                HorizontalAlignment="Stretch"/>
                                        <Button Content="Limpar formulário" Command="{Binding NewNpcLootEntryCommand}"
                                                Height="32" Margin="0,8,0,0"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- Vendor (venda) -->
                    <TabItem Header="Vendor (venda)">
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="420"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="420"/>
                            </Grid.ColumnDefinitions>

                            <DockPanel Grid.Column="0">
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding VendorTargetLabel}" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding VendorTabHint}" Margin="0,0,0,8" TextWrapping="Wrap" Opacity="0.8" FontSize="12"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Carregar estoque" Command="{Binding RefreshVendorStockCommand}" Margin="0,0,8,0"/>
                                        <Button Content="Ensure vendor" Command="{Binding EnsureNpcVendorCommand}" Margin="0,0,8,0"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"/>
                                        <Button Content="Novo item" Command="{Binding NewVendorStockEntryCommand}" Margin="0,0,8,0"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"/>
                                        <TextBlock Text="{Binding VendorStockEntries.Count, StringFormat={}{0} itens}"
                                                   VerticalAlignment="Center" Opacity="0.7"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBox Width="180" Margin="0,0,8,0"
                                                 Text="{Binding VendorDisplayName, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="Nome da loja"
                                                 materialDesign:HintAssist.IsFloating="True"/>
                                        <TextBox Width="100" Margin="0,0,8,0"
                                                 Text="{Binding VendorSellRatePercent, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="Sell % (buyback)"
                                                 materialDesign:HintAssist.IsFloating="True"/>
                                    </StackPanel>
                                </StackPanel>

                                <DataGrid ItemsSource="{Binding VendorStockEntries}" AutoGenerateColumns="False" IsReadOnly="True"
                                          HeadersVisibility="Column" RowHeight="34">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID" Binding="{Binding StockId}" Width="55"/>
                                        <DataGridTextColumn Header="Item" Binding="{Binding ItemLabel}" Width="*"/>
                                        <DataGridTextColumn Header="Preço" Binding="{Binding BuyPriceGold}" Width="70"/>
                                        <DataGridTextColumn Header="Estoque" Binding="{Binding StockQtyLabel}" Width="70"/>
                                        <DataGridTextColumn Header="Max/tx" Binding="{Binding MaxBuyPerTx}" Width="60"/>
                                        <DataGridCheckBoxColumn Header="Ativo" Binding="{Binding IsActive}" Width="55"/>
                                        <DataGridTextColumn Header="Ord" Binding="{Binding SortOrder}" Width="45"/>
                                        <DataGridTemplateColumn Header="Ações" Width="150">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="Editar" Margin="2" Padding="8,2" Height="26"
                                                                Command="{Binding DataContext.EditVendorStockEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Content="Excluir" Margin="2" Padding="8,2" Height="26"
                                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                                Command="{Binding DataContext.DeleteVendorStockEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>

                            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch" Background="Transparent"
                                          ShowsPreview="True" ResizeBehavior="PreviousAndNext"/>

                            <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1" Padding="14" CornerRadius="4">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="{Binding VendorFormTitle}" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>
                                        <TextBlock FontSize="11" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,12"
                                                   Text="Itens vendidos por este NPC (npc_vendor_stock). Qty -1 = estoque infinito."/>

                                        <TextBlock Text="Escolher item" FontWeight="SemiBold" Margin="0,0,0,6" Opacity="0.85"/>
                                        <ComboBox ItemsSource="{Binding Items}"
                                                  DisplayMemberPath="Name"
                                                  SelectedValuePath="Id"
                                                  SelectedValue="{Binding VendorStockItemTemplateId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEditable="True"
                                                  StaysOpenOnEdit="True"
                                                  IsTextSearchEnabled="True"
                                                  Margin="0,0,0,8"
                                                  materialDesign:HintAssist.Hint="Item"/>
                                        <TextBox Text="{Binding VendorStockItemTemplateId, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,0,8"
                                                 materialDesign:HintAssist.Hint="Item Template ID"
                                                 materialDesign:HintAssist.IsFloating="True"/>

                                        <TextBox Text="{Binding VendorStockBuyPrice, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,0,8"
                                                 materialDesign:HintAssist.Hint="Preço (gold)"
                                                 materialDesign:HintAssist.IsFloating="True"/>
                                        <TextBox Text="{Binding VendorStockQty, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,0,8"
                                                 materialDesign:HintAssist.Hint="Estoque (-1 = ∞)"
                                                 materialDesign:HintAssist.IsFloating="True"/>
                                        <TextBox Text="{Binding VendorStockMaxBuy, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,0,8"
                                                 materialDesign:HintAssist.Hint="Máx por compra"
                                                 materialDesign:HintAssist.IsFloating="True"/>
                                        <TextBox Text="{Binding VendorStockSortOrder, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,0,8"
                                                 materialDesign:HintAssist.Hint="Ordem"
                                                 materialDesign:HintAssist.IsFloating="True"/>
                                        <CheckBox Content="Ativo" IsChecked="{Binding VendorStockIsActive}" Margin="0,0,0,12"/>

                                        <Button Content="Salvar estoque" Command="{Binding SaveVendorStockEntryCommand}"
                                                Height="36" Style="{StaticResource MaterialDesignRaisedButton}"
                                                HorizontalAlignment="Stretch"/>
                                        <Button Content="Limpar formulário" Command="{Binding NewVendorStockEntryCommand}"
                                                Height="32" Margin="0,8,0,0"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- Quests do NPC -->
                    <TabItem Header="Quests do NPC">
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="380"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="480"/>
                            </Grid.ColumnDefinitions>

                            <DockPanel Grid.Column="0">
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding QuestTargetLabel}" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding QuestTabHint}" Margin="0,0,0,8" TextWrapping="Wrap" Opacity="0.8" FontSize="12"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Carregar quests" Command="{Binding RefreshNpcQuestOffersCommand}" Margin="0,0,8,0"/>
                                        <Button Content="Nova quest" Command="{Binding NewNpcQuestCommand}" Margin="0,0,8,0"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                IsEnabled="{Binding CanEditNpcQuests}"/>
                                        <TextBlock Text="{Binding NpcQuestOffers.Count, StringFormat={}{0} offers}"
                                                   VerticalAlignment="Center" Opacity="0.7"/>
                                    </StackPanel>
                                </StackPanel>

                                <DataGrid ItemsSource="{Binding NpcQuestOffers}" AutoGenerateColumns="False" IsReadOnly="True"
                                          HeadersVisibility="Column" RowHeight="34">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Offer" Binding="{Binding OfferId}" Width="55"/>
                                        <DataGridTextColumn Header="Quest" Binding="{Binding QuestId}" Width="55"/>
                                        <DataGridTextColumn Header="Key" Binding="{Binding QuestKey}" Width="140"/>
                                        <DataGridTextColumn Header="Título" Binding="{Binding Title}" Width="*"/>
                                        <DataGridTextColumn Header="Lv" Binding="{Binding MinLevel}" Width="40"/>
                                        <DataGridCheckBoxColumn Header="Ativa" Binding="{Binding IsActive}" Width="50"/>
                                        <DataGridTemplateColumn Header="Ações" Width="220">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="Editar" Margin="2" Padding="6,2" Height="26"
                                                                Command="{Binding DataContext.EditNpcQuestOfferCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Content="Unlink" Margin="2" Padding="6,2" Height="26"
                                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                                Command="{Binding DataContext.DeleteNpcQuestOfferCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Content="Apagar" Margin="2" Padding="6,2" Height="26"
                                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                                Command="{Binding DataContext.DeleteNpcQuestCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>

                            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch" Background="Transparent"
                                          ShowsPreview="True" ResizeBehavior="PreviousAndNext"/>

                            <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1" Padding="14" CornerRadius="4">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="{Binding QuestFormTitle}" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>
                                        <TextBlock FontSize="11" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,12"
                                                   Text="Cria/edita quest + offer neste NPC. Objetivos: talk/kill/collect/deliver (+ JSON para reach_area)."/>

                                        <TextBox Text="{Binding QuestKey, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                                                 materialDesign:HintAssist.Hint="quest_key (único)"
                                                 materialDesign:HintAssist.IsFloating="True"/>
                                        <TextBox Text="{Binding QuestTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                                                 materialDesign:HintAssist.Hint="Título"
                                                 materialDesign:HintAssist.IsFloating="True"/>
                                        <TextBox Text="{Binding QuestDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                                                 AcceptsReturn="True" Height="48" TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 materialDesign:HintAssist.Hint="Descrição"
                                                 materialDesign:HintAssist.IsFloating="True"/>
                                        <TextBox Text="{Binding QuestOfferText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                                                 AcceptsReturn="True" Height="48" TextWrapping="Wrap"
                                                 materialDesign:HintAssist.Hint="Texto de oferta"
                                                 materialDesign:HintAssist.IsFloating="True"/>
                                        <TextBox Text="{Binding QuestTurnInText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                                                 AcceptsReturn="True" Height="48" TextWrapping="Wrap"
                                                 materialDesign:HintAssist.Hint="Texto de entrega"
                                                 materialDesign:HintAssist.IsFloating="True"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBox Width="80" Margin="0,0,8,0"
                                                     Text="{Binding QuestMinLevel, UpdateSourceTrigger=PropertyChanged}"
                                                     materialDesign:HintAssist.Hint="Min Lv"
                                                     materialDesign:HintAssist.IsFloating="True"/>
                                            <TextBox Width="110" Margin="0,0,8,0"
                                                     Text="{Binding QuestPrerequisiteQuestId, UpdateSourceTrigger=PropertyChanged}"
                                                     materialDesign:HintAssist.Hint="Pré-req quest ID"
                                                     materialDesign:HintAssist.IsFloating="True"/>
                                            <TextBox Width="100" Margin="0,0,8,0"
                                                     Text="{Binding QuestTurnInNpcTemplateId, UpdateSourceTrigger=PropertyChanged}"
                                                     materialDesign:HintAssist.Hint="Turn-in template"
                                                     materialDesign:HintAssist.IsFloating="True"/>
                                            <TextBox Width="70"
                                                     Text="{Binding QuestOfferSortOrder, UpdateSourceTrigger=PropertyChanged}"
                                                     materialDesign:HintAssist.Hint="Ord"
                                                     materialDesign:HintAssist.IsFloating="True"/>
                                        </StackPanel>
                                        <TextBlock FontSize="11" Opacity="0.65" TextWrapping="Wrap" Margin="0,0,0,8"
                                                   Text="Pré-req quest ID: 0 = sem pré-requisito. O jogador precisa ter completado essa quest para aceitar esta."/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <CheckBox Content="Repeatable" IsChecked="{Binding QuestRepeatable}" Margin="0,0,16,0"/>
                                            <CheckBox Content="Ativa" IsChecked="{Binding QuestIsActive}"/>
                                        </StackPanel>

                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="Objetivos" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <Button DockPanel.Dock="Right" Content="+ Objetivo" Command="{Binding AddQuestObjectiveCommand}"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}" Height="28" Padding="8,0"/>
                                        </DockPanel>
                                        <DataGrid ItemsSource="{Binding QuestObjectives}"
                                                  SelectedItem="{Binding SelectedQuestObjective}"
                                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                                  HeadersVisibility="Column" MinHeight="100" MaxHeight="180" Margin="0,0,0,8"
                                                  x:Name="QuestObjectivesGrid">
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="Tipo" Width="110">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <ComboBox ItemsSource="{Binding DataContext.QuestObjectiveTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      SelectedItem="{Binding ObjectiveType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      IsEditable="False"
                                                                      VerticalAlignment="Center"
                                                                      Margin="2,1"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="Descrição" Width="*">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBox Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     BorderThickness="0"
                                                                     Background="Transparent"
                                                                     VerticalAlignment="Center"
                                                                     Margin="2,1"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="Alvo ID" Width="70">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBox Text="{Binding TargetId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     BorderThickness="0" Background="Transparent"
                                                                     VerticalAlignment="Center" Margin="2,1"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="Qtd" Width="50">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBox Text="{Binding RequiredCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     BorderThickness="0" Background="Transparent"
                                                                     VerticalAlignment="Center" Margin="2,1"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="" Width="60">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="X" Padding="6,0" Height="24"
                                                                    Command="{Binding DataContext.RemoveQuestObjectiveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBox Text="{Binding SelectedQuestObjective.ParamsJson, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,0,12" AcceptsReturn="True" Height="40" FontFamily="Consolas" FontSize="11"
                                                 materialDesign:HintAssist.Hint="Params JSON (reach_area / use_item_at)"
                                                 materialDesign:HintAssist.IsFloating="True"/>

                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="Recompensas" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <Button DockPanel.Dock="Right" Content="+ Reward" Command="{Binding AddQuestRewardCommand}"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}" Height="28" Padding="8,0"/>
                                        </DockPanel>
                                        <DataGrid ItemsSource="{Binding QuestRewards}"
                                                  SelectedItem="{Binding SelectedQuestReward}"
                                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                                  HeadersVisibility="Column" MinHeight="80" MaxHeight="150" Margin="0,0,0,12">
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="Tipo" Width="110">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <ComboBox ItemsSource="{Binding DataContext.QuestRewardTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      SelectedItem="{Binding RewardType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      IsEditable="False"
                                                                      VerticalAlignment="Center"
                                                                      Margin="2,1"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="Amount" Width="70">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBox Text="{Binding Amount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     BorderThickness="0" Background="Transparent"
                                                                     VerticalAlignment="Center" Margin="2,1"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="Item ID" Width="70">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBox Text="{Binding ItemTemplateId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     BorderThickness="0" Background="Transparent"
                                                                     VerticalAlignment="Center" Margin="2,1"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="Qty" Width="50">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBox Text="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     BorderThickness="0" Background="Transparent"
                                                                     VerticalAlignment="Center" Margin="2,1"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="" Width="60">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="X" Padding="6,0" Height="24"
                                                                    Command="{Binding DataContext.RemoveQuestRewardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <TextBlock FontSize="11" Opacity="0.65" TextWrapping="Wrap" Margin="0,0,0,6"
                                                   Text="Itens ao aceitar: concedidos no inventário ao Accept. Itens para iniciar: posse obrigatória (não consome)."/>
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="Itens ao aceitar" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <Button DockPanel.Dock="Right" Content="+ Grant" Command="{Binding AddQuestAcceptGrantCommand}"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}" Height="28" Padding="8,0"/>
                                        </DockPanel>
                                        <DataGrid ItemsSource="{Binding QuestAcceptGrants}"
                                                  SelectedItem="{Binding SelectedQuestAcceptGrant}"
                                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                                  HeadersVisibility="Column" MinHeight="60" MaxHeight="120" Margin="0,0,0,12">
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="Item ID" Width="*">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBox Text="{Binding ItemTemplateId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     BorderThickness="0" Background="Transparent"
                                                                     VerticalAlignment="Center" Margin="2,1"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="Qty" Width="50">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBox Text="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     BorderThickness="0" Background="Transparent"
                                                                     VerticalAlignment="Center" Margin="2,1"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="" Width="60">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="X" Padding="6,0" Height="24"
                                                                    Command="{Binding DataContext.RemoveQuestAcceptGrantCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="Itens para iniciar" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <Button DockPanel.Dock="Right" Content="+ Req" Command="{Binding AddQuestStartRequirementCommand}"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}" Height="28" Padding="8,0"/>
                                        </DockPanel>
                                        <DataGrid ItemsSource="{Binding QuestStartRequirements}"
                                                  SelectedItem="{Binding SelectedQuestStartRequirement}"
                                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                                  HeadersVisibility="Column" MinHeight="60" MaxHeight="120" Margin="0,0,0,12">
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="Item ID" Width="*">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBox Text="{Binding ItemTemplateId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     BorderThickness="0" Background="Transparent"
                                                                     VerticalAlignment="Center" Margin="2,1"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="Qty" Width="50">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBox Text="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     BorderThickness="0" Background="Transparent"
                                                                     VerticalAlignment="Center" Margin="2,1"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="" Width="60">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="X" Padding="6,0" Height="24"
                                                                    Command="{Binding DataContext.RemoveQuestStartRequirementCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <Button Content="Salvar quest" Command="{Binding SaveNpcQuestCommand}"
                                                Height="36" Style="{StaticResource MaterialDesignRaisedButton}"
                                                HorizontalAlignment="Stretch"/>
                                        <Button Content="Limpar formulário" Command="{Binding NewNpcQuestCommand}"
                                                Height="32" Margin="0,8,0,0"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </TabItem>

            <TabItem Header="Admin Hub">
                <TabControl Margin="4">
                    <TabItem Header="Player Inspector">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBox Width="140" Margin="0,0,8,0"
                                         Text="{Binding InspectPlayerId, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Player ID"
                                         materialDesign:HintAssist.IsFloating="True"/>
                                <Button Content="Inspecionar" Command="{Binding InspectPlayerCommand}"/>
                            </StackPanel>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="360"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Padding="12" CornerRadius="6"
                                        Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding PlayerInspector.CharacterName}" FontSize="18" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding PlayerInspector.AccountName, StringFormat=Conta: {0}}" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding PlayerInspector.ClassName, StringFormat=Classe: {0}}" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding PlayerInspector.Level, StringFormat=Level: {0}}" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding PlayerInspector.ZoneId, StringFormat=Zone: {0}}" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding PlayerInspector.GuildName, StringFormat=Guild: {0}}" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding PlayerInspector.PartyLabel, StringFormat=Party: {0}}" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding PlayerInspector.Health, StringFormat=HP: {0}}" Margin="0,12,0,0"/>
                                        <TextBlock Text="{Binding PlayerInspector.Mana, StringFormat=MP: {0}}" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding PlayerInspector.Gold, StringFormat=Gold: {0}}" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding PlayerInspector.InventoryCount, StringFormat=Inventário: {0}}" Margin="0,12,0,0"/>
                                        <TextBlock Text="{Binding PlayerInspector.StorageCount, StringFormat=Storage: {0}}" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding PlayerInspector.ActiveAuctionCount, StringFormat=Leilões ativos: {0}}" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding PlayerInspector.OpenShopCount, StringFormat=Lojas abertas: {0}}" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding PlayerInspector.ActiveQuestCount, StringFormat=Quests ativas: {0}}" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding PlayerInspector.CompletedQuestCount, StringFormat=Quests concluídas: {0}}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch" Background="Transparent"
                                              ShowsPreview="True" ResizeBehavior="PreviousAndNext"/>
                                <TabControl Grid.Column="2">
                                    <TabItem Header="Inventário/Storage">
                                        <ListBox ItemsSource="{Binding PlayerInspector.InventorySummary}" FontFamily="Consolas" FontSize="11"/>
                                    </TabItem>
                                    <TabItem Header="Social">
                                        <ListBox ItemsSource="{Binding PlayerInspector.SocialSummary}" FontFamily="Consolas" FontSize="11"/>
                                    </TabItem>
                                    <TabItem Header="Quests">
                                        <ListBox ItemsSource="{Binding PlayerInspector.QuestSummary}" FontFamily="Consolas" FontSize="11"/>
                                    </TabItem>
                                    <TabItem Header="Economia">
                                        <ListBox ItemsSource="{Binding PlayerInspector.EconomySummary}" FontFamily="Consolas" FontSize="11"/>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="NPC Loot">
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="360"/>
                            </Grid.ColumnDefinitions>
                            <DockPanel Grid.Column="0">
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBox Width="120" Margin="0,0,8,0"
                                             Text="{Binding SelectedLootNpcTemplateId, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="NPC Template ID"
                                             materialDesign:HintAssist.IsFloating="True"/>
                                    <Button Content="Carregar loot" Command="{Binding RefreshNpcLootCommand}" Margin="0,0,8,0"/>
                                    <Button Content="Novo loot" Command="{Binding NewNpcLootEntryCommand}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"/>
                                </StackPanel>
                                <DataGrid ItemsSource="{Binding NpcLootEntries}" AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID" Binding="{Binding LootEntryId}" Width="60"/>
                                        <DataGridTextColumn Header="Tipo" Binding="{Binding EntryKindLabel}" Width="80"/>
                                        <DataGridTextColumn Header="Item" Binding="{Binding ItemLabel}" Width="*"/>
                                        <DataGridTextColumn Header="Chance" Binding="{Binding DropChanceLabel}" Width="80"/>
                                        <DataGridTextColumn Header="Qtd" Binding="{Binding QuantityLabel}" Width="80"/>
                                        <DataGridCheckBoxColumn Header="Ativo" Binding="{Binding Enabled}" Width="60"/>
                                        <DataGridTextColumn Header="Sort" Binding="{Binding SortOrder}" Width="60"/>
                                        <DataGridTemplateColumn Header="Ações" Width="160">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="Editar" Margin="2"
                                                                Command="{Binding DataContext.EditNpcLootEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Content="Excluir" Margin="2"
                                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                                Command="{Binding DataContext.DeleteNpcLootEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch" Background="Transparent"
                                          ShowsPreview="True" ResizeBehavior="PreviousAndNext"/>
                            <Border Grid.Column="2" Padding="12" CornerRadius="6"
                                    Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
                                <StackPanel>
                                    <TextBlock Text="{Binding LootFormTitle}" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <ComboBox SelectedValue="{Binding LootEntryKind}" SelectedValuePath="Tag">
                                        <ComboBoxItem Content="Item" Tag="0"/>
                                        <ComboBoxItem Content="Gold" Tag="1"/>
                                    </ComboBox>
                                    <TextBox Margin="0,8,0,0" Text="{Binding LootItemTemplateId, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Item Template ID"
                                             materialDesign:HintAssist.IsFloating="True"/>
                                    <TextBox Margin="0,8,0,0" Text="{Binding LootDropChance, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Chance (0..1)"
                                             materialDesign:HintAssist.IsFloating="True"/>
                                    <TextBox Margin="0,8,0,0" Text="{Binding LootMinQty, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Qtd mín."
                                             materialDesign:HintAssist.IsFloating="True"/>
                                    <TextBox Margin="0,8,0,0" Text="{Binding LootMaxQty, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Qtd máx."
                                             materialDesign:HintAssist.IsFloating="True"/>
                                    <TextBox Margin="0,8,0,0" Text="{Binding LootSortOrder, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Sort order"
                                             materialDesign:HintAssist.IsFloating="True"/>
                                    <CheckBox Margin="0,8,0,0" Content="Ativo" IsChecked="{Binding LootEnabled}"/>
                                    <Button Margin="0,12,0,0" Content="Salvar loot" Command="{Binding SaveNpcLootEntryCommand}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="EXP Zones">
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="360"/>
                            </Grid.ColumnDefinitions>
                            <DockPanel Grid.Column="0">
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="Atualizar" Command="{Binding RefreshExpZonesCommand}" Margin="0,0,8,0"/>
                                    <Button Content="Nova zone" Command="{Binding NewExpZoneCommand}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"/>
                                </StackPanel>
                                <DataGrid ItemsSource="{Binding ExpZones}" AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID" Binding="{Binding ExpZoneId}" Width="60"/>
                                        <DataGridTextColumn Header="Zone" Binding="{Binding ZoneId}" Width="60"/>
                                        <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="180"/>
                                        <DataGridTextColumn Header="Resumo" Binding="{Binding Summary}" Width="*"/>
                                        <DataGridTemplateColumn Header="Editar" Width="90">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Editar"
                                                            Command="{Binding DataContext.EditExpZoneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch" Background="Transparent"
                                          ShowsPreview="True" ResizeBehavior="PreviousAndNext"/>
                            <Border Grid.Column="2" Padding="12" CornerRadius="6"
                                    Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="{Binding ExpZoneFormTitle}" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                                        <TextBox Text="{Binding ExpZoneZoneId, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="Zone ID"
                                                 materialDesign:HintAssist.IsFloating="True"/>
                                        <TextBox Margin="0,8,0,0" Text="{Binding ExpZoneName, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="Nome"
                                                 materialDesign:HintAssist.IsFloating="True"/>
                                        <TextBox Margin="0,8,0,0" Text="{Binding ExpZoneCenterX, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="Center X"
                                                 materialDesign:HintAssist.IsFloating="True"/>
                                        <TextBox Margin="0,8,0,0" Text="{Binding ExpZoneCenterY, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="Center Y"
                                                 materialDesign:HintAssist.IsFloating="True"/>
                                        <TextBox Margin="0,8,0,0" Text="{Binding ExpZoneCenterZ, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="Center Z"
                                                 materialDesign:HintAssist.IsFloating="True"/>
                                        <TextBox Margin="0,8,0,0" Text="{Binding ExpZoneRadius, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="Radius"
                                                 materialDesign:HintAssist.IsFloating="True"/>
                                        <TextBox Margin="0,8,0,0" Text="{Binding ExpZoneExpPerTick, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="EXP por tick"
                                                 materialDesign:HintAssist.IsFloating="True"/>
                                        <TextBox Margin="0,8,0,0" Text="{Binding ExpZoneTickIntervalSec, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="Intervalo tick (s)"
                                                 materialDesign:HintAssist.IsFloating="True"/>
                                        <CheckBox Margin="0,8,0,0" Content="Ativa" IsChecked="{Binding ExpZoneEnabled}"/>
                                        <Button Margin="0,12,0,0" Content="Salvar EXP zone" Command="{Binding SaveExpZoneCommand}"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Refinement">
                        <DockPanel Margin="8">
                            <Button DockPanel.Dock="Top" Content="Atualizar configuração" Command="{Binding RefreshRefinementConfigsCommand}"
                                    Margin="0,0,0,8" Style="{StaticResource MaterialDesignOutlinedButton}"/>
                            <DataGrid ItemsSource="{Binding RefinementConfigs}" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Nível" Binding="{Binding RefinementLevel}" Width="70"/>
                                    <DataGridTextColumn Header="Sucesso %" Binding="{Binding SuccessPercentage}" Width="90"/>
                                    <DataGridTextColumn Header="Item" Binding="{Binding RequiredItemName}" Width="220"/>
                                    <DataGridTextColumn Header="Qtd" Binding="{Binding RequiredItemQuantity}" Width="60"/>
                                    <DataGridTextColumn Header="Bonus %" Binding="{Binding BonusPercentage}" Width="90"/>
                                    <DataGridTextColumn Header="Multiplier" Binding="{Binding StatBonusMultiplier}" Width="90"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </TabItem>

            <!-- Config -->
            <TabItem Header="Config">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Validar JSON" Command="{Binding ValidateConfigCommand}" Margin="0,0,8,0"/>
                        <Button Content="Salvar arquivo" Command="{Binding SaveConfigCommand}" Margin="0,0,8,0"/>
                        <Button Content="Reload runtime" Command="{Binding ReloadConfigCommand}"/>
                        <TextBlock Text="{Binding ConfigStatus}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    </StackPanel>
                    <TextBox Text="{Binding ConfigJson, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
                </DockPanel>
            </TabItem>

            <!-- GM Console -->
            <TabItem Header="GM Console">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Padding="10" CornerRadius="6"
                            Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Catálogo de comandos"
                                       FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding GmCommandHelp}"
                                       TextWrapping="Wrap" Margin="0,8,0,0" FontSize="11" Opacity="0.8"/>
                            <DataGrid ItemsSource="{Binding GmCommands}" SelectedItem="{Binding SelectedGmCommandDefinition}"
                                      AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Comando" Binding="{Binding Name}" Width="160"/>
                                    <DataGridTextColumn Header="Escopo" Binding="{Binding ScopeLabel}" Width="80"/>
                                    <DataGridCheckBoxColumn Header="!" Binding="{Binding IsDestructive}" Width="35"/>
                                    <DataGridTemplateColumn Header="Usar" Width="70">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Usar" Padding="6,2"
                                                        Command="{Binding DataContext.UseGmCommandCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch" Background="Transparent"
                                  ShowsPreview="True" ResizeBehavior="PreviousAndNext"/>

                    <DockPanel Grid.Column="2">
                        <ListBox DockPanel.Dock="Bottom" Height="260" ItemsSource="{Binding GmOutput}" FontFamily="Consolas" FontSize="11"/>
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,8">
                            <StackPanel Orientation="Horizontal">
                                <ComboBox Width="150" ItemsSource="{Binding Definitions}" DisplayMemberPath="Id"
                                          SelectedValue="{Binding SelectedGmService}" SelectedValuePath="Id" Margin="0,0,8,0"/>
                                <Button Content="Usar comando selecionado" Command="{Binding UseGmCommandCommand}"
                                        CommandParameter="{Binding SelectedGmCommandDefinition}" Margin="0,0,8,0"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"/>
                                <Button Content="Enviar" Command="{Binding SendGmCommand}"/>
                            </StackPanel>
                            <TextBox x:Name="GmInputBox" Margin="0,8,0,0"
                                     Text="{Binding GmInput, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="comando arg=valor, suporta aspas e JSON (Tab autocomplete, ↑↓ histórico)"
                                     KeyDown="GmInput_KeyDown"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- Scheduler -->
            <TabItem Header="Scheduler">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="380"/>
                    </Grid.ColumnDefinitions>

                    <!-- Lista de tarefas + ações rápidas -->
                    <DockPanel Grid.Column="0">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="Ações rápidas" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <WrapPanel>
                                <Button Content="+ Restart stack (a cada 6h)"
                                        Command="{Binding ScheduleRestartAllCommand}"
                                        Margin="0,0,8,4" Padding="8,4"/>
                                <Button Content="+ Save positions (15 min)"
                                        Command="{Binding ScheduleSavePositionsCommand}"
                                        Margin="0,0,8,4" Padding="8,4"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"/>
                                <Button Content="+ Reload config (1h)"
                                        Command="{Binding ScheduleReloadConfigCommand}"
                                        Margin="0,0,8,4" Padding="8,4"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"/>
                                <Button Content="+ Status broadcast (30 min)"
                                        Command="{Binding ScheduleHourlyBroadcastCommand}"
                                        Margin="0,0,8,4" Padding="8,4"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"/>
                                <Button Content="+ Stats stats (5 min)"
                                        Command="{Binding ScheduleStatsLogCommand}"
                                        Margin="0,0,8,4" Padding="8,4"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"/>
                            </WrapPanel>
                        </StackPanel>

                        <TextBlock DockPanel.Dock="Top" Text="Tarefas agendadas"
                                   FontWeight="SemiBold" Margin="0,0,0,6"/>

                        <DataGrid ItemsSource="{Binding ScheduledTasks}" AutoGenerateColumns="False"
                                  IsReadOnly="True" RowHeight="34" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled}" Width="40"/>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="140" FontFamily="Consolas"/>
                                <DataGridTextColumn Header="Descrição" Binding="{Binding Description}" Width="*"/>
                                <DataGridTextColumn Header="Min" Binding="{Binding IntervalMinutes}" Width="50"/>
                                <DataGridTextColumn Header="Próx." Binding="{Binding NextRunFormatted}" Width="80" FontFamily="Consolas"/>
                                <DataGridTextColumn Header="Última" Binding="{Binding LastRunFormatted}" Width="80" FontFamily="Consolas"/>
                                <DataGridTextColumn Header="Runs" Binding="{Binding RunCount}" Width="50"/>
                                <DataGridTextColumn Header="Resultado" Binding="{Binding LastResult}" Width="120"/>
                                <DataGridTemplateColumn Header="Ações" Width="200" MinWidth="200">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Run" Padding="6,2" Margin="2" Height="26"
                                                        Command="{Binding DataContext.RunTaskNowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="Pause" Padding="6,2" Margin="2" Height="26"
                                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                                        Command="{Binding DataContext.ToggleTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="X" Padding="6,2" Margin="2" Height="26"
                                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                                        Command="{Binding DataContext.RemoveTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch" Background="Transparent"
                                  ShowsPreview="True" ResizeBehavior="PreviousAndNext"/>

                    <!-- Painel de criação custom -->
                    <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1"
                            Padding="14" CornerRadius="4">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock Text="Nova tarefa custom" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="Crie uma tarefa que executa a cada N minutos."
                                           FontSize="11" Opacity="0.7" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <Button DockPanel.Dock="Bottom"
                                    Content="Adicionar tarefa"
                                    Command="{Binding AddCustomTaskCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Height="38" Margin="0,12,0,0"/>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBox Text="{Binding NewTaskDescription, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Descrição"
                                             materialDesign:HintAssist.IsFloating="True"
                                             Margin="0,0,0,12"/>

                                    <TextBlock Text="Tipo de ação" FontWeight="SemiBold" Margin="0,0,0,4" Opacity="0.85"/>
                                    <ComboBox ItemsSource="{Binding TaskActionTypes}"
                                              SelectedValue="{Binding NewTaskAction}"
                                              materialDesign:HintAssist.Hint="Ação"
                                              materialDesign:HintAssist.IsFloating="True"
                                              Margin="0,0,0,12"/>

                                    <TextBox Text="{Binding NewTaskTarget, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Alvo (id do serviço, mensagem, comando...)"
                                             materialDesign:HintAssist.IsFloating="True"
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             MinHeight="60" VerticalScrollBarVisibility="Auto"
                                             Margin="0,0,0,12"/>

                                    <TextBox Text="{Binding NewTaskIntervalMinutes, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Intervalo (minutos)"
                                             materialDesign:HintAssist.IsFloating="True"
                                             Margin="0,0,0,12"/>

                                    <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                                            Padding="10" CornerRadius="4" Margin="0,8,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Significado de 'Alvo'" FontWeight="SemiBold" FontSize="11"/>
                                            <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.85" Margin="0,4,0,0">
                                                <Run Text="• "/>
                                                <Run FontWeight="Bold" Text="restart_stack:"/>
                                                <Run Text=" deixe vazio (afeta tudo)"/>
                                                <LineBreak/>
                                                <Run Text="• "/>
                                                <Run FontWeight="Bold" Text="restart_service:"/>
                                                <Run Text=" id do serviço (auth, world, zone_0...)"/>
                                                <LineBreak/>
                                                <Run Text="• "/>
                                                <Run FontWeight="Bold" Text="broadcast_zones:"/>
                                                <Run Text=" mensagem para todos players"/>
                                                <LineBreak/>
                                                <Run Text="• "/>
                                                <Run FontWeight="Bold" Text="save_positions:"/>
                                                <Run Text=" deixe vazio"/>
                                                <LineBreak/>
                                                <Run Text="• "/>
                                                <Run FontWeight="Bold" Text="reload_config:"/>
                                                <Run Text=" deixe vazio"/>
                                                <LineBreak/>
                                                <Run Text="• "/>
                                                <Run FontWeight="Bold" Text="custom_command:"/>
                                                <Run Text=" 'service|cmd|json_args'"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
