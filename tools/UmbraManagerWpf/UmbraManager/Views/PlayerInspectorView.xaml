<UserControl x:Class="UmbraManager.Views.PlayerInspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
<Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <WrapPanel Margin="0,0,0,8">
                                <TextBox Width="140" Margin="0,0,8,4"
                                         Text="{Binding InspectPlayerId, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Player ID"
                                         materialDesign:HintAssist.IsFloating="True"/>
                                <Button Content="Inspecionar" Command="{Binding InspectPlayerCommand}"
                                        Style="{StaticResource ManagerActionOutlinedButton}" Margin="0,0,8,4"/>
                                <Button Content="Kick" Command="{Binding KickInspectedPlayerCommand}"
                                        Style="{StaticResource ManagerActionButton}" Margin="0,0,8,4"/>
                                <Button Content="Teleport" Command="{Binding TeleportInspectedPlayerCommand}"
                                        Style="{StaticResource ManagerActionOutlinedButton}" Margin="0,0,8,4"/>
                                <Button Content="Give" Command="{Binding GiveItemToInspectedPlayerCommand}"
                                        Style="{StaticResource ManagerActionOutlinedButton}" Margin="0,0,8,4"/>
                            </WrapPanel>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="360"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource ManagerEditorCard}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <TextBlock Text="{Binding PlayerInspector.CharacterName}"
                                                       Style="{StaticResource ManagerEditorTitle}"/>
                                            <TextBlock Text="Identidade" Style="{StaticResource ManagerSectionHeader}" Margin="0,8,0,6"/>
                                            <TextBlock Text="{Binding PlayerInspector.AccountName, StringFormat=Conta: {0}}" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding PlayerInspector.ClassName, StringFormat=Classe: {0}}" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding PlayerInspector.Level, StringFormat=Level: {0}}" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding PlayerInspector.ZoneId, StringFormat=Zone: {0}}" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding PlayerInspector.GuildName, StringFormat=Guild: {0}}" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding PlayerInspector.PartyLabel, StringFormat=Party: {0}}" Margin="0,2,0,0"/>
                                            <TextBlock Text="Vitais" Style="{StaticResource ManagerSectionHeader}" Margin="0,14,0,6"/>
                                            <TextBlock Text="{Binding PlayerInspector.Health, StringFormat=HP: {0}}" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding PlayerInspector.Mana, StringFormat=MP: {0}}" Margin="0,2,0,0"/>
                                            <TextBlock Text="Economia / contagens" Style="{StaticResource ManagerSectionHeader}" Margin="0,14,0,6"/>
                                            <TextBlock Text="{Binding PlayerInspector.Gold, StringFormat=Gold: {0}}" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding PlayerInspector.InventoryCount, StringFormat=Inventário: {0}}" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding PlayerInspector.StorageCount, StringFormat=Storage: {0}}" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding PlayerInspector.ActiveAuctionCount, StringFormat=Leilões ativos: {0}}" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding PlayerInspector.OpenShopCount, StringFormat=Lojas abertas: {0}}" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding PlayerInspector.ActiveQuestCount, StringFormat=Quests ativas: {0}}" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding PlayerInspector.CompletedQuestCount, StringFormat=Quests concluídas: {0}}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch" Background="Transparent"
                                              ShowsPreview="True" ResizeBehavior="PreviousAndNext"/>
                                <TabControl Grid.Column="2">
                                    <TabItem Header="Inventário/Storage">
                                        <Border Style="{StaticResource ManagerEditorCard}" Padding="8">
                                            <DataGrid Style="{StaticResource ManagerDataGrid}"
                                                      ItemsSource="{Binding PlayerInspector.InventoryItems}" IsReadOnly="True">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Slot" Binding="{Binding SlotLabel}" Width="120"/>
                                                    <DataGridTextColumn Header="Item" Binding="{Binding ItemName}" Width="*"/>
                                                    <DataGridTextColumn Header="Tpl" Binding="{Binding ItemTemplateId}" Width="70"/>
                                                    <DataGridTextColumn Header="Qtd" Binding="{Binding Quantity}" Width="60"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Border>
                                    </TabItem>
                                    <TabItem Header="Social">
                                        <Border Style="{StaticResource ManagerEditorCard}" Padding="8">
                                            <DataGrid Style="{StaticResource ManagerDataGrid}"
                                                      ItemsSource="{Binding PlayerInspector.SocialRows}" IsReadOnly="True">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Tipo" Binding="{Binding Kind}" Width="100"/>
                                                    <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="*"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Border>
                                    </TabItem>
                                    <TabItem Header="Quests">
                                        <Border Style="{StaticResource ManagerEditorCard}" Padding="8">
                                            <DataGrid Style="{StaticResource ManagerDataGrid}"
                                                      ItemsSource="{Binding PlayerInspector.QuestRows}" IsReadOnly="True">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="ID" Binding="{Binding QuestId}" Width="70"/>
                                                    <DataGridTextColumn Header="Título" Binding="{Binding Title}" Width="*"/>
                                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Border>
                                    </TabItem>
                                    <TabItem Header="Economia">
                                        <Border Style="{StaticResource ManagerEditorCard}" Padding="8">
                                            <DataGrid Style="{StaticResource ManagerDataGrid}"
                                                      ItemsSource="{Binding PlayerInspector.EconomyRows}" IsReadOnly="True">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Tipo" Binding="{Binding Kind}" Width="100"/>
                                                    <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="*"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Border>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                        </Grid>
</UserControl>
