<UserControl x:Class="UmbraManager.Views.ClassesEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
  <Grid Margin="8">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MinWidth="360"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="560"/>
    </Grid.ColumnDefinitions>

    <DockPanel Grid.Column="0">
      <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
        <Button Content="Atualizar" Command="{Binding RefreshGameClassesCommand}" Margin="0,0,8,4"
                Style="{StaticResource ManagerActionOutlinedButton}"/>
        <Button Content="Nova classe" Command="{Binding NewGameClassCommand}" Margin="0,0,8,4"
                Style="{StaticResource ManagerActionOutlinedButton}"/>
        <TextBlock Text="{Binding GameClasses.Count, StringFormat={}{0} classes}"
                   VerticalAlignment="Center" Opacity="0.7"/>
      </WrapPanel>
      <DataGrid Style="{StaticResource ManagerDataGrid}" ItemsSource="{Binding GameClasses}"
                SelectedItem="{Binding SelectedGameClass}" IsReadOnly="True">
        <DataGrid.Columns>
          <DataGridTextColumn Header="ID" Binding="{Binding ClassId}" Width="45"/>
          <DataGridTextColumn Header="Nome" Binding="{Binding ClassName}" Width="*"/>
          <DataGridTextColumn Header="STR" Binding="{Binding BaseStrength}" Width="50"/>
          <DataGridTextColumn Header="DEX" Binding="{Binding BaseDexterity}" Width="50"/>
          <DataGridTextColumn Header="INT" Binding="{Binding BaseIntelligence}" Width="50"/>
          <DataGridTextColumn Header="VIT" Binding="{Binding BaseVitality}" Width="50"/>
          <DataGridTextColumn Header="LUK" Binding="{Binding BaseLuck}" Width="50"/>
          <DataGridTextColumn Header="HP" Binding="{Binding BaseHealth}" Width="55"/>
          <DataGridTextColumn Header="MP" Binding="{Binding BaseMana}" Width="55"/>
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>

    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"
                  ShowsPreview="True" ResizeBehavior="PreviousAndNext"/>

    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="8,0,0,12">
        <TextBlock Text="{Binding ClassFormTitle}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>
        <TextBox Text="{Binding ClassFormName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                 materialDesign:HintAssist.Hint="Nome" materialDesign:HintAssist.IsFloating="True"/>
        <TextBox Text="{Binding ClassFormDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                 AcceptsReturn="True" MinHeight="48" TextWrapping="Wrap"
                 materialDesign:HintAssist.Hint="Descrição" materialDesign:HintAssist.IsFloating="True"/>

        <TextBlock Text="Base stats" FontWeight="SemiBold" Margin="0,4,0,6"/>
        <UniformGrid Columns="3">
          <TextBox Text="{Binding ClassFormStrength}" Margin="0,0,6,6" materialDesign:HintAssist.Hint="STR" materialDesign:HintAssist.IsFloating="True"/>
          <TextBox Text="{Binding ClassFormDexterity}" Margin="0,0,6,6" materialDesign:HintAssist.Hint="DEX" materialDesign:HintAssist.IsFloating="True"/>
          <TextBox Text="{Binding ClassFormIntelligence}" Margin="0,0,0,6" materialDesign:HintAssist.Hint="INT" materialDesign:HintAssist.IsFloating="True"/>
          <TextBox Text="{Binding ClassFormVitality}" Margin="0,0,6,6" materialDesign:HintAssist.Hint="VIT" materialDesign:HintAssist.IsFloating="True"/>
          <TextBox Text="{Binding ClassFormLuck}" Margin="0,0,6,6" materialDesign:HintAssist.Hint="LUCK" materialDesign:HintAssist.IsFloating="True"/>
          <TextBox Text="{Binding ClassFormMovement}" Margin="0,0,0,6" materialDesign:HintAssist.Hint="Movement" materialDesign:HintAssist.IsFloating="True"/>
        </UniformGrid>

        <TextBlock Text="Recursos" FontWeight="SemiBold" Margin="0,8,0,6"/>
        <UniformGrid Columns="3">
          <TextBox Text="{Binding ClassFormHealth}" Margin="0,0,6,6" materialDesign:HintAssist.Hint="HP" materialDesign:HintAssist.IsFloating="True"/>
          <TextBox Text="{Binding ClassFormMana}" Margin="0,0,6,6" materialDesign:HintAssist.Hint="MP" materialDesign:HintAssist.IsFloating="True"/>
          <TextBox Text="{Binding ClassFormStamina}" Margin="0,0,0,6" materialDesign:HintAssist.Hint="Stamina" materialDesign:HintAssist.IsFloating="True"/>
        </UniformGrid>

        <TextBlock Text="Combate" FontWeight="SemiBold" Margin="0,8,0,6"/>
        <ComboBox ItemsSource="{Binding ClassDamageTypeOptions}"
                  SelectedItem="{Binding ClassFormDamageType}"
                  Margin="0,0,0,6"
                  materialDesign:HintAssist.Hint="Dano base (Physical / Magic)"
                  materialDesign:HintAssist.IsFloating="True"/>
        <UniformGrid Columns="2">
          <TextBox Text="{Binding ClassFormPhysicalAttack}" Margin="0,0,6,6" materialDesign:HintAssist.Hint="Phys Atk" materialDesign:HintAssist.IsFloating="True"/>
          <TextBox Text="{Binding ClassFormMagicAttack}" Margin="0,0,0,6" materialDesign:HintAssist.Hint="Mag Atk" materialDesign:HintAssist.IsFloating="True"/>
          <TextBox Text="{Binding ClassFormPhysicalDefense}" Margin="0,0,6,6" materialDesign:HintAssist.Hint="Phys Def" materialDesign:HintAssist.IsFloating="True"/>
          <TextBox Text="{Binding ClassFormMagicDefense}" Margin="0,0,0,6" materialDesign:HintAssist.Hint="Mag Def" materialDesign:HintAssist.IsFloating="True"/>
          <TextBox Text="{Binding ClassFormAccuracy}" Margin="0,0,6,6" materialDesign:HintAssist.Hint="Accuracy" materialDesign:HintAssist.IsFloating="True"/>
          <TextBox Text="{Binding ClassFormDodge}" Margin="0,0,0,6" materialDesign:HintAssist.Hint="Dodge" materialDesign:HintAssist.IsFloating="True"/>
          <TextBox Text="{Binding ClassFormCritical}" Margin="0,0,6,6" materialDesign:HintAssist.Hint="Critical" materialDesign:HintAssist.IsFloating="True"/>
          <TextBox Text="{Binding ClassFormCriticalResistance}" Margin="0,0,0,6" materialDesign:HintAssist.Hint="Crit resist" materialDesign:HintAssist.IsFloating="True"/>
          <TextBox Text="{Binding ClassFormDoubleAttackRate}" Margin="0,0,6,6" materialDesign:HintAssist.Hint="Double atk rate" materialDesign:HintAssist.IsFloating="True"/>
          <TextBox Text="{Binding ClassFormDoubleAttackResistance}" Margin="0,0,0,6" materialDesign:HintAssist.Hint="Double atk resist" materialDesign:HintAssist.IsFloating="True"/>
        </UniformGrid>

        <TextBlock Text="Visual (player mesh)" FontWeight="SemiBold" Margin="0,8,0,6"/>
        <TextBox Text="{Binding ClassFormSkeletalMeshPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                 materialDesign:HintAssist.Hint="skeletal_mesh_path (rig master)" materialDesign:HintAssist.IsFloating="True"/>
        <TextBox Text="{Binding ClassFormAnimBlueprintPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"
                 materialDesign:HintAssist.Hint="anim_blueprint_path" materialDesign:HintAssist.IsFloating="True"/>

        <TextBlock Text="Corpo" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBox Text="{Binding ClassFormBodyMeshPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,2"
                 materialDesign:HintAssist.Hint="body_mesh_path (SKM do corpo; grava em torso_mesh_path)" materialDesign:HintAssist.IsFloating="True"/>
        <TextBlock Text="Cabeça e cabelo: aba Appearance Parts. Equipamentos ficam por cima do body (aba Items → meshes visuais)."
                   TextWrapping="Wrap" Opacity="0.7" FontSize="11" Margin="0,0,0,8"/>

        <TextBlock Text="Armas default" FontWeight="SemiBold" Margin="0,4,0,6"/>
        <UniformGrid Columns="2" Margin="0,0,0,12">
          <TextBox Text="{Binding ClassFormMainHandMeshPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,6"
                   materialDesign:HintAssist.Hint="main_hand_mesh_path" materialDesign:HintAssist.IsFloating="True"/>
          <TextBox Text="{Binding ClassFormOffHandMeshPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                   materialDesign:HintAssist.Hint="off_hand_mesh_path" materialDesign:HintAssist.IsFloating="True"/>
        </UniformGrid>

        <TextBlock Text="Animation Set (loco / hit / death)" FontWeight="SemiBold" Margin="0,12,0,6"/>
        <TextBox Text="{Binding ClassAnimIdlePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                 materialDesign:HintAssist.Hint="Idle" materialDesign:HintAssist.IsFloating="True"/>
        <TextBox Text="{Binding ClassAnimWalkPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                 materialDesign:HintAssist.Hint="Walk (1 eixo / fallback)" materialDesign:HintAssist.IsFloating="True"/>
        <TextBox Text="{Binding ClassAnimWalkFwdPath}" Margin="0,0,0,4" materialDesign:HintAssist.Hint="Walk fwd" materialDesign:HintAssist.IsFloating="True"/>
        <TextBox Text="{Binding ClassAnimWalkBwdPath}" Margin="0,0,0,4" materialDesign:HintAssist.Hint="Walk bwd" materialDesign:HintAssist.IsFloating="True"/>
        <TextBox Text="{Binding ClassAnimWalkLeftPath}" Margin="0,0,0,4" materialDesign:HintAssist.Hint="Walk left" materialDesign:HintAssist.IsFloating="True"/>
        <TextBox Text="{Binding ClassAnimWalkRightPath}" Margin="0,0,0,6" materialDesign:HintAssist.Hint="Walk right" materialDesign:HintAssist.IsFloating="True"/>
        <TextBox Text="{Binding ClassAnimRunFwdPath}" Margin="0,0,0,4" materialDesign:HintAssist.Hint="Run fwd" materialDesign:HintAssist.IsFloating="True"/>
        <TextBox Text="{Binding ClassAnimRunBwdPath}" Margin="0,0,0,4" materialDesign:HintAssist.Hint="Run bwd" materialDesign:HintAssist.IsFloating="True"/>
        <TextBox Text="{Binding ClassAnimRunLeftPath}" Margin="0,0,0,4" materialDesign:HintAssist.Hint="Run left" materialDesign:HintAssist.IsFloating="True"/>
        <TextBox Text="{Binding ClassAnimRunRightPath}" Margin="0,0,0,6" materialDesign:HintAssist.Hint="Run right" materialDesign:HintAssist.IsFloating="True"/>
        <TextBox Text="{Binding ClassAnimHitsCsv}" Margin="0,0,0,6" materialDesign:HintAssist.Hint="Hits (; )" materialDesign:HintAssist.IsFloating="True"/>
        <TextBox Text="{Binding ClassAnimBuffsCsv}" Margin="0,0,0,6" materialDesign:HintAssist.Hint="Buffs (; )" materialDesign:HintAssist.IsFloating="True"/>
        <TextBox Text="{Binding ClassAnimDeathPath}" Margin="0,0,0,6" materialDesign:HintAssist.Hint="Death" materialDesign:HintAssist.IsFloating="True"/>
        <TextBox Text="{Binding ClassAnimDeathMs}" Margin="0,0,0,8" materialDesign:HintAssist.Hint="Death ms" materialDesign:HintAssist.IsFloating="True"/>

        <TextBlock Text="Modo combate (tecla sacar/guardar — opcode 119)" FontWeight="SemiBold" Margin="0,12,0,2"/>
        <TextBlock Text="Idle acima = relaxada (arma nas costas). Campos de combate vazios usam o conjunto normal."
                   Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,6"/>
        <TextBox Text="{Binding ClassAnimCombatIdlePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                 materialDesign:HintAssist.Hint="Idle de combate (combat_idle)" materialDesign:HintAssist.IsFloating="True"/>
        <UniformGrid Columns="2" Margin="0,0,0,6">
          <TextBox Text="{Binding ClassAnimDrawPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,6"
                   materialDesign:HintAssist.Hint="Sacar a arma (draw)" materialDesign:HintAssist.IsFloating="True"/>
          <TextBox Text="{Binding ClassAnimDrawSwapMs, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                   materialDesign:HintAssist.Hint="Sacar: ms em que a arma vai p/ a mão" materialDesign:HintAssist.IsFloating="True"/>
          <TextBox Text="{Binding ClassAnimSheathePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,6"
                   materialDesign:HintAssist.Hint="Guardar a arma (sheathe)" materialDesign:HintAssist.IsFloating="True"/>
          <TextBox Text="{Binding ClassAnimSheatheSwapMs, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                   materialDesign:HintAssist.Hint="Guardar: ms em que a arma vai p/ as costas" materialDesign:HintAssist.IsFloating="True"/>
        </UniformGrid>
        <UniformGrid Columns="2" Margin="0,0,0,8">
          <TextBox Text="{Binding ClassAnimCombatWalkFwdPath}" Margin="0,0,6,4" materialDesign:HintAssist.Hint="Combate: walk fwd" materialDesign:HintAssist.IsFloating="True"/>
          <TextBox Text="{Binding ClassAnimCombatRunFwdPath}" Margin="0,0,0,4" materialDesign:HintAssist.Hint="Combate: run fwd" materialDesign:HintAssist.IsFloating="True"/>
          <TextBox Text="{Binding ClassAnimCombatWalkBwdPath}" Margin="0,0,6,4" materialDesign:HintAssist.Hint="Combate: walk bwd" materialDesign:HintAssist.IsFloating="True"/>
          <TextBox Text="{Binding ClassAnimCombatRunBwdPath}" Margin="0,0,0,4" materialDesign:HintAssist.Hint="Combate: run bwd" materialDesign:HintAssist.IsFloating="True"/>
          <TextBox Text="{Binding ClassAnimCombatWalkLeftPath}" Margin="0,0,6,4" materialDesign:HintAssist.Hint="Combate: walk left" materialDesign:HintAssist.IsFloating="True"/>
          <TextBox Text="{Binding ClassAnimCombatRunLeftPath}" Margin="0,0,0,4" materialDesign:HintAssist.Hint="Combate: run left" materialDesign:HintAssist.IsFloating="True"/>
          <TextBox Text="{Binding ClassAnimCombatWalkRightPath}" Margin="0,0,6,4" materialDesign:HintAssist.Hint="Combate: walk right" materialDesign:HintAssist.IsFloating="True"/>
          <TextBox Text="{Binding ClassAnimCombatRunRightPath}" Margin="0,0,0,4" materialDesign:HintAssist.Hint="Combate: run right" materialDesign:HintAssist.IsFloating="True"/>
        </UniformGrid>

        <WrapPanel Margin="0,0,0,12">
          <Button Content="{Binding ClassSaveButtonText}" Command="{Binding SaveGameClassCommand}"
                  Style="{StaticResource ManagerActionButton}" Margin="0,0,8,4"/>
          <Button Content="Excluir" Command="{Binding DeleteGameClassCommand}"
                  Style="{StaticResource ManagerActionOutlinedButton}" Margin="0,0,8,4"/>
        </WrapPanel>

        <TextBlock Text="Animações por habilidade (cast_anim_path)" FontWeight="SemiBold" Margin="0,4,0,6"/>
        <TextBlock Text="Básico no topo. Cada skill deve ter um path distinto (Montage/Sequence)."
                   FontSize="11" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,6"/>
        <DataGrid ItemsSource="{Binding ClassSkillAnims}" AutoGenerateColumns="False" CanUserAddRows="False"
                  Height="260" Style="{StaticResource ManagerDataGrid}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="#" Binding="{Binding SkillOrder}" Width="36" IsReadOnly="True"/>
            <DataGridCheckBoxColumn Header="Básico" Binding="{Binding IsBasicAttack, Mode=OneWay}" Width="55"/>
            <DataGridTextColumn Header="Skill" Binding="{Binding SkillName}" Width="140" IsReadOnly="True"/>
            <DataGridTextColumn Header="cast_anim_path" Binding="{Binding CastAnimPath, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
        <Button Content="Salvar anims das skills" Command="{Binding SaveClassSkillAnimsCommand}"
                Style="{StaticResource ManagerActionButton}" Margin="0,8,0,0" HorizontalAlignment="Left"/>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
