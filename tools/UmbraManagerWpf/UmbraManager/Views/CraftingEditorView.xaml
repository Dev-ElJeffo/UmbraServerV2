<UserControl x:Class="UmbraManager.Views.CraftingEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
  <Grid Margin="8">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MinWidth="420"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="460"/>
    </Grid.ColumnDefinitions>
    <DockPanel Grid.Column="0">
      <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
        <Button Content="Atualizar" Command="{Binding RefreshCraftRecipesCommand}" Margin="0,0,8,4"
                Style="{StaticResource ManagerActionOutlinedButton}"/>
        <Button Content="Nova receita" Command="{Binding NewCraftRecipeCommand}" Margin="0,0,8,4"
                Style="{StaticResource ManagerActionOutlinedButton}"/>
        <ComboBox Width="140" Margin="0,0,8,4"
                  SelectedValue="{Binding CraftFilterCategory}" SelectedValuePath="Tag"
                  materialDesign:HintAssist.Hint="Categoria" materialDesign:HintAssist.IsFloating="True">
          <ComboBoxItem Content="Todas" Tag=""/>
          <ComboBoxItem Content="material" Tag="material"/>
          <ComboBoxItem Content="consumable" Tag="consumable"/>
          <ComboBoxItem Content="equipment" Tag="equipment"/>
        </ComboBox>
        <TextBox Width="160" Margin="0,0,8,4"
                 Text="{Binding CraftFilterText, UpdateSourceTrigger=PropertyChanged}"
                 materialDesign:HintAssist.Hint="Buscar"
                 materialDesign:HintAssist.IsFloating="True"/>
        <TextBlock Text="{Binding CraftRecipes.Count, StringFormat={}{0} receitas}"
                   VerticalAlignment="Center" Opacity="0.7"/>
      </WrapPanel>
      <DataGrid Style="{StaticResource ManagerDataGrid}" ItemsSource="{Binding CraftRecipes}" IsReadOnly="True">
        <DataGrid.Columns>
          <DataGridTextColumn Header="ID" Binding="{Binding RecipeId}" Width="50"/>
          <DataGridTextColumn Header="Key" Binding="{Binding RecipeKey}" Width="120"/>
          <DataGridTextColumn Header="Nome" Binding="{Binding DisplayName}" Width="140"/>
          <DataGridTextColumn Header="Cat" Binding="{Binding CraftCategory}" Width="90"/>
          <DataGridTextColumn Header="Resultado" Binding="{Binding ResultItemName}" Width="140"/>
          <DataGridTextColumn Header="Gold" Binding="{Binding GoldCost}" Width="50"/>
          <DataGridTextColumn Header="Modo" Binding="{Binding ModeLabel}" Width="110"/>
          <DataGridCheckBoxColumn Header="On" Binding="{Binding IsActive}" Width="40"/>
          <DataGridTemplateColumn Header="Ações" Width="90">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Button Content="Editar" Style="{StaticResource ManagerActionButton}"
                        Command="{Binding DataContext.EditCraftRecipeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>
    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"
                  ShowsPreview="True" ResizeBehavior="PreviousAndNext"/>
    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="8,0,0,12">
        <TextBlock Text="{Binding CraftFormTitle}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>
        <TextBox Text="{Binding CraftFormRecipeKey, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                 materialDesign:HintAssist.Hint="recipe_key" materialDesign:HintAssist.IsFloating="True"/>
        <TextBox Text="{Binding CraftFormDisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                 materialDesign:HintAssist.Hint="display_name" materialDesign:HintAssist.IsFloating="True"/>
        <ComboBox Margin="0,0,0,6" SelectedValue="{Binding CraftFormCategory}" SelectedValuePath="Content"
                  materialDesign:HintAssist.Hint="craft_category" materialDesign:HintAssist.IsFloating="True">
          <ComboBoxItem Content="material"/>
          <ComboBoxItem Content="consumable"/>
          <ComboBoxItem Content="equipment"/>
        </ComboBox>
        <TextBox Text="{Binding CraftFormResultItemTemplateId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                 materialDesign:HintAssist.Hint="result_item_template_id" materialDesign:HintAssist.IsFloating="True"/>
        <TextBox Text="{Binding CraftFormResultQuantity, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                 materialDesign:HintAssist.Hint="result_quantity" materialDesign:HintAssist.IsFloating="True"/>
        <TextBox Text="{Binding CraftFormGoldCost, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                 materialDesign:HintAssist.Hint="gold_cost" materialDesign:HintAssist.IsFloating="True"/>
        <TextBox Text="{Binding CraftFormMinLevel, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                 materialDesign:HintAssist.Hint="min_level" materialDesign:HintAssist.IsFloating="True"/>
        <TextBox Text="{Binding CraftFormRecipeItemTemplateId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                 materialDesign:HintAssist.Hint="recipe_item_template_id (vazio=padrão)" materialDesign:HintAssist.IsFloating="True"/>
        <TextBox Text="{Binding CraftFormAllowedClassIds, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                 materialDesign:HintAssist.Hint="allowed_class_ids (ex: 1,2,4)" materialDesign:HintAssist.IsFloating="True"/>
        <TextBox Text="{Binding CraftFormSortOrder, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                 materialDesign:HintAssist.Hint="sort_order" materialDesign:HintAssist.IsFloating="True"/>
        <CheckBox Content="Ativa" IsChecked="{Binding CraftFormIsActive}" Margin="0,0,0,10"/>

        <TextBlock Text="Ingredientes (slots 0–4)" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,6"
                   Text="material/consumable + recipe_item = aprender 1x; equipment + recipe_item = consome por craft."/>
        <ItemsControl ItemsSource="{Binding CraftIngredientForms}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="50"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding SlotIndex, StringFormat=S{0}}" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Margin="4,0"
                         Text="{Binding ItemTemplateId, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="item_template_id" materialDesign:HintAssist.IsFloating="True"/>
                <TextBox Grid.Column="2"
                         Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="qty" materialDesign:HintAssist.IsFloating="True"/>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <WrapPanel Margin="0,12,0,0">
          <Button Content="{Binding CraftSaveButtonText}" Command="{Binding SaveCraftRecipeCommand}"
                  Style="{StaticResource ManagerActionButton}" Margin="0,0,8,4"/>
          <Button Content="Excluir" Command="{Binding DeleteCraftRecipeCommand}"
                  Style="{StaticResource ManagerActionOutlinedButton}" Margin="0,0,8,4"/>
        </WrapPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
