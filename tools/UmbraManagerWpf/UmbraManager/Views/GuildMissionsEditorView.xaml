<UserControl x:Class="UmbraManager.Views.GuildMissionsEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
  <Grid Margin="8">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MinWidth="420"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="460"/>
    </Grid.ColumnDefinitions>
    <DockPanel Grid.Column="0">
      <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
        <Button Content="Atualizar" Command="{Binding RefreshGuildMissionTemplatesCommand}" Margin="0,0,8,4"
                Style="{StaticResource ManagerActionOutlinedButton}"/>
        <Button Content="Nova missão" Command="{Binding NewGuildMissionTemplateCommand}" Margin="0,0,8,4"
                Style="{StaticResource ManagerActionOutlinedButton}"/>
        <Button Content="Recarregar no Zone" Command="{Binding ReloadGuildMissionsOnZonesCommand}" Margin="0,0,8,4"
                Style="{StaticResource ManagerActionOutlinedButton}"/>
        <TextBlock Text="{Binding GuildMissionTemplates.Count, StringFormat={}{0} missões}"
                   VerticalAlignment="Center" Opacity="0.7"/>
      </WrapPanel>
      <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" Opacity="0.7" TextWrapping="Wrap"
                 Text="Cada guilda recebe 3 missões diárias e 2 semanais sorteadas por peso entre as ativas do seu nível. Ao concluir, a guilda ganha a EXP e cada membro com a contribuição mínima resgata ouro/item na janela de missões."/>
      <DataGrid Style="{StaticResource ManagerDataGrid}" ItemsSource="{Binding GuildMissionTemplates}" IsReadOnly="True">
        <DataGrid.Columns>
          <DataGridTextColumn Header="ID" Binding="{Binding MissionId}" Width="40"/>
          <DataGridTextColumn Header="Período" Binding="{Binding Period}" Width="65"/>
          <DataGridTextColumn Header="Título" Binding="{Binding Title}" Width="*"/>
          <DataGridTextColumn Header="Tipo" Binding="{Binding ObjectiveType}" Width="105"/>
          <DataGridTextColumn Header="Meta" Binding="{Binding RequiredTotal}" Width="55"/>
          <DataGridTextColumn Header="EXP" Binding="{Binding RewardGuildXp}" Width="55"/>
          <DataGridTextColumn Header="Peso" Binding="{Binding Weight}" Width="45"/>
          <DataGridCheckBoxColumn Header="On" Binding="{Binding IsActive}" Width="40"/>
          <DataGridTemplateColumn Header="Ações" Width="80">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Button Content="Editar" Style="{StaticResource ManagerActionButton}"
                        Command="{Binding DataContext.EditGuildMissionTemplateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>
    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"
                  ShowsPreview="True" ResizeBehavior="PreviousAndNext"/>
    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="8,0,0,12">
        <TextBlock Text="{Binding GuildMissionFormTitleText}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>

        <TextBox Text="{Binding GuildMissionFormKey, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                 materialDesign:HintAssist.Hint="Chave única (ex.: GM_DAILY_HUNT)" materialDesign:HintAssist.IsFloating="True"/>
        <TextBox Text="{Binding GuildMissionFormTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                 materialDesign:HintAssist.Hint="Título exibido no jogo" materialDesign:HintAssist.IsFloating="True"/>
        <TextBox Text="{Binding GuildMissionFormDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                 materialDesign:HintAssist.Hint="Descrição" materialDesign:HintAssist.IsFloating="True"/>
        <UniformGrid Columns="2" Margin="0,0,0,6">
          <ComboBox Margin="0,0,6,0" ItemsSource="{Binding GuildMissionPeriods}" SelectedItem="{Binding GuildMissionFormPeriod}"
                    materialDesign:HintAssist.Hint="Período" materialDesign:HintAssist.IsFloating="True"/>
          <ComboBox ItemsSource="{Binding GuildMissionObjectiveTypes}" SelectedItem="{Binding GuildMissionFormObjectiveType}"
                    materialDesign:HintAssist.Hint="Tipo de objetivo" materialDesign:HintAssist.IsFloating="True"/>
        </UniformGrid>
        <TextBox Text="{Binding GuildMissionFormParamsJson, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,2"
                 AcceptsReturn="True" Height="54" TextWrapping="Wrap" FontFamily="Consolas"
                 materialDesign:HintAssist.Hint="Parâmetros (JSON)" materialDesign:HintAssist.IsFloating="True"/>
        <TextBlock FontSize="11" Opacity="0.65" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="kill: {&quot;npc_template_id&quot;:6} ou {&quot;npc_template_ids&quot;:[6,9]} · kill_any: {&quot;min_level&quot;:1,&quot;max_level&quot;:10,&quot;zone_id&quot;:0} · use_skill: {&quot;skill_id&quot;:0} · use_consumable: {&quot;item_subtype&quot;:&quot;health_potion&quot;} · craft_item: {&quot;item_template_id&quot;:0} · refine_item: {&quot;min_refine_level&quot;:3} · earn_gold: {} · complete_dungeon: {&quot;instance_template_id&quot;:0,&quot;difficulty_key&quot;:&quot;&quot;}"/>
        <UniformGrid Columns="3" Margin="0,0,0,6">
          <TextBox Text="{Binding GuildMissionFormRequiredTotal, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"
                   materialDesign:HintAssist.Hint="Meta da guilda" materialDesign:HintAssist.IsFloating="True"/>
          <TextBox Text="{Binding GuildMissionFormMinGuildLevel, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"
                   materialDesign:HintAssist.Hint="Nível mín. da guilda" materialDesign:HintAssist.IsFloating="True"/>
          <TextBox Text="{Binding GuildMissionFormWeight, UpdateSourceTrigger=PropertyChanged}"
                   materialDesign:HintAssist.Hint="Peso no sorteio" materialDesign:HintAssist.IsFloating="True"/>
        </UniformGrid>
        <TextBlock Text="Recompensas" FontWeight="SemiBold" Margin="0,6,0,4"/>
        <UniformGrid Columns="3" Margin="0,0,0,6">
          <TextBox Text="{Binding GuildMissionFormRewardGuildXp, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"
                   materialDesign:HintAssist.Hint="EXP de guilda" materialDesign:HintAssist.IsFloating="True"/>
          <TextBox Text="{Binding GuildMissionFormRewardGold, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"
                   materialDesign:HintAssist.Hint="Ouro por membro" materialDesign:HintAssist.IsFloating="True"/>
          <TextBox Text="{Binding GuildMissionFormMinContribution, UpdateSourceTrigger=PropertyChanged}"
                   materialDesign:HintAssist.Hint="Contribuição mínima" materialDesign:HintAssist.IsFloating="True"/>
          <TextBox Text="{Binding GuildMissionFormRewardItemId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"
                   materialDesign:HintAssist.Hint="Item por membro (ID, 0=nenhum)" materialDesign:HintAssist.IsFloating="True"/>
          <TextBox Text="{Binding GuildMissionFormRewardItemQty, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"
                   materialDesign:HintAssist.Hint="Qtd do item" materialDesign:HintAssist.IsFloating="True"/>
        </UniformGrid>
        <CheckBox Content="Ativa (entra no sorteio)" IsChecked="{Binding GuildMissionFormIsActive}" Margin="0,4,0,12"/>
        <WrapPanel>
          <Button Content="{Binding GuildMissionSaveButtonText}" Command="{Binding SaveGuildMissionTemplateCommand}"
                  Style="{StaticResource ManagerActionButton}" Margin="0,0,8,4"/>
        </WrapPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
