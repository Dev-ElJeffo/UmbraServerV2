<UserControl x:Class="UmbraManager.Views.AppearancePartsEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
  <Grid Margin="8">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MinWidth="380"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="420"/>
    </Grid.ColumnDefinitions>
    <DockPanel Grid.Column="0">
      <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
        <Button Content="Atualizar" Command="{Binding RefreshAppearancePartsCommand}" Margin="0,0,8,4"
                Style="{StaticResource ManagerActionOutlinedButton}"/>
        <Button Content="Nova parte" Command="{Binding NewAppearancePartCommand}" Margin="0,0,8,4"
                Style="{StaticResource ManagerActionOutlinedButton}"/>
        <TextBox Width="180" Margin="0,0,8,4"
                 Text="{Binding AppearancePartFilterText, UpdateSourceTrigger=PropertyChanged}"
                 materialDesign:HintAssist.Hint="Buscar"
                 materialDesign:HintAssist.IsFloating="True"/>
        <TextBlock Text="{Binding AppearanceParts.Count, StringFormat={}{0} partes}"
                   VerticalAlignment="Center" Opacity="0.7"/>
      </WrapPanel>
      <DataGrid Style="{StaticResource ManagerDataGrid}" ItemsSource="{Binding AppearanceParts}" IsReadOnly="True">
        <DataGrid.Columns>
          <DataGridTextColumn Header="ID" Binding="{Binding AppearancePartId}" Width="50"/>
          <DataGridTextColumn Header="Tipo" Binding="{Binding PartType}" Width="70"/>
          <DataGridTextColumn Header="Part ID" Binding="{Binding PartId}" Width="70"/>
          <DataGridTextColumn Header="Socket" Binding="{Binding AttachSocket}" Width="90"/>
          <DataGridTextColumn Header="Mesh path" Binding="{Binding MeshPath}" Width="*"/>
          <DataGridCheckBoxColumn Header="On" Binding="{Binding IsEnabled}" Width="40"/>
          <DataGridTemplateColumn Header="Ações" Width="160">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <Button Content="Editar" Style="{StaticResource ManagerActionButton}"
                          Command="{Binding DataContext.EditAppearancePartCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding}"/>
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>
    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"
                  ShowsPreview="True" ResizeBehavior="PreviousAndNext"/>
    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="8,0,0,12">
        <TextBlock Text="{Binding AppearancePartFormTitle}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>
        <ComboBox Margin="0,0,0,6" SelectedValue="{Binding AppearancePartFormType}" SelectedValuePath="Content"
                  materialDesign:HintAssist.Hint="part_type" materialDesign:HintAssist.IsFloating="True">
          <ComboBoxItem Content="hair"/>
          <ComboBoxItem Content="head"/>
          <ComboBoxItem Content="body"/>
        </ComboBox>
        <TextBox Text="{Binding AppearancePartFormPartId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                 materialDesign:HintAssist.Hint="part_id (players.hair / players.head)" materialDesign:HintAssist.IsFloating="True"/>
        <TextBox Text="{Binding AppearancePartFormMeshPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                 materialDesign:HintAssist.Hint="mesh_path (UE)" materialDesign:HintAssist.IsFloating="True"/>
        <TextBox Text="{Binding AppearancePartFormAttachSocket, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                 materialDesign:HintAssist.Hint="attach_socket" materialDesign:HintAssist.IsFloating="True"/>
        <CheckBox Content="Habilitado" IsChecked="{Binding AppearancePartFormIsEnabled}" Margin="0,0,0,12"/>
        <WrapPanel>
          <Button Content="{Binding AppearancePartSaveButtonText}" Command="{Binding SaveAppearancePartCommand}"
                  Style="{StaticResource ManagerActionButton}" Margin="0,0,8,4"/>
          <Button Content="Excluir" Command="{Binding DeleteAppearancePartCommand}"
                  Style="{StaticResource ManagerActionOutlinedButton}" Margin="0,0,8,4"/>
        </WrapPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
