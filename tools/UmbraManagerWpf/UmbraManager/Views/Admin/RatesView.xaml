<UserControl x:Class="UmbraManager.Views.Admin.RatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:views="clr-namespace:UmbraManager.Views"
             xmlns:controls="clr-namespace:UmbraManager.Controls">
<Border Style="{StaticResource ManagerEditorCard}" Margin="8" MaxWidth="520" HorizontalAlignment="Left">
    <StackPanel>
        <TextBlock Text="Rates globais" Style="{StaticResource ManagerEditorTitle}"/>
        <TextBlock Text="Multiplicadores de EXP e Drop aplicados nas zones (reload após salvar)."
                   Style="{StaticResource ManagerEditorSubtitle}" Margin="0,0,0,12"/>
        <TextBox Text="{Binding GameExpMultiplier, UpdateSourceTrigger=PropertyChanged}"
                 materialDesign:HintAssist.Hint="EXP multiplier"
                 materialDesign:HintAssist.IsFloating="True" Margin="0,0,0,10"/>
        <TextBox Text="{Binding GameDropMultiplier, UpdateSourceTrigger=PropertyChanged}"
                 materialDesign:HintAssist.Hint="Drop multiplier"
                 materialDesign:HintAssist.IsFloating="True" Margin="0,0,0,10"/>
        <TextBlock Text="{Binding GameRatesStatus}" Opacity="0.8" Margin="0,0,0,12"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Atualizar" Command="{Binding RefreshGameRatesCommand}"
                    Style="{StaticResource ManagerFormSecondaryButton}"/>
            <Button Grid.Column="2" Content="Salvar rates" Command="{Binding SaveGameRatesCommand}"
                    Style="{StaticResource ManagerFormPrimaryButton}"/>
        </Grid>
    </StackPanel>
</Border>
</UserControl>
