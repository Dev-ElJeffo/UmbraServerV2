<UserControl x:Class="UmbraManager.Views.Admin.AuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:views="clr-namespace:UmbraManager.Views"
             xmlns:controls="clr-namespace:UmbraManager.Controls">
<DockPanel Margin="8">
    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
        <TextBox Width="220" Margin="0,0,8,4"
                 Text="{Binding AuditFilter, UpdateSourceTrigger=PropertyChanged}"
                 materialDesign:HintAssist.Hint="Filtrar ação"
                 materialDesign:HintAssist.IsFloating="True"/>
        <Button Content="Atualizar" Command="{Binding RefreshAuditCommand}"
                Style="{StaticResource ManagerActionOutlinedButton}" Margin="0,0,8,4"/>
    </WrapPanel>
    <DataGrid Style="{StaticResource ManagerDataGrid}"
              ItemsSource="{Binding AuditLogs}" IsReadOnly="True">
        <DataGrid.Columns>
            <DataGridTextColumn Header="Quando" Binding="{Binding TimestampLocal}" Width="150"/>
            <DataGridTextColumn Header="Operador" Binding="{Binding OperatorName}" Width="120"/>
            <DataGridTextColumn Header="Ação" Binding="{Binding Action}" Width="160"/>
            <DataGridTextColumn Header="Detalhes" Binding="{Binding Details}" Width="*"/>
        </DataGrid.Columns>
    </DataGrid>
</DockPanel>
</UserControl>
