<UserControl x:Class="UmbraManager.Views.Admin.AdminHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:views="clr-namespace:UmbraManager.Views"
             xmlns:controls="clr-namespace:UmbraManager.Controls">
<TabControl Margin="4">
    <TabItem Header="Player Inspector" Visibility="{Binding TabVisibilityOps}">
        <views:PlayerInspectorView/>
    </TabItem>

<TabItem Header="EXP Zones">
        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Atualizar" Command="{Binding RefreshExpZonesCommand}" Margin="0,0,8,0"/>
                    <Button Content="Nova zone" Command="{Binding NewExpZoneCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"/>
                </StackPanel>
                <DataGrid Style="{StaticResource ManagerDataGrid}" ItemsSource="{Binding ExpZones}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding ExpZoneId}" Width="60"/>
                        <DataGridTextColumn Header="Zone" Binding="{Binding ZoneId}" Width="60"/>
                        <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="180"/>
                        <DataGridTextColumn Header="Resumo" Binding="{Binding Summary}" Width="*"/>
                        <DataGridTemplateColumn Header="Editar" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Editar"
                                            Command="{Binding DataContext.EditExpZoneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" Background="Transparent"
                          ShowsPreview="True" ResizeBehavior="PreviousAndNext"/>
            <Border Grid.Column="2" Style="{StaticResource ManagerEditorCard}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding ExpZoneFormTitle}" Style="{StaticResource ManagerEditorTitle}"/>
                        <TextBox Text="{Binding ExpZoneZoneId, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Zone ID"
                                 materialDesign:HintAssist.IsFloating="True"/>
                        <TextBox Margin="0,8,0,0" Text="{Binding ExpZoneName, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Nome"
                                 materialDesign:HintAssist.IsFloating="True"/>
                        <TextBox Margin="0,8,0,0" Text="{Binding ExpZoneCenterX, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Center X"
                                 materialDesign:HintAssist.IsFloating="True"/>
                        <TextBox Margin="0,8,0,0" Text="{Binding ExpZoneCenterY, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Center Y"
                                 materialDesign:HintAssist.IsFloating="True"/>
                        <TextBox Margin="0,8,0,0" Text="{Binding ExpZoneCenterZ, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Center Z"
                                 materialDesign:HintAssist.IsFloating="True"/>
                        <TextBox Margin="0,8,0,0" Text="{Binding ExpZoneRadius, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Radius"
                                 materialDesign:HintAssist.IsFloating="True"/>
                        <TextBox Margin="0,8,0,0" Text="{Binding ExpZoneExpPerTick, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="EXP por tick"
                                 materialDesign:HintAssist.IsFloating="True"/>
                        <TextBox Margin="0,8,0,0" Text="{Binding ExpZoneTickIntervalSec, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Intervalo tick (s)"
                                 materialDesign:HintAssist.IsFloating="True"/>
                        <CheckBox Margin="0,8,0,0" Content="Ativa" IsChecked="{Binding ExpZoneEnabled}"/>
                        <Button Margin="0,12,0,0" Content="Salvar EXP zone" Command="{Binding SaveExpZoneCommand}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </TabItem>

    <TabItem Header="Refinement">
        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0">
                <Button DockPanel.Dock="Top" Content="Atualizar configuração" Command="{Binding RefreshRefinementConfigsCommand}"
                        Margin="0,0,0,8" Style="{StaticResource MaterialDesignOutlinedButton}"/>
                <DataGrid Style="{StaticResource ManagerDataGrid}" ItemsSource="{Binding RefinementConfigs}"
                          SelectedItem="{Binding SelectedRefinementConfig}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nível" Binding="{Binding RefinementLevel}" Width="70"/>
                        <DataGridTextColumn Header="Sucesso %" Binding="{Binding SuccessPercentage}" Width="90"/>
                        <DataGridTextColumn Header="Item" Binding="{Binding RequiredItemName}" Width="180"/>
                        <DataGridTextColumn Header="Qtd" Binding="{Binding RequiredItemQuantity}" Width="60"/>
                        <DataGridTextColumn Header="Bonus %" Binding="{Binding BonusPercentage}" Width="90"/>
                        <DataGridTextColumn Header="Multiplier" Binding="{Binding StatBonusMultiplier}" Width="90"/>
                        <DataGridTemplateColumn Header="Editar" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Editar"
                                            Command="{Binding DataContext.EditRefinementConfigCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" Background="Transparent"
                          ShowsPreview="True" ResizeBehavior="PreviousAndNext"/>
            <Border Grid.Column="2" Style="{StaticResource ManagerEditorCard}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding RefinementFormTitle}" Style="{StaticResource ManagerEditorTitle}"/>
                        <TextBox Margin="0,0,0,6" Text="{Binding RefineFormLevel, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="True"
                                 materialDesign:HintAssist.Hint="Nível" materialDesign:HintAssist.IsFloating="True"/>
                        <TextBox Margin="0,0,0,6" Text="{Binding RefineFormSuccessPercentage, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Sucesso %" materialDesign:HintAssist.IsFloating="True"/>
                        <TextBox Margin="0,0,0,6" Text="{Binding RefineFormRequiredItemId, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Item ID" materialDesign:HintAssist.IsFloating="True"/>
                        <TextBox Margin="0,0,0,6" Text="{Binding RefineFormRequiredItemName, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="True"
                                 materialDesign:HintAssist.Hint="Item (nome)" materialDesign:HintAssist.IsFloating="True"/>
                        <TextBox Margin="0,0,0,6" Text="{Binding RefineFormRequiredItemQuantity, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Quantidade" materialDesign:HintAssist.IsFloating="True"/>
                        <TextBox Margin="0,0,0,6" Text="{Binding RefineFormBonusPercentage, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Bonus %" materialDesign:HintAssist.IsFloating="True"/>
                        <TextBox Margin="0,0,0,6" Text="{Binding RefineFormStatBonusMultiplier, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Multiplier" materialDesign:HintAssist.IsFloating="True"/>
                        <TextBlock Margin="0,8,0,4" Text="Niagara por slot (níveis +7..+12)" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" Opacity="0.85"
                                   Text="Edite CADA nível (+7, +8, … +12) com Niagara distinto. Preencha armadura (head/chest/hands/legs/feet) e armas (main_hand/off_hand). Paths iguais só se quiser o mesmo efeito."/>
                        <TextBox Margin="0,0,0,6" Text="{Binding RefineFormVfxMainHand, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="main_hand /Game/...System" materialDesign:HintAssist.IsFloating="True"/>
                        <TextBox Margin="0,0,0,6" Text="{Binding RefineFormVfxOffHand, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="off_hand /Game/...System" materialDesign:HintAssist.IsFloating="True"/>
                        <TextBox Margin="0,0,0,6" Text="{Binding RefineFormVfxHead, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="head /Game/...System" materialDesign:HintAssist.IsFloating="True"/>
                        <TextBox Margin="0,0,0,6" Text="{Binding RefineFormVfxChest, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="chest /Game/...System" materialDesign:HintAssist.IsFloating="True"/>
                        <TextBox Margin="0,0,0,6" Text="{Binding RefineFormVfxHands, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="hands /Game/...System" materialDesign:HintAssist.IsFloating="True"/>
                        <TextBox Margin="0,0,0,6" Text="{Binding RefineFormVfxLegs, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="legs /Game/...System" materialDesign:HintAssist.IsFloating="True"/>
                        <TextBox Margin="0,0,0,6" Text="{Binding RefineFormVfxFeet, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="feet /Game/...System" materialDesign:HintAssist.IsFloating="True"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Salvar" Command="{Binding SaveSelectedRefinementConfigCommand}" Margin="0,0,8,0"/>
                            <Button Content="Descartar" Command="{Binding ClearRefinementFormCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </TabItem>

    <TabItem Header="Guilds" Visibility="{Binding TabVisibilitySuper}">
        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBox Width="160" Margin="0,0,8,0" Text="{Binding GuildSearch, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Buscar" materialDesign:HintAssist.IsFloating="True"/>
                    <Button Content="Atualizar" Command="{Binding RefreshGuildsCommand}"/>
                    <Button Content="Dissolver" Command="{Binding DisbandSelectedGuildCommand}" Margin="8,0,0,0"
                            Style="{StaticResource ManagerFormSecondaryButton}"/>
                </StackPanel>
                <DataGrid Style="{StaticResource ManagerDataGrid}" ItemsSource="{Binding GuildRows}"
                          SelectedItem="{Binding SelectedGuild}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding GuildId}" Width="60"/>
                        <DataGridTextColumn Header="Nome" Binding="{Binding GuildName}" Width="160"/>
                        <DataGridTextColumn Header="Líder" Binding="{Binding LeaderName}" Width="120"/>
                        <DataGridTextColumn Header="Membros" Binding="{Binding MemberCount}" Width="70"/>
                        <DataGridTextColumn Header="Nível" Binding="{Binding GuildLevel}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
            <DockPanel Grid.Column="2">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Kick" Command="{Binding KickSelectedGuildMemberCommand}" Margin="0,0,8,0"/>
                    <Button Content="Transferir líder" Command="{Binding TransferGuildOwnerCommand}"/>
                </StackPanel>
                <DataGrid Style="{StaticResource ManagerDataGrid}" ItemsSource="{Binding GuildMembers}"
                          SelectedItem="{Binding SelectedGuildMember}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Player" Binding="{Binding PlayerId}" Width="70"/>
                        <DataGridTextColumn Header="Nome" Binding="{Binding CharacterName}" Width="*"/>
                        <DataGridTextColumn Header="Rank" Binding="{Binding MemberRank}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </TabItem>

    <TabItem Header="Auction" Visibility="{Binding TabVisibilitySuper}">
        <DockPanel Margin="8">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBox Width="120" Margin="0,0,8,0" Text="{Binding AuctionStatusFilter, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="status" materialDesign:HintAssist.IsFloating="True"/>
                <Button Content="Atualizar" Command="{Binding RefreshAuctionsAdminCommand}" Margin="0,0,8,0"/>
                <Button Content="Cancelar selecionado" Command="{Binding ForceCancelSelectedAuctionCommand}" Margin="0,0,8,0"/>
                <Button Content="Expirar stale" Command="{Binding ExpireStaleAuctionsCommand}"/>
            </StackPanel>
            <DataGrid Style="{StaticResource ManagerDataGrid}" ItemsSource="{Binding AuctionAdminRows}"
                      SelectedItem="{Binding SelectedAuction}" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding ListingId}" Width="60"/>
                    <DataGridTextColumn Header="Seller" Binding="{Binding SellerName}" Width="120"/>
                    <DataGridTextColumn Header="Item" Binding="{Binding ItemName}" Width="180"/>
                    <DataGridTextColumn Header="Qtd" Binding="{Binding Quantity}" Width="50"/>
                    <DataGridTextColumn Header="Gold" Binding="{Binding PriceGold}" Width="80"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                    <DataGridTextColumn Header="Expira" Binding="{Binding ExpiresAt}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </TabItem>

    <TabItem Header="Mail" Visibility="{Binding TabVisibilitySuper}">
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource ManagerEditorCard}" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="Enviar carta sistema" Style="{StaticResource ManagerEditorTitle}"/>
                    <CheckBox Content="Enviar a TODOS os players" IsChecked="{Binding MailSendToAll}" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding MailToPlayerId, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="to_player_id"
                             materialDesign:HintAssist.IsFloating="True" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding MailSubject, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Assunto"
                             materialDesign:HintAssist.IsFloating="True" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding MailBody, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                             Height="80" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             materialDesign:HintAssist.Hint="Corpo"
                             materialDesign:HintAssist.IsFloating="True" Margin="0,0,0,8"/>
                    <TextBlock Text="Anexos (até 5 slots)" Margin="0,0,0,4" Opacity="0.85"/>
                    <ItemsControl ItemsSource="{Binding MailAttachSlots}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,8,8" Padding="8" BorderBrush="#444" BorderThickness="1" MinWidth="140">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SlotIndex, StringFormat=Slot {0}}"/>
                                        <TextBox Text="{Binding ItemTemplateId, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="item_id" materialDesign:HintAssist.IsFloating="True"/>
                                        <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="qty" materialDesign:HintAssist.IsFloating="True" Margin="0,4,0,0"/>
                                        <TextBox Text="{Binding RefinementLevel, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="refine" materialDesign:HintAssist.IsFloating="True" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Enviar mail" Command="{Binding AdminSendMailCommand}"
                            Style="{StaticResource ManagerFormPrimaryButton}" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
            <DockPanel Grid.Row="1">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBox Width="100" Margin="0,0,8,0" Text="{Binding MailListFilterPlayerId, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="player_id" materialDesign:HintAssist.IsFloating="True"/>
                    <TextBox Width="160" Margin="0,0,8,0" Text="{Binding MailListFilterSubject, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="assunto" materialDesign:HintAssist.IsFloating="True"/>
                    <Button Content="Atualizar histórico" Command="{Binding RefreshMailAdminCommand}"/>
                </StackPanel>
                <DataGrid Style="{StaticResource ManagerDataGrid}" ItemsSource="{Binding MailAdminRows}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding MailId}" Width="60"/>
                        <DataGridTextColumn Header="Para" Binding="{Binding ToName}" Width="120"/>
                        <DataGridTextColumn Header="De" Binding="{Binding FromName}" Width="100"/>
                        <DataGridTextColumn Header="Assunto" Binding="{Binding Subject}" Width="*"/>
                        <DataGridTextColumn Header="Anexos" Binding="{Binding AttachmentCount}" Width="60"/>
                        <DataGridTextColumn Header="Quando" Binding="{Binding CreatedAt}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </TabItem>
</TabControl>
</UserControl>
