<UserControl x:Class="UmbraManager.Views.Operations.ZonesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:views="clr-namespace:UmbraManager.Views"
             xmlns:controls="clr-namespace:UmbraManager.Controls">
<DataGrid Style="{StaticResource ManagerDataGrid}" ItemsSource="{Binding Zones}" IsReadOnly="True" Margin="8">
    <DataGrid.Columns>
        <DataGridTextColumn Header="Zone ID" Binding="{Binding ZoneId}"/>
        <DataGridTextColumn Header="Nome" Binding="{Binding ZoneName}"/>
        <DataGridTextColumn Header="Porta" Binding="{Binding Port}"/>
        <DataGridTextColumn Header="Admin" Binding="{Binding AdminPort}"/>
        <DataGridTextColumn Header="Players" Binding="{Binding PlayersOnline}"/>
        <DataGridCheckBoxColumn Header="Online" Binding="{Binding Online}"/>
    </DataGrid.Columns>
</DataGrid>
</UserControl>
