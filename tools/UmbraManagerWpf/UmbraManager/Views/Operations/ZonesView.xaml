<UserControl x:Class="UmbraManager.Views.Operations.ZonesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<DataGrid Style="{StaticResource ManagerDataGrid}" ItemsSource="{Binding Zones}" IsReadOnly="True">
    <DataGrid.Columns>
        <DataGridTextColumn Header="Zone ID" Binding="{Binding ZoneId}" Width="90"/>
        <DataGridTextColumn Header="Nome" Binding="{Binding ZoneName}" Width="*"/>
        <DataGridTextColumn Header="Porta" Binding="{Binding Port}" Width="100"/>
        <DataGridTextColumn Header="Admin" Binding="{Binding AdminPort}" Width="100"/>
        <DataGridTextColumn Header="Players" Binding="{Binding PlayersOnline}" Width="100"/>
        <DataGridCheckBoxColumn Header="Online" Binding="{Binding Online}" Width="90"/>
    </DataGrid.Columns>
</DataGrid>
</UserControl>
