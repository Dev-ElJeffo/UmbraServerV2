<UserControl x:Class="UmbraManager.Views.Npcs.NpcEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:views="clr-namespace:UmbraManager.Views"
             xmlns:controls="clr-namespace:UmbraManager.Controls">
<TabControl Margin="4" SelectedIndex="{Binding NpcSubTabIndex, Mode=TwoWay}">
    <!-- Templates -->
    <TabItem Header="Templates">
        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="500"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="460"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button Content="Atualizar" Command="{Binding RefreshNpcTemplatesCommand}"
                            Style="{StaticResource ManagerActionOutlinedButton}" Margin="0,0,8,4"/>
                    <Button Content="Novo template" Command="{Binding NewNpcTemplateCommand}"
                            Style="{StaticResource ManagerActionOutlinedButton}" Margin="0,0,8,4"/>
                    <Button Content="Loot deste mob" Command="{Binding OpenNpcLootForSelectedTemplateCommand}"
                            Style="{StaticResource ManagerActionOutlinedButton}" Margin="0,0,8,4"
                            ToolTip="Abre/carrega a tabela de loot do template selecionado"/>
                    <Button Content="Vendor (venda)" Command="{Binding OpenVendorStockForSelectedTemplateCommand}"
                            Style="{StaticResource ManagerActionOutlinedButton}" Margin="0,0,8,4"
                            ToolTip="Abre a aba de estoque de venda do template selecionado"/>
                    <Button Content="Quests do NPC" Command="{Binding OpenNpcQuestsForSelectedTemplateCommand}"
                            Style="{StaticResource ManagerActionOutlinedButton}" Margin="0,0,8,4"
                            ToolTip="Abre a aba de quests do template selecionado"/>
                    <TextBlock Text="{Binding NpcTemplates.Count, StringFormat={}{0} templates}"
                               VerticalAlignment="Center" Margin="8,0,0,4" Opacity="0.7"/>
                </WrapPanel>

                <DataGrid Style="{StaticResource ManagerDataGrid}" ItemsSource="{Binding NpcTemplates}"
                          SelectedItem="{Binding SelectedNpcTemplate}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="55">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="160">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Lv" Binding="{Binding Level}" Width="40"/>
                        <DataGridTextColumn Header="Roam" Binding="{Binding RoamRadius, StringFormat=F0}" Width="55"/>
                        <DataGridTextColumn Header="Aggro" Binding="{Binding AggroRadius, StringFormat=F0}" Width="55"/>
                        <DataGridTextColumn Header="AtkR" Binding="{Binding AttackRange, StringFormat=F0}" Width="50"/>
                        <DataGridCheckBoxColumn Header="Hostil" Binding="{Binding IsHostile}" Width="55" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Resumo" Binding="{Binding Summary}" Width="*"/>
                        <DataGridTemplateColumn Header="Ações" Width="100" MinWidth="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Editar" Style="{StaticResource ManagerActionButton}"
                                            Command="{Binding DataContext.EditNpcTemplateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" Background="Transparent"
                          ShowsPreview="True" ResizeBehavior="PreviousAndNext"/>

            <Border Grid.Column="2" Style="{StaticResource ManagerEditorCard}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="{Binding NpcFormTitle}" Style="{StaticResource ManagerEditorTitle}"/>
                        <TextBlock FontSize="11" Opacity="0.7" TextWrapping="Wrap"
                                   Text="Selecione um template na lista. Spawn grava em npc_instances e envia opcode 100 ao zone em execução (zone_N deve estar online)."/>
                        <TextBlock Text="{Binding NpcDesignerSummary}"
                                   FontFamily="Consolas" FontSize="11" Margin="0,6,0,0" Opacity="0.8"/>
                    </StackPanel>

                    <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Limpar" Command="{Binding NewNpcTemplateCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    HorizontalAlignment="Stretch" Height="36"/>
                            <Button Grid.Column="2"
                                    Content="{Binding NpcSaveButtonText}"
                                    Command="{Binding SaveNpcTemplateCommand}"
                                    HorizontalAlignment="Stretch" Height="36"
                                    Style="{StaticResource MaterialDesignRaisedButton}"/>
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Criar nova instância"
                                    Command="{Binding SpawnNpcCommand}"
                                    HorizontalAlignment="Stretch" Height="36"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    ToolTip="Cria OUTRA cópia do TEMPLATE selecionado nas coords Zone/X/Y/Z. Não precisa selecionar instância."/>
                            <Button Grid.Column="2" Content="Atualizar posição"
                                    Command="{Binding UpdateNpcInstancePositionCommand}"
                                    HorizontalAlignment="Stretch" Height="36"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    ToolTip="Move a INSTÃNCIA já existente (#ID). Não cria cópia nova."/>
                        </Grid>
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                        <StackPanel>
                            <Expander Header="Identidade" IsExpanded="True" Style="{StaticResource ManagerFormSection}">
                            <StackPanel>
                            <TextBox Text="{Binding NewNpcName, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Nome (obrigatório)"
                                     materialDesign:HintAssist.IsFloating="True"
                                     Margin="0,0,0,10"/>
                            <TextBox Text="{Binding NewNpcLevel, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Level"
                                     materialDesign:HintAssist.IsFloating="True"
                                     Margin="0,0,0,16"/>

                            <TextBlock Text="Vitais" FontWeight="SemiBold" Margin="0,0,0,6" Opacity="0.85"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding NewNpcMaxHealth, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="HP máximo"
                                         materialDesign:HintAssist.IsFloating="True"/>
                                <TextBox Grid.Column="2" Text="{Binding NewNpcMaxMana, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="MP máximo"
                                         materialDesign:HintAssist.IsFloating="True"/>
                            </Grid>

                            <TextBlock Text="Atributos base" FontWeight="SemiBold" Margin="0,0,0,6" Opacity="0.85"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding NewNpcStrength, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="STR" materialDesign:HintAssist.IsFloating="True"/>
                                <TextBox Grid.Column="2" Text="{Binding NewNpcDexterity, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="DEX" materialDesign:HintAssist.IsFloating="True"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding NewNpcVitality, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="VIT" materialDesign:HintAssist.IsFloating="True"/>
                                <TextBox Grid.Column="2" Text="{Binding NewNpcIntelligence, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="INT" materialDesign:HintAssist.IsFloating="True"/>
                            </Grid>
                            <TextBox Text="{Binding NewNpcLuck, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="LUCK"
                                     materialDesign:HintAssist.IsFloating="True"
                                     Margin="0,0,0,16"/>
                            </StackPanel>
                            </Expander>

                            <Expander Header="Combate" IsExpanded="True" Style="{StaticResource ManagerFormSection}">
                            <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding NewNpcPhysicalAttack, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Ataque físico" materialDesign:HintAssist.IsFloating="True"/>
                                <TextBox Grid.Column="2" Text="{Binding NewNpcMagicAttack, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Ataque mágico" materialDesign:HintAssist.IsFloating="True"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" ItemsSource="{Binding NpcDamageTypeOptions}"
                                          SelectedItem="{Binding NewNpcDamageType}"
                                          materialDesign:HintAssist.Hint="Dano do basic (Physical/Magic)"
                                          materialDesign:HintAssist.IsFloating="True"/>
                                <TextBox Grid.Column="2" Text="{Binding NewNpcBasicPowerCoef, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="basic_power_coef" materialDesign:HintAssist.IsFloating="True"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding NewNpcPhysicalDefense, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Defesa física" materialDesign:HintAssist.IsFloating="True"/>
                                <TextBox Grid.Column="2" Text="{Binding NewNpcMagicDefense, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Defesa mágica" materialDesign:HintAssist.IsFloating="True"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding NewNpcAccuracy, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Precisão" materialDesign:HintAssist.IsFloating="True"/>
                                <TextBox Grid.Column="2" Text="{Binding NewNpcDodge, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Esquiva" materialDesign:HintAssist.IsFloating="True"/>
                            </Grid>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding NewNpcCritical, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Crítico" materialDesign:HintAssist.IsFloating="True"/>
                                <TextBox Grid.Column="2" Text="{Binding NewNpcCriticalResistance, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Resist. crítico" materialDesign:HintAssist.IsFloating="True"/>
                            </Grid>
                            </StackPanel>
                            </Expander>

                            <Expander Header="Visual" IsExpanded="False" Style="{StaticResource ManagerFormSection}">
                            <StackPanel>
                            <TextBox Text="{Binding NewNpcSkeletalMeshPath, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Skeletal mesh path"
                                     materialDesign:HintAssist.IsFloating="True"
                                     Margin="0,0,0,10"/>
                            <TextBox Text="{Binding NewNpcAnimBlueprintPath, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Anim Blueprint path"
                                     materialDesign:HintAssist.IsFloating="True"
                                     Margin="0,0,0,10"/>
                            </StackPanel>
                            </Expander>

                            <Expander Header="Animações" IsExpanded="False" Style="{StaticResource ManagerFormSection}">
                            <StackPanel>
                            <TextBox Text="{Binding NewNpcAnimAttacksCsv, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Attacks (várias montages do basic, separadas por ; — servidor rotaciona)"
                                     materialDesign:HintAssist.IsFloating="True"
                                     AcceptsReturn="True" MinHeight="40" TextWrapping="Wrap"
                                     Margin="0,0,0,6"/>
                            <TextBox Text="{Binding NewNpcAnimHitsCsv, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Hits (paths separados por ;)"
                                     materialDesign:HintAssist.IsFloating="True"
                                     AcceptsReturn="True" MinHeight="40" TextWrapping="Wrap"
                                     Margin="0,0,0,6"/>
                            <TextBox Text="{Binding NewNpcAnimDeathPath, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Death montage path"
                                     materialDesign:HintAssist.IsFloating="True"
                                     Margin="0,0,0,6"/>
                            <TextBox Text="{Binding NewNpcAnimSkillPath, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Skill montage path"
                                     materialDesign:HintAssist.IsFloating="True"
                                     Margin="0,0,0,6"/>
                            <TextBox Text="{Binding NewNpcAnimIdlePath, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Idle sequence (fallback sem AnimBP)"
                                     materialDesign:HintAssist.IsFloating="True"
                                     Margin="0,0,0,6"/>
                            <TextBox Text="{Binding NewNpcAnimWalkPath, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Walk sequence (fallback 1 eixo / Griffon)"
                                     materialDesign:HintAssist.IsFloating="True"
                                     Margin="0,0,0,6"/>
                            <TextBlock Text="Walk 4 dirs (humanoide)" FontSize="11" Opacity="0.7" Margin="0,4,0,4"/>
                            <TextBox Text="{Binding NewNpcAnimWalkFwdPath, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Walk fwd" materialDesign:HintAssist.IsFloating="True" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NewNpcAnimWalkBwdPath, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Walk bwd" materialDesign:HintAssist.IsFloating="True" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NewNpcAnimWalkLeftPath, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Walk left" materialDesign:HintAssist.IsFloating="True" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NewNpcAnimWalkRightPath, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Walk right" materialDesign:HintAssist.IsFloating="True" Margin="0,0,0,6"/>
                            <TextBlock Text="Run 4 dirs (humanoide)" FontSize="11" Opacity="0.7" Margin="0,4,0,4"/>
                            <TextBox Text="{Binding NewNpcAnimRunFwdPath, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Run fwd" materialDesign:HintAssist.IsFloating="True" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NewNpcAnimRunBwdPath, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Run bwd" materialDesign:HintAssist.IsFloating="True" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NewNpcAnimRunLeftPath, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Run left" materialDesign:HintAssist.IsFloating="True" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NewNpcAnimRunRightPath, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Run right" materialDesign:HintAssist.IsFloating="True" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding NewNpcAnimCastsCsv, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Casts/buffs montages (paths ; )"
                                     materialDesign:HintAssist.IsFloating="True"
                                     AcceptsReturn="True" MinHeight="36" TextWrapping="Wrap"
                                     Margin="0,0,0,6"/>
                            <TextBox Text="{Binding NewNpcAnimBuffsCsv, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Buffs overlay (paths ; )"
                                     materialDesign:HintAssist.IsFloating="True"
                                     Margin="0,0,0,6"/>
                            <TextBox Text="{Binding NewNpcAnimDeathMs, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Death delay ms (ex. 2000)"
                                     materialDesign:HintAssist.IsFloating="True"
                                     Margin="0,0,0,10"/>
                            <TextBox Text="{Binding NewNpcRightHandMeshPath, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Mesh mão direita (HandGrip_R)"
                                     materialDesign:HintAssist.IsFloating="True"
                                     Margin="0,0,0,6"/>
                            <TextBlock FontSize="11" Opacity="0.65" Margin="0,0,0,4" TextWrapping="Wrap"
                                       Text="Offset R: colar Relative Loc/Rot/Scale do Details do soquete (Rot = X/Y/Z do UE). Depois zerar o socket no SK."/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding NewNpcRightHandRelX, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="R Loc X" materialDesign:HintAssist.IsFloating="True"/>
                                <TextBox Grid.Column="2" Text="{Binding NewNpcRightHandRelY, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="R Loc Y" materialDesign:HintAssist.IsFloating="True"/>
                                <TextBox Grid.Column="4" Text="{Binding NewNpcRightHandRelZ, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="R Loc Z" materialDesign:HintAssist.IsFloating="True"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding NewNpcRightHandRelRotX, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="R Rot X" materialDesign:HintAssist.IsFloating="True"/>
                                <TextBox Grid.Column="2" Text="{Binding NewNpcRightHandRelRotY, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="R Rot Y" materialDesign:HintAssist.IsFloating="True"/>
                                <TextBox Grid.Column="4" Text="{Binding NewNpcRightHandRelRotZ, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="R Rot Z" materialDesign:HintAssist.IsFloating="True"/>
                                <TextBox Grid.Column="6" Text="{Binding NewNpcRightHandRelScale, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="R Scale" materialDesign:HintAssist.IsFloating="True"/>
                            </Grid>
                            <TextBox Text="{Binding NewNpcLeftHandMeshPath, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Mesh mão esquerda (HandGrip_L)"
                                     materialDesign:HintAssist.IsFloating="True"
                                     Margin="0,0,0,6"/>
                            <TextBlock FontSize="11" Opacity="0.65" Margin="0,0,0,4" TextWrapping="Wrap"
                                       Text="Offset L: colar Relative Loc/Rot/Scale do Details (Rot = X/Y/Z do UE). Depois zerar o socket no SK."/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding NewNpcLeftHandRelX, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="L Loc X" materialDesign:HintAssist.IsFloating="True"/>
                                <TextBox Grid.Column="2" Text="{Binding NewNpcLeftHandRelY, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="L Loc Y" materialDesign:HintAssist.IsFloating="True"/>
                                <TextBox Grid.Column="4" Text="{Binding NewNpcLeftHandRelZ, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="L Loc Z" materialDesign:HintAssist.IsFloating="True"/>
                            </Grid>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding NewNpcLeftHandRelRotX, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="L Rot X" materialDesign:HintAssist.IsFloating="True"/>
                                <TextBox Grid.Column="2" Text="{Binding NewNpcLeftHandRelRotY, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="L Rot Y" materialDesign:HintAssist.IsFloating="True"/>
                                <TextBox Grid.Column="4" Text="{Binding NewNpcLeftHandRelRotZ, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="L Rot Z" materialDesign:HintAssist.IsFloating="True"/>
                                <TextBox Grid.Column="6" Text="{Binding NewNpcLeftHandRelScale, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="L Scale" materialDesign:HintAssist.IsFloating="True"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding NewNpcMeshScale, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Mesh scale" materialDesign:HintAssist.IsFloating="True"/>
                                <TextBox Grid.Column="2" Text="{Binding NewNpcInteractionRadius, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Interaction radius" materialDesign:HintAssist.IsFloating="True"/>
                                <TextBox Grid.Column="4" Text="{Binding NewNpcCollisionRadius, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Collision radius" materialDesign:HintAssist.IsFloating="True"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding NewNpcNameplateRadius, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Nameplate radius" materialDesign:HintAssist.IsFloating="True"/>
                                <TextBox Grid.Column="2" Text="{Binding NewNpcRespawnSeconds, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Respawn (s)" materialDesign:HintAssist.IsFloating="True"/>
                                <TextBox Grid.Column="4" Text="{Binding NewNpcKillExp, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Kill EXP" materialDesign:HintAssist.IsFloating="True"/>
                            </Grid>
                            </StackPanel>
                            </Expander>

                            <Expander Header="IA e interação" IsExpanded="True" Style="{StaticResource ManagerFormSection}">
                            <StackPanel>
                            <TextBlock FontSize="11" Opacity="0.65" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="Roam = passeio em torno do spawn. Aggro = detecta o player. Stop range = distância para parar e atacar (0 = usa alcance de hit). Chase× = multiplicador da velocidade no aggro. Leash = distância máxima do home (0 = aggro×2)."/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding NewNpcRoamRadius, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Raio de roam (0 = parado)" materialDesign:HintAssist.IsFloating="True"/>
                                <TextBox Grid.Column="2" Text="{Binding NewNpcAggroRadius, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Raio de aggro (0 = passivo)" materialDesign:HintAssist.IsFloating="True"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding NewNpcLeashRadius, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Leash / volta ao home (0 = auto)" materialDesign:HintAssist.IsFloating="True"/>
                                <TextBox Grid.Column="2" Text="{Binding NewNpcMoveSpeed, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Velocidade de roam (uu/s)" materialDesign:HintAssist.IsFloating="True"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding NewNpcChaseSpeedMult, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Chase speed mult (ex. 1.5 = corre 50% mais)" materialDesign:HintAssist.IsFloating="True"/>
                                <TextBox Grid.Column="2" Text="{Binding NewNpcKiteSpeedMult, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Kite speed mult (afastar; 1.0 = roam)" materialDesign:HintAssist.IsFloating="True"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding NewNpcCombatStopRange, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Stop range (0 = usa alcance de ataque)" materialDesign:HintAssist.IsFloating="True"/>
                                <TextBox Grid.Column="2" Text="{Binding NewNpcAttackRange, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Alcance de hit (basic)" materialDesign:HintAssist.IsFloating="True"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding NewNpcAttackCooldownMs, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Cooldownown do ataque (ms)" materialDesign:HintAssist.IsFloating="True"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding NewNpcBasicVfxPath, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Basic Niagara (caster) /Game/...System" materialDesign:HintAssist.IsFloating="True"/>
                                <TextBox Grid.Column="2" Text="{Binding NewNpcBasicHitVfxPath, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Basic Niagara (hit no alvo)" materialDesign:HintAssist.IsFloating="True"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <CheckBox Content="Atacável" IsChecked="{Binding NewNpcIsAttackable}" Margin="0,0,16,0"/>
                                <CheckBox Content="Hostil" IsChecked="{Binding NewNpcIsHostile}" Margin="0,0,16,0"/>
                                <CheckBox Content="Vendor" IsChecked="{Binding NewNpcHasVendor}" Margin="0,0,16,0"/>
                                <CheckBox Content="Diálogo de quest" IsChecked="{Binding NewNpcHasQuestDialog}"/>
                            </StackPanel>
                            <TextBox Text="{Binding NewNpcDialogTitle, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Título de diálogo"
                                     materialDesign:HintAssist.IsFloating="True"
                                     Margin="0,0,0,10"/>
                            <TextBox Text="{Binding NewNpcDialogText, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Texto de diálogo"
                                     materialDesign:HintAssist.IsFloating="True"
                                     AcceptsReturn="True" Height="72" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" Margin="0,0,0,16"/>
                            </StackPanel>
                            </Expander>

                            <Expander Header="Skills do template" IsExpanded="False" Style="{StaticResource ManagerFormSection}">
                            <StackPanel>
                            <TextBlock FontSize="11" Opacity="0.65" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="Catálogo em Mob Skills. Weight vs auto-attack (100). CD override 0 = usa o da skill."/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding NpcSkills}"
                                          DisplayMemberPath="SkillName"
                                          SelectedValuePath="NpcSkillId"
                                          SelectedValue="{Binding NpcTemplateSkillPickId}"
                                          materialDesign:HintAssist.Hint="Skill"
                                          materialDesign:HintAssist.IsFloating="True"/>
                                <TextBox Grid.Column="2" Text="{Binding NpcTemplateSkillWeight}"
                                         materialDesign:HintAssist.Hint="Weight" materialDesign:HintAssist.IsFloating="True"/>
                                <Button Grid.Column="4" Content="Add" Command="{Binding AddNpcTemplateSkillCommand}"
                                        Style="{StaticResource ManagerActionButton}"/>
                            </Grid>
                            <DataGrid ItemsSource="{Binding NpcTemplateSkills}" AutoGenerateColumns="False"
                                      CanUserAddRows="False" Height="140" Margin="0,0,0,16">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Skill" Binding="{Binding SkillName}" Width="*"/>
                                    <DataGridTextColumn Header="Rank" Binding="{Binding SkillRank, UpdateSourceTrigger=LostFocus}" Width="50"/>
                                    <DataGridTextColumn Header="W" Binding="{Binding Weight, UpdateSourceTrigger=LostFocus}" Width="50"/>
                                    <DataGridTextColumn Header="CD ov" Binding="{Binding CooldownOverrideMs, UpdateSourceTrigger=LostFocus}" Width="60"/>
                                    <DataGridTemplateColumn Width="50">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="X" Command="{Binding DataContext.RemoveNpcTemplateSkillCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource ManagerActionOutlinedButton}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Button Content="Salvar skills do template" Command="{Binding SaveNpcTemplateSkillsCommand}"
                                    Style="{StaticResource ManagerActionOutlinedButton}" Margin="0,0,0,16"/>
                            </StackPanel>
                            </Expander>

                            <Expander Header="Spawn / instância" IsExpanded="True" Style="{StaticResource ManagerFormSection}">
                            <StackPanel>
                            <TextBlock FontSize="11" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,4"
                                       Text="1) Selecione o TEMPLATE na lista. 2) Ajuste Zone/X/Y/Z. 3) Criar nova instância = nova cópia. Atualizar posição = move a instância #ID (precisa selecionar instância)."/>
                            <TextBlock Text="{Binding SpawnTemplateLabel}" FontWeight="SemiBold"
                                       Foreground="#FFCE93D8" Margin="0,0,0,4" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding EditingNpcInstanceLabel}" FontWeight="SemiBold"
                                       Foreground="#FF80CBC4" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox Text="{Binding EditingNpcInstanceId, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="ID da instância — só para Atualizar posição"
                                     materialDesign:HintAssist.IsFloating="True"
                                     Margin="0,0,0,10"/>
                    <TextBox Text="{Binding SpawnZoneId, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Zone ID (0=zone_0, 1=zone_1)"
                                     materialDesign:HintAssist.IsFloating="True"
                                     Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding SpawnPosX, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Pos X" materialDesign:HintAssist.IsFloating="True"/>
                                <TextBox Grid.Column="2" Text="{Binding SpawnPosY, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Pos Y" materialDesign:HintAssist.IsFloating="True"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding SpawnPosZ, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Pos Z (default 200)" materialDesign:HintAssist.IsFloating="True"/>
                                <TextBox Grid.Column="2" Text="{Binding SpawnYaw, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Yaw" materialDesign:HintAssist.IsFloating="True"/>
                            </Grid>
                            <Button Content="Copiar posição do player"
                                    Command="{Binding CopySpawnFromPlayerCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    HorizontalAlignment="Stretch" Height="32" Margin="0,0,0,8"
                                    AutomationProperties.Name="Copiar posição do player"/>
                            </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </TabItem>

    <!-- Instâncias no mundo -->
    <TabItem Header="Instâncias no mundo">
        <DockPanel Margin="8">
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <Button Content="Atualizar instâncias" Command="{Binding RefreshNpcInstancesCommand}"
                        Style="{StaticResource ManagerActionOutlinedButton}" Margin="0,0,8,4"/>
                <Button Content="Duplicar em nova posição" Command="{Binding DuplicateNpcInstanceCommand}"
                        Style="{StaticResource ManagerActionOutlinedButton}" Margin="0,0,8,4"
                        ToolTip="Usa o template da instância selecionada e cria outra nas coords Zone/X/Y/Z do formulário Templates"/>
                <Button Content="Criar instância" Command="{Binding SpawnNpcCommand}"
                        Style="{StaticResource ManagerActionButton}" Margin="0,0,8,4"
                        AutomationProperties.Name="Criar instância NPC"/>
                <Button Content="Atualizar posição" Command="{Binding UpdateNpcInstancePositionCommand}"
                        Style="{StaticResource ManagerActionOutlinedButton}" Margin="0,0,8,4"
                        AutomationProperties.Name="Atualizar posição da instância"/>
                <TextBox Width="80" Margin="0,0,8,4"
                         Text="{Binding InstanceZoneFilter, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Filtro zone (0=todas)"
                         materialDesign:HintAssist.IsFloating="True"/>
                <TextBlock Text="{Binding NpcInstances.Count, StringFormat={}{0} instância(s)}"
                           VerticalAlignment="Center" Margin="8,0,0,4" Opacity="0.7"/>
            </WrapPanel>

            <DataGrid Style="{StaticResource ManagerDataGrid}" ItemsSource="{Binding NpcInstances}"
                      SelectedItem="{Binding SelectedNpcInstance}" IsReadOnly="True">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Preencher spawn / editar posição (aba Templates)"
                                  Command="{Binding PlacementTarget.DataContext.FillSpawnFromInstanceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="Duplicar em nova posição"
                                  Command="{Binding PlacementTarget.DataContext.DuplicateNpcInstanceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="Atualizar posição no mundo"
                                  Command="{Binding PlacementTarget.DataContext.UpdateNpcInstancePositionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="Despawar runtime"
                                  Command="{Binding PlacementTarget.DataContext.DespawnNpcInstanceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <Separator/>
                        <MenuItem Header="Excluir instância"
                                  Command="{Binding PlacementTarget.DataContext.DeleteNpcInstanceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Instance ID" Binding="{Binding InstanceId}" Width="90"/>
                    <DataGridTextColumn Header="Template" Binding="{Binding TemplateLabel}" Width="200"/>
                    <DataGridTextColumn Header="Zone" Binding="{Binding ZoneId}" Width="55"/>
                    <DataGridTextColumn Header="X" Binding="{Binding PosX, StringFormat=F1}" Width="80"/>
                    <DataGridTextColumn Header="Y" Binding="{Binding PosY, StringFormat=F1}" Width="80"/>
                    <DataGridTextColumn Header="Z" Binding="{Binding PosZ, StringFormat=F1}" Width="80"/>
                    <DataGridTextColumn Header="Yaw" Binding="{Binding Yaw, StringFormat=F1}" Width="60"/>
                    <DataGridTextColumn Header="HP" Binding="{Binding CurrentHealth}" Width="70"/>
                    <DataGridCheckBoxColumn Header="Morto" Binding="{Binding IsDead}" Width="60"/>
                    <DataGridTextColumn Header="Criado" Binding="{Binding CreatedAt}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </TabItem>

    <!-- Loot do mob (template selecionado) -->
    <TabItem Header="Loot do mob">
        <views:NpcLootEditorView/>
    </TabItem>

    <!-- Vendor (venda) -->
    <TabItem Header="Vendor (venda)">
        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="{Binding VendorTargetLabel}" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding VendorTabHint}" Margin="0,0,0,8" TextWrapping="Wrap" Opacity="0.8" FontSize="12"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Carregar estoque" Command="{Binding RefreshVendorStockCommand}" Margin="0,0,8,0"/>
                        <Button Content="Ensure vendor" Command="{Binding EnsureNpcVendorCommand}" Margin="0,0,8,0"
                                Style="{StaticResource MaterialDesignOutlinedButton}"/>
                        <Button Content="Novo item" Command="{Binding NewVendorStockEntryCommand}" Margin="0,0,8,0"
                                Style="{StaticResource MaterialDesignOutlinedButton}"/>
                        <TextBlock Text="{Binding VendorStockEntries.Count, StringFormat={}{0} itens}"
                                   VerticalAlignment="Center" Opacity="0.7"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBox Width="180" Margin="0,0,8,0"
                                 Text="{Binding VendorDisplayName, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Nome da loja"
                                 materialDesign:HintAssist.IsFloating="True"/>
                        <TextBox Width="100" Margin="0,0,8,0"
                                 Text="{Binding VendorSellRatePercent, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Sell % (buyback)"
                                 materialDesign:HintAssist.IsFloating="True"/>
                    </StackPanel>
                </StackPanel>

                <DataGrid Style="{StaticResource ManagerDataGrid}" ItemsSource="{Binding VendorStockEntries}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding StockId}" Width="55"/>
                        <DataGridTextColumn Header="Item" Binding="{Binding ItemLabel}" Width="*"/>
                        <DataGridTextColumn Header="Preço" Binding="{Binding BuyPriceGold}" Width="70"/>
                        <DataGridTextColumn Header="Estoque" Binding="{Binding StockQtyLabel}" Width="70"/>
                        <DataGridTextColumn Header="Max/tx" Binding="{Binding MaxBuyPerTx}" Width="60"/>
                        <DataGridCheckBoxColumn Header="Ativo" Binding="{Binding IsActive}" Width="55"/>
                        <DataGridTextColumn Header="Ord" Binding="{Binding SortOrder}" Width="45"/>
                        <DataGridTemplateColumn Header="Ações" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Editar" Margin="2" Padding="8,2" Height="26"
                                                Command="{Binding DataContext.EditVendorStockEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Excluir" Margin="2" Padding="8,2" Height="26"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Command="{Binding DataContext.DeleteVendorStockEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" Background="Transparent"
                          ShowsPreview="True" ResizeBehavior="PreviousAndNext"/>

            <Border Grid.Column="2" Style="{StaticResource ManagerEditorCard}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding VendorFormTitle}" Style="{StaticResource ManagerEditorTitle}"/>
                        <TextBlock FontSize="11" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,12"
                                   Text="Itens vendidos por este NPC (npc_vendor_stock). Qty -1 = estoque infinito."/>

                        <TextBlock Text="Escolher item" FontWeight="SemiBold" Margin="0,0,0,6" Opacity="0.85"/>
                        <ComboBox ItemsSource="{Binding Items}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding VendorStockItemTemplateId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True"
                                  StaysOpenOnEdit="True"
                                  IsTextSearchEnabled="True"
                                  Margin="0,0,0,8"
                                  materialDesign:HintAssist.Hint="Item"/>
                        <TextBox Text="{Binding VendorStockItemTemplateId, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,8"
                                 materialDesign:HintAssist.Hint="Item Template ID"
                                 materialDesign:HintAssist.IsFloating="True"/>

                        <TextBox Text="{Binding VendorStockBuyPrice, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,8"
                                 materialDesign:HintAssist.Hint="Preço (gold)"
                                 materialDesign:HintAssist.IsFloating="True"/>
                        <TextBox Text="{Binding VendorStockQty, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,8"
                                 materialDesign:HintAssist.Hint="Estoque (-1 = ∞)"
                                 materialDesign:HintAssist.IsFloating="True"/>
                        <TextBox Text="{Binding VendorStockMaxBuy, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,8"
                                 materialDesign:HintAssist.Hint="Máx por compra"
                                 materialDesign:HintAssist.IsFloating="True"/>
                        <TextBox Text="{Binding VendorStockSortOrder, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,8"
                                 materialDesign:HintAssist.Hint="Ordem"
                                 materialDesign:HintAssist.IsFloating="True"/>
                        <CheckBox Content="Ativo" IsChecked="{Binding VendorStockIsActive}" Margin="0,0,0,12"/>

                        <Button Content="Salvar estoque" Command="{Binding SaveVendorStockEntryCommand}"
                                Style="{StaticResource ManagerFormPrimaryButton}"/>
                        <Button Content="Limpar formulário" Command="{Binding NewVendorStockEntryCommand}"
                                Margin="0,8,0,0" Style="{StaticResource ManagerFormSecondaryButton}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </TabItem>

    <!-- Quests do NPC -->
    <TabItem Header="Quests do NPC">
        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="380"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="480"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="{Binding QuestTargetLabel}" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding QuestTabHint}" Margin="0,0,0,8" TextWrapping="Wrap" Opacity="0.8" FontSize="12"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Carregar quests" Command="{Binding RefreshNpcQuestOffersCommand}" Margin="0,0,8,0"/>
                        <Button Content="Nova quest" Command="{Binding NewNpcQuestCommand}" Margin="0,0,8,0"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                IsEnabled="{Binding CanEditNpcQuests}"/>
                        <TextBlock Text="{Binding NpcQuestOffers.Count, StringFormat={}{0} offers}"
                                   VerticalAlignment="Center" Opacity="0.7"/>
                    </StackPanel>
                </StackPanel>

                <DataGrid Style="{StaticResource ManagerDataGrid}" ItemsSource="{Binding NpcQuestOffers}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Offer" Binding="{Binding OfferId}" Width="55"/>
                        <DataGridTextColumn Header="Quest" Binding="{Binding QuestId}" Width="55"/>
                        <DataGridTextColumn Header="Key" Binding="{Binding QuestKey}" Width="140"/>
                        <DataGridTextColumn Header="Título" Binding="{Binding Title}" Width="*"/>
                        <DataGridTextColumn Header="Lv" Binding="{Binding MinLevel}" Width="40"/>
                        <DataGridCheckBoxColumn Header="Ativa" Binding="{Binding IsActive}" Width="50"/>
                        <DataGridTemplateColumn Header="Ações" Width="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Editar" Margin="2" Padding="6,2" Height="26"
                                                Command="{Binding DataContext.EditNpcQuestOfferCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Unlink" Margin="2" Padding="6,2" Height="26"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Command="{Binding DataContext.DeleteNpcQuestOfferCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Apagar" Margin="2" Padding="6,2" Height="26"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Command="{Binding DataContext.DeleteNpcQuestCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" Background="Transparent"
                          ShowsPreview="True" ResizeBehavior="PreviousAndNext"/>

            <Border Grid.Column="2" Style="{StaticResource ManagerEditorCard}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding QuestFormTitle}" Style="{StaticResource ManagerEditorTitle}"/>
                        <TextBlock FontSize="11" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,12"
                                   Text="Cria/edita quest + offer neste NPC. Objetivos: talk/kill/collect/deliver (+ JSON para reach_area)."/>

                        <TextBox Text="{Binding QuestKey, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                                 materialDesign:HintAssist.Hint="quest_key (único)"
                                 materialDesign:HintAssist.IsFloating="True"/>
                        <TextBox Text="{Binding QuestTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                                 materialDesign:HintAssist.Hint="Título"
                                 materialDesign:HintAssist.IsFloating="True"/>
                        <TextBox Text="{Binding QuestDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                                 AcceptsReturn="True" Height="48" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 materialDesign:HintAssist.Hint="Descrição"
                                 materialDesign:HintAssist.IsFloating="True"/>
                        <TextBox Text="{Binding QuestOfferText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                                 AcceptsReturn="True" Height="48" TextWrapping="Wrap"
                                 materialDesign:HintAssist.Hint="Texto de oferta"
                                 materialDesign:HintAssist.IsFloating="True"/>
                        <TextBox Text="{Binding QuestTurnInText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                                 AcceptsReturn="True" Height="48" TextWrapping="Wrap"
                                 materialDesign:HintAssist.Hint="Texto de entrega"
                                 materialDesign:HintAssist.IsFloating="True"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBox Width="80" Margin="0,0,8,0"
                                     Text="{Binding QuestMinLevel, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Min Lv"
                                     materialDesign:HintAssist.IsFloating="True"/>
                            <TextBox Width="110" Margin="0,0,8,0"
                                     Text="{Binding QuestPrerequisiteQuestId, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Pré-req quest ID"
                                     materialDesign:HintAssist.IsFloating="True"/>
                            <TextBox Width="100" Margin="0,0,8,0"
                                     Text="{Binding QuestTurnInNpcTemplateId, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Turn-in template"
                                     materialDesign:HintAssist.IsFloating="True"/>
                            <TextBox Width="70"
                                     Text="{Binding QuestOfferSortOrder, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Ord"
                                     materialDesign:HintAssist.IsFloating="True"/>
                        </StackPanel>
                        <TextBlock FontSize="11" Opacity="0.65" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Pré-req quest ID: 0 = sem pré-requisito. O jogador precisa ter completado essa quest para aceitar esta."/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <CheckBox Content="Repeatable" IsChecked="{Binding QuestRepeatable}" Margin="0,0,16,0"/>
                            <CheckBox Content="Ativa" IsChecked="{Binding QuestIsActive}"/>
                        </StackPanel>

                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Objetivos" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Content="+ Objetivo" Command="{Binding AddQuestObjectiveCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" Height="28" Padding="8,0"/>
                        </DockPanel>
                        <DataGrid Style="{StaticResource ManagerDataGrid}" ItemsSource="{Binding QuestObjectives}"
                                  SelectedItem="{Binding SelectedQuestObjective}" CanUserAddRows="False" MinHeight="100" MaxHeight="180" Margin="0,0,0,8"
                                  x:Name="QuestObjectivesGrid">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Tipo" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.QuestObjectiveTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedItem="{Binding ObjectiveType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEditable="False"
                                                      VerticalAlignment="Center"
                                                      Margin="2,1"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Descrição" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     VerticalAlignment="Center"
                                                     Margin="2,1"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Alvo ID" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding TargetId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     BorderThickness="0" Background="Transparent"
                                                     VerticalAlignment="Center" Margin="2,1"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Qtd" Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding RequiredCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     BorderThickness="0" Background="Transparent"
                                                     VerticalAlignment="Center" Margin="2,1"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="X" Padding="6,0" Height="24"
                                                    Command="{Binding DataContext.RemoveQuestObjectiveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <UniformGrid Columns="3" Margin="0,0,0,12">
                            <TextBox Text="{Binding SelectedQuestObjective.ZoneId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"
                                     materialDesign:HintAssist.Hint="zone_id" materialDesign:HintAssist.IsFloating="True"/>
                            <TextBox Text="{Binding SelectedQuestObjective.PosX, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"
                                     materialDesign:HintAssist.Hint="pos_x" materialDesign:HintAssist.IsFloating="True"/>
                            <TextBox Text="{Binding SelectedQuestObjective.PosY, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="pos_y" materialDesign:HintAssist.IsFloating="True"/>
                            <TextBox Text="{Binding SelectedQuestObjective.PosZ, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"
                                     materialDesign:HintAssist.Hint="pos_z" materialDesign:HintAssist.IsFloating="True"/>
                            <TextBox Text="{Binding SelectedQuestObjective.Radius, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"
                                     materialDesign:HintAssist.Hint="radius" materialDesign:HintAssist.IsFloating="True"/>
                            <TextBox Text="{Binding SelectedQuestObjective.ItemTemplateId, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="item_template_id (use_item_at)" materialDesign:HintAssist.IsFloating="True"/>
                        </UniformGrid>

                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Recompensas" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Content="+ Reward" Command="{Binding AddQuestRewardCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" Height="28" Padding="8,0"/>
                        </DockPanel>
                        <DataGrid Style="{StaticResource ManagerDataGrid}" ItemsSource="{Binding QuestRewards}"
                                  SelectedItem="{Binding SelectedQuestReward}" CanUserAddRows="False" MinHeight="80" MaxHeight="150" Margin="0,0,0,12">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Tipo" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.QuestRewardTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedItem="{Binding RewardType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEditable="False"
                                                      VerticalAlignment="Center"
                                                      Margin="2,1"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Amount" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Amount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     BorderThickness="0" Background="Transparent"
                                                     VerticalAlignment="Center" Margin="2,1"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Item ID" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding ItemTemplateId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     BorderThickness="0" Background="Transparent"
                                                     VerticalAlignment="Center" Margin="2,1"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Qty" Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     BorderThickness="0" Background="Transparent"
                                                     VerticalAlignment="Center" Margin="2,1"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="X" Padding="6,0" Height="24"
                                                    Command="{Binding DataContext.RemoveQuestRewardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock FontSize="11" Opacity="0.65" TextWrapping="Wrap" Margin="0,0,0,6"
                                   Text="Reward Choices: 1 pick por choice_group_id no turn-in (ex.: grupo 1=armas, grupo 2=armaduras). Mostra todas as classes; jogador pode escolher qualquer opção."/>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Reward Choices" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Content="+ Choice" Command="{Binding AddQuestRewardChoiceCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" Height="28" Padding="8,0"/>
                        </DockPanel>
                        <DataGrid Style="{StaticResource ManagerDataGrid}" ItemsSource="{Binding QuestRewardChoices}"
                                  SelectedItem="{Binding SelectedQuestRewardChoice}" CanUserAddRows="False" MinHeight="80" MaxHeight="180" Margin="0,0,0,12">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Grupo" Width="55">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding ChoiceGroupId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     BorderThickness="0" Background="Transparent"
                                                     VerticalAlignment="Center" Margin="2,1"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Label" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     BorderThickness="0" Background="Transparent"
                                                     VerticalAlignment="Center" Margin="2,1"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Tipo" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.QuestRewardTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedItem="{Binding RewardType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEditable="False"
                                                      VerticalAlignment="Center"
                                                      Margin="2,1"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Amount" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Amount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     BorderThickness="0" Background="Transparent"
                                                     VerticalAlignment="Center" Margin="2,1"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Item ID" Width="65">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding ItemTemplateId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     BorderThickness="0" Background="Transparent"
                                                     VerticalAlignment="Center" Margin="2,1"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Qty" Width="45">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     BorderThickness="0" Background="Transparent"
                                                     VerticalAlignment="Center" Margin="2,1"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="" Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="X" Padding="6,0" Height="24"
                                                    Command="{Binding DataContext.RemoveQuestRewardChoiceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock FontSize="11" Opacity="0.65" TextWrapping="Wrap" Margin="0,0,0,6"
                                   Text="Itens ao aceitar: concedidos no inventário ao Accept. Itens para iniciar: posse obrigatória (não consome)."/>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Itens ao aceitar" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Content="+ Grant" Command="{Binding AddQuestAcceptGrantCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" Height="28" Padding="8,0"/>
                        </DockPanel>
                        <DataGrid Style="{StaticResource ManagerDataGrid}" ItemsSource="{Binding QuestAcceptGrants}"
                                  SelectedItem="{Binding SelectedQuestAcceptGrant}" CanUserAddRows="False" MinHeight="60" MaxHeight="120" Margin="0,0,0,12">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Item ID" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding ItemTemplateId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     BorderThickness="0" Background="Transparent"
                                                     VerticalAlignment="Center" Margin="2,1"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Qty" Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     BorderThickness="0" Background="Transparent"
                                                     VerticalAlignment="Center" Margin="2,1"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="X" Padding="6,0" Height="24"
                                                    Command="{Binding DataContext.RemoveQuestAcceptGrantCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Itens para iniciar" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Content="+ Req" Command="{Binding AddQuestStartRequirementCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" Height="28" Padding="8,0"/>
                        </DockPanel>
                        <DataGrid Style="{StaticResource ManagerDataGrid}" ItemsSource="{Binding QuestStartRequirements}"
                                  SelectedItem="{Binding SelectedQuestStartRequirement}" CanUserAddRows="False" MinHeight="60" MaxHeight="120" Margin="0,0,0,12">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Item ID" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding ItemTemplateId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     BorderThickness="0" Background="Transparent"
                                                     VerticalAlignment="Center" Margin="2,1"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Qty" Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     BorderThickness="0" Background="Transparent"
                                                     VerticalAlignment="Center" Margin="2,1"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="X" Padding="6,0" Height="24"
                                                    Command="{Binding DataContext.RemoveQuestStartRequirementCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Button Content="Salvar quest" Command="{Binding SaveNpcQuestCommand}"
                                Style="{StaticResource ManagerFormPrimaryButton}"/>
                        <Button Content="Limpar formulário" Command="{Binding NewNpcQuestCommand}"
                                Margin="0,8,0,0" Style="{StaticResource ManagerFormSecondaryButton}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </TabItem>
</TabControl>
</UserControl>
