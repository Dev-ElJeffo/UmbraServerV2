<UserControl x:Class="UmbraManager.Views.NpcLootEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
<Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="420"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="420"/>
                            </Grid.ColumnDefinitions>

                            <DockPanel Grid.Column="0">
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding LootTargetLabel}" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Carregar loot" Command="{Binding RefreshNpcLootCommand}" Margin="0,0,8,4"
                                                Style="{StaticResource ManagerActionOutlinedButton}"/>
                                        <Button Content="Usar template selecionado" Command="{Binding OpenNpcLootForSelectedTemplateCommand}" Margin="0,0,8,4"
                                                Style="{StaticResource ManagerActionOutlinedButton}"/>
                                        <Button Content="Nova entrada" Command="{Binding NewNpcLootEntryCommand}" Margin="0,0,8,4"
                                                Style="{StaticResource ManagerActionOutlinedButton}"/>
                                        <TextBlock Text="{Binding NpcLootEntries.Count, StringFormat={}{0} entradas}"
                                                   VerticalAlignment="Center" Opacity="0.7"/>
                                    </StackPanel>
                                </StackPanel>

                                <DataGrid Style="{StaticResource ManagerDataGrid}" ItemsSource="{Binding NpcLootEntries}" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID" Binding="{Binding LootEntryId}" Width="55"/>
                                        <DataGridTextColumn Header="Tipo" Binding="{Binding EntryKindLabel}" Width="70"/>
                                        <DataGridTextColumn Header="Item / Gold" Binding="{Binding ItemLabel}" Width="*"/>
                                        <DataGridTextColumn Header="Chance" Binding="{Binding DropChanceLabel}" Width="80"/>
                                        <DataGridTextColumn Header="Qtd" Binding="{Binding QuantityLabel}" Width="80"/>
                                        <DataGridCheckBoxColumn Header="Ativo" Binding="{Binding Enabled}" Width="55"/>
                                        <DataGridTextColumn Header="Ord" Binding="{Binding SortOrder}" Width="45"/>
                                        <DataGridTemplateColumn Header="Ações" Width="150">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="Editar" Margin="2" Padding="8,2" Height="26"
                                                                Command="{Binding DataContext.EditNpcLootEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Content="Excluir" Margin="2" Padding="8,2" Height="26"
                                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                                Command="{Binding DataContext.DeleteNpcLootEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>

                            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch" Background="Transparent"
                                          ShowsPreview="True" ResizeBehavior="PreviousAndNext"/>

                            <Border Grid.Column="2" Style="{StaticResource ManagerEditorCard}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="{Binding LootFormTitle}" Style="{StaticResource ManagerEditorTitle}"/>
                                        <TextBlock FontSize="11" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,12"
                                                   Text="Adiciona drops ao template do mob (npc_loot_entries). Chance 0.25 = 25%."/>

                                        <TextBlock Text="Tipo de drop" FontWeight="SemiBold" Margin="0,0,0,6" Opacity="0.85"/>
                                        <ComboBox SelectedIndex="{Binding LootEntryKind, Mode=TwoWay}" Margin="0,0,0,12">
                                            <ComboBoxItem Content="Item"/>
                                            <ComboBoxItem Content="Gold"/>
                                        </ComboBox>

                                        <TextBlock Text="Escolher item" FontWeight="SemiBold" Margin="0,0,0,6" Opacity="0.85"/>
                                        <ComboBox ItemsSource="{Binding Items}"
                                                  DisplayMemberPath="Name"
                                                  SelectedValuePath="Id"
                                                  SelectedValue="{Binding LootItemTemplateId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEditable="True"
                                                  StaysOpenOnEdit="True"
                                                  IsTextSearchEnabled="True"
                                                  Margin="0,0,0,8"
                                                  materialDesign:HintAssist.Hint="Buscar item por nome"
                                                  materialDesign:HintAssist.IsFloating="True"/>
                                        <TextBox Text="{Binding LootItemTemplateId, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="Item Template ID"
                                                 materialDesign:HintAssist.IsFloating="True"
                                                 Margin="0,0,0,12"/>

                                        <TextBlock Text="Chance e quantidade" FontWeight="SemiBold" Margin="0,0,0,6" Opacity="0.85"/>
                                        <TextBox Text="{Binding LootDropChance, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="Chance (0 a 1)"
                                                 materialDesign:HintAssist.IsFloating="True"
                                                 Margin="0,0,0,8"/>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding LootMinQty, UpdateSourceTrigger=PropertyChanged}"
                                                     materialDesign:HintAssist.Hint="Qtd mín."
                                                     materialDesign:HintAssist.IsFloating="True"/>
                                            <TextBox Grid.Column="2" Text="{Binding LootMaxQty, UpdateSourceTrigger=PropertyChanged}"
                                                     materialDesign:HintAssist.Hint="Qtd máx."
                                                     materialDesign:HintAssist.IsFloating="True"/>
                                        </Grid>
                                        <TextBox Text="{Binding LootSortOrder, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="Ordem (sort)"
                                                 materialDesign:HintAssist.IsFloating="True"
                                                 Margin="0,0,0,8"/>
                                        <CheckBox Content="Ativo" IsChecked="{Binding LootEnabled}" Margin="0,0,0,12"/>

                                        <Button Content="Salvar loot" Command="{Binding SaveNpcLootEntryCommand}"
                                                Style="{StaticResource ManagerFormPrimaryButton}"/>
                                        <Button Content="Limpar formulário" Command="{Binding NewNpcLootEntryCommand}"
                                                Margin="0,8,0,0" Style="{StaticResource ManagerFormSecondaryButton}"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
</UserControl>
