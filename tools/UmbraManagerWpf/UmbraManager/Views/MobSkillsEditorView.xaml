<UserControl x:Class="UmbraManager.Views.MobSkillsEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
  <Grid Margin="8">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MinWidth="380"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="420"/>
    </Grid.ColumnDefinitions>
    <DockPanel Grid.Column="0">
      <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
        <Button Content="Atualizar" Command="{Binding RefreshNpcSkillsCommand}" Margin="0,0,8,4"
                Style="{StaticResource ManagerActionOutlinedButton}"/>
        <Button Content="Nova skill de mob" Command="{Binding NewNpcSkillCommand}" Margin="0,0,8,4"
                Style="{StaticResource ManagerActionOutlinedButton}"/>
        <TextBox Width="180" Margin="0,0,8,4"
                 Text="{Binding NpcSkillFilterText, UpdateSourceTrigger=PropertyChanged}"
                 materialDesign:HintAssist.Hint="Buscar"
                 materialDesign:HintAssist.IsFloating="True"/>
        <TextBlock Text="{Binding NpcSkills.Count, StringFormat={}{0} skills}"
                   VerticalAlignment="Center" Opacity="0.7"/>
      </WrapPanel>
      <DataGrid Style="{StaticResource ManagerDataGrid}" ItemsSource="{Binding NpcSkills}" IsReadOnly="True">
        <DataGrid.Columns>
          <DataGridTextColumn Header="ID" Binding="{Binding NpcSkillId}" Width="50"/>
          <DataGridTextColumn Header="Key" Binding="{Binding SkillKey}" Width="140"/>
          <DataGridTextColumn Header="Nome" Binding="{Binding SkillName}" Width="160"/>
          <DataGridTextColumn Header="Tipo" Binding="{Binding TypeName}" Width="90"/>
          <DataGridTextColumn Header="Power" Binding="{Binding PowerCoef}" Width="60"/>
          <DataGridTextColumn Header="CD" Binding="{Binding CooldownMs}" Width="70"/>
          <DataGridTextColumn Header="Range" Binding="{Binding RangeMax}" Width="60"/>
          <DataGridCheckBoxColumn Header="On" Binding="{Binding IsEnabled}" Width="40"/>
          <DataGridTemplateColumn Header="Ações" Width="160">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <Button Content="Editar" Style="{StaticResource ManagerActionButton}"
                          Command="{Binding DataContext.EditNpcSkillCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding}"/>
                  <Button Content="Excluir" Style="{StaticResource ManagerActionOutlinedButton}"
                          Command="{Binding DataContext.DeleteNpcSkillCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding}"/>
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>
    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>
    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="8,0,0,0">
        <TextBlock Text="{Binding NpcSkillFormTitle}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>
        <TextBox Text="{Binding NpcSkillFormKey, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                 materialDesign:HintAssist.Hint="skill_key" materialDesign:HintAssist.IsFloating="True"/>
        <TextBox Text="{Binding NpcSkillFormName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                 materialDesign:HintAssist.Hint="skill_name" materialDesign:HintAssist.IsFloating="True"/>
        <ComboBox ItemsSource="{Binding SkillTypeOptions}" DisplayMemberPath="Display" SelectedValuePath="Id"
                  SelectedValue="{Binding NpcSkillFormTypeId}" Margin="0,0,0,6"
                  materialDesign:HintAssist.Hint="Tipo" materialDesign:HintAssist.IsFloating="True"/>
        <ComboBox ItemsSource="{Binding SkillTargetOptions}" DisplayMemberPath="Display" SelectedValuePath="Id"
                  SelectedValue="{Binding NpcSkillFormTargetId}" Margin="0,0,0,6"
                  materialDesign:HintAssist.Hint="Target" materialDesign:HintAssist.IsFloating="True"/>
        <ComboBox ItemsSource="{Binding SkillElementOptions}" DisplayMemberPath="Display" SelectedValuePath="Id"
                  SelectedValue="{Binding NpcSkillFormElementId}" Margin="0,0,0,6"
                  materialDesign:HintAssist.Hint="Elemento" materialDesign:HintAssist.IsFloating="True"/>
        <UniformGrid Columns="2" Margin="0,0,0,6">
          <TextBox Text="{Binding NpcSkillFormPowerCoef}" materialDesign:HintAssist.Hint="power_coef" materialDesign:HintAssist.IsFloating="True" Margin="0,0,4,4"/>
          <TextBox Text="{Binding NpcSkillFormCooldownMs}" materialDesign:HintAssist.Hint="cooldown_ms" materialDesign:HintAssist.IsFloating="True" Margin="0,0,0,4"/>
          <TextBox Text="{Binding NpcSkillFormCastTimeMs}" materialDesign:HintAssist.Hint="cast_ms" materialDesign:HintAssist.IsFloating="True" Margin="0,0,4,4"/>
          <TextBox Text="{Binding NpcSkillFormRangeMax}" materialDesign:HintAssist.Hint="range_max" materialDesign:HintAssist.IsFloating="True" Margin="0,0,0,4"/>
        </UniformGrid>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
          <CheckBox Content="Crit" IsChecked="{Binding NpcSkillFormCanCrit}" Margin="0,0,12,0"/>
          <CheckBox Content="IgnoreDef" IsChecked="{Binding NpcSkillFormIgnoresDefense}" Margin="0,0,12,0"/>
          <CheckBox Content="Enabled" IsChecked="{Binding NpcSkillFormIsEnabled}"/>
        </StackPanel>
        <TextBox Text="{Binding NpcSkillFormVfxKey, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                 materialDesign:HintAssist.Hint="anim path (montage UE)" materialDesign:HintAssist.IsFloating="True"/>
        <TextBox Text="{Binding NpcSkillFormVfxPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                 materialDesign:HintAssist.Hint="vfx_path (Niagara caster)" materialDesign:HintAssist.IsFloating="True"/>
        <TextBox Text="{Binding NpcSkillFormHitVfxPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                 materialDesign:HintAssist.Hint="hit_vfx_path (Niagara no alvo)" materialDesign:HintAssist.IsFloating="True"/>
        <TextBox Text="{Binding NpcSkillFormIconPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                 materialDesign:HintAssist.Hint="icon_path" materialDesign:HintAssist.IsFloating="True"/>
        <TextBox Text="{Binding NpcSkillFormDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                 AcceptsReturn="True" Height="50" TextWrapping="Wrap"
                 materialDesign:HintAssist.Hint="description" materialDesign:HintAssist.IsFloating="True"/>
        <TextBox Text="{Binding NpcSkillFormEffectsJson, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                 AcceptsReturn="True" Height="70" FontFamily="Consolas"
                 materialDesign:HintAssist.Hint="effects_json" materialDesign:HintAssist.IsFloating="True"/>
        <StackPanel Orientation="Horizontal">
          <Button Content="{Binding NpcSkillSaveButtonText}" Command="{Binding SaveNpcSkillCommand}"
                  Style="{StaticResource ManagerActionButton}" Margin="0,0,8,0"/>
          <Button Content="Limpar" Command="{Binding NewNpcSkillCommand}"
                  Style="{StaticResource ManagerActionOutlinedButton}"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
