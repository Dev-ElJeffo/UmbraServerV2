<UserControl x:Class="UmbraManager.Views.GmConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
<Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource ManagerEditorCard}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Catálogo de comandos"
                                       Style="{StaticResource ManagerEditorTitle}"/>
                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding GmCommandHelp}"
                                       Style="{StaticResource ManagerEditorSubtitle}" Margin="0,8,0,0"/>
                            <DataGrid Style="{StaticResource ManagerDataGrid}"
                                      ItemsSource="{Binding GmCommands}"
                                      SelectedItem="{Binding SelectedGmCommandDefinition}"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Comando" Binding="{Binding Name}" Width="160"/>
                                    <DataGridTextColumn Header="Escopo" Binding="{Binding ScopeLabel}" Width="80"/>
                                    <DataGridCheckBoxColumn Header="!" Binding="{Binding IsDestructive}" Width="35"/>
                                    <DataGridTemplateColumn Header="Usar" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Usar" Style="{StaticResource ManagerActionButton}"
                                                        Command="{Binding DataContext.UseGmCommandCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch" Background="Transparent"
                                  ShowsPreview="True" ResizeBehavior="PreviousAndNext"/>

                    <DockPanel Grid.Column="2">
                        <Border DockPanel.Dock="Bottom" Style="{StaticResource ManagerEditorCard}" Height="260" Margin="0,8,0,0" Padding="8">
                            <TextBox Text="{Binding GmOutputText, Mode=OneWay}"
                                     IsReadOnly="True" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     FontFamily="Consolas" FontSize="11"
                                     Background="#FF1E1E1E" Foreground="#FFECECEC"
                                     BorderThickness="0" TextWrapping="NoWrap"/>
                        </Border>
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <ComboBox Width="150" Margin="0,0,8,4"
                                      ItemsSource="{Binding Definitions}" DisplayMemberPath="Id"
                                      SelectedValue="{Binding SelectedGmService}" SelectedValuePath="Id"/>
                            <Button Content="Usar comando selecionado" Command="{Binding UseGmCommandCommand}"
                                    CommandParameter="{Binding SelectedGmCommandDefinition}" Margin="0,0,8,4"
                                    Style="{StaticResource ManagerActionOutlinedButton}"/>
                            <Button Content="Enviar" Command="{Binding SendGmCommand}" Margin="0,0,8,4"
                                    Style="{StaticResource ManagerActionButton}"/>
                            <Button Content="Limpar output" Command="{Binding ClearGmOutputCommand}" Margin="0,0,8,4"
                                    Style="{StaticResource ManagerActionOutlinedButton}"/>
                            <Button Content="Copiar" Command="{Binding CopyGmOutputCommand}" Margin="0,0,8,4"
                                    Style="{StaticResource ManagerActionOutlinedButton}"/>
                        </WrapPanel>
                        <TextBox x:Name="GmInputBox" Margin="0,0,0,0" VerticalAlignment="Top"
                                 Text="{Binding GmInput, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="comando arg=valor, suporte aspas e JSON (Tab autocomplete, ↑↓ histórico)"
                                 KeyDown="GmInput_KeyDown"
                                 Background="#FF252526"/>
                    </DockPanel>
                </Grid>
</UserControl>
