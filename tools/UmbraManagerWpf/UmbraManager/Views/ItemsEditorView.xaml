<UserControl x:Class="UmbraManager.Views.ItemsEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
<Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="500"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="460"/>
                    </Grid.ColumnDefinitions>

                    <!-- Lista -->
                    <DockPanel Grid.Column="0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Atualizar" Command="{Binding RefreshItemsCommand}" Margin="0,0,8,4"
                                    Style="{StaticResource ManagerActionOutlinedButton}"/>
                            <Button Content="Novo item" Command="{Binding NewItemCommand}" Margin="0,0,8,4"
                                    Style="{StaticResource ManagerActionOutlinedButton}"/>
                                <TextBox Width="200" Margin="0,0,8,0"
                                         Text="{Binding ItemFilterText, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Buscar nome/descrição"
                                         materialDesign:HintAssist.IsFloating="True"/>
                                <ComboBox Width="120" Margin="0,0,8,0"
                                          ItemsSource="{Binding ItemTypes}"
                                          SelectedValue="{Binding ItemFilterType}"
                                          materialDesign:HintAssist.Hint="Tipo"
                                          materialDesign:HintAssist.IsFloating="True"/>
                                <ComboBox Width="120"
                                          ItemsSource="{Binding ItemRarities}"
                                          SelectedValue="{Binding ItemFilterRarity}"
                                          materialDesign:HintAssist.Hint="Raridade"
                                          materialDesign:HintAssist.IsFloating="True"/>
                            <TextBlock Text="{Binding Items.Count, StringFormat={}{0} itens}"
                                       VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.7"/>
                        </StackPanel>

                        <DataGrid Style="{StaticResource ManagerDataGrid}" ItemsSource="{Binding Items}" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="55"/>
                                <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="220">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="90"/>
                                <DataGridTextColumn Header="Subtipo" Binding="{Binding Subtype}" Width="90"/>
                                <DataGridTextColumn Header="Slot" Binding="{Binding EquipmentSlot}" Width="90"/>
                                <DataGridTextColumn Header="Raridade" Binding="{Binding Rarity}" Width="90"/>
                                <DataGridTextColumn Header="Lv" Binding="{Binding RequiredLevel}" Width="50"/>
                                <DataGridTextColumn Header="Stack" Binding="{Binding MaxStackSize}" Width="60"/>
                                <DataGridTextColumn Header="Valor" Binding="{Binding Value}" Width="80"/>
                                <DataGridCheckBoxColumn Header="Trade" Binding="{Binding Tradeable}" Width="55"/>
                                <DataGridCheckBoxColumn Header="Refin" Binding="{Binding CanBeRefined}" Width="55"/>
                                <DataGridTemplateColumn Header="Ações" Width="180" MinWidth="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Editar" Style="{StaticResource ManagerActionButton}"
                                                        Command="{Binding DataContext.EditItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="Excluir" Style="{StaticResource ManagerActionOutlinedButton}"
                                                        Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <!-- Splitter -->
                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch" Background="Transparent"
                                  ShowsPreview="True" ResizeBehavior="PreviousAndNext"/>

                    <!-- Formulário criar/editar -->
                    <Border Grid.Column="2" Style="{StaticResource ManagerEditorCard}">
                        <DockPanel>
                            <!-- Cabeçalho -->
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <TextBlock Text="{Binding ItemFormTitle}" Style="{StaticResource ManagerEditorTitle}"/>
                                <TextBlock Text="{Binding ItemFormSubtitle}" Style="{StaticResource ManagerEditorSubtitle}"/>
                                <TextBlock Text="{Binding ItemDesignerSummary}"
                                           FontFamily="Consolas" FontSize="11" Margin="0,6,0,0" Opacity="0.8"/>
                            </StackPanel>

                            <!-- Botões em baixo -->
                            <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Limpar" Command="{Binding NewItemCommand}"
                                        Style="{StaticResource ManagerFormSecondaryButton}"/>
                                <Button Grid.Column="2"
                                        Content="{Binding ItemSaveButtonText}"
                                        Command="{Binding CreateItemCommand}"
                                        Style="{StaticResource ManagerFormPrimaryButton}"/>
                            </Grid>

                            <!-- Form scrollável -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                                <StackPanel>
                                    <!-- Bloco básico -->
                                    <TextBlock Text="Identificação" FontWeight="SemiBold" Margin="0,0,0,6" Opacity="0.85"/>
                                    <TextBox Text="{Binding NewItemName, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Nome (obrigatório)"
                                             materialDesign:HintAssist.IsFloating="True"
                                             Margin="0,0,0,10"/>
                                    <TextBox Text="{Binding NewItemDescription, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Descrição"
                                             materialDesign:HintAssist.IsFloating="True"
                                             AcceptsReturn="True" Height="64" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>
                                    <TextBox Text="{Binding NewItemIconPath, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Icon path (ex: /Game/UI/Icons/Items/ICO_Sword)"
                                             materialDesign:HintAssist.IsFloating="True"
                                             Margin="0,0,0,10"/>
                                    <TextBox Text="{Binding NewItemSkeletalMeshPath, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="SKM legado (fallback se JSON vazio)"
                                             materialDesign:HintAssist.IsFloating="True"
                                             Margin="0,0,0,10"/>

                                    <!-- Meshes visuais (multi-slot) -->
                                    <TextBlock Text="Meshes visuais (padrão)" FontWeight="SemiBold" Margin="0,0,0,6" Opacity="0.85"/>
                                    <DataGrid Style="{StaticResource ManagerDataGrid}"
                                              ItemsSource="{Binding ItemDefaultVisualMeshes}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              MaxHeight="140" Margin="0,0,0,6">
                                        <DataGrid.Columns>
                                            <DataGridComboBoxColumn Header="Slot" Width="100"
                                                ItemsSource="{Binding DataContext.ItemVisualMeshSlots, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                SelectedItemBinding="{Binding Slot, UpdateSourceTrigger=PropertyChanged}"/>
                                            <DataGridTextColumn Header="Path SKM/SM" Binding="{Binding Path, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                            <DataGridTemplateColumn Header="" Width="70">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="X" Padding="4,0"
                                                                Command="{Binding DataContext.RemoveDefaultVisualMeshRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Button Content="+ Adicionar mesh padrão" Margin="0,0,0,12"
                                            Command="{Binding AddDefaultVisualMeshRowCommand}"
                                            Style="{StaticResource ManagerActionOutlinedButton}"/>

                                    <TextBlock Text="Override por classe" FontWeight="SemiBold" Margin="0,0,0,6" Opacity="0.85"/>
                                    <ComboBox ItemsSource="{Binding GameClasses}"
                                              SelectedValuePath="ClassId"
                                              DisplayMemberPath="ClassName"
                                              SelectedValue="{Binding SelectedVisualOverrideClassId}"
                                              materialDesign:HintAssist.Hint="Classe"
                                              materialDesign:HintAssist.IsFloating="True"
                                              Margin="0,0,0,8"/>
                                    <DataGrid Style="{StaticResource ManagerDataGrid}"
                                              ItemsSource="{Binding ItemClassVisualMeshes}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              MaxHeight="120" Margin="0,0,0,6">
                                        <DataGrid.Columns>
                                            <DataGridComboBoxColumn Header="Slot" Width="100"
                                                ItemsSource="{Binding DataContext.ItemVisualMeshSlots, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                SelectedItemBinding="{Binding Slot, UpdateSourceTrigger=PropertyChanged}"/>
                                            <DataGridTextColumn Header="Path SKM/SM" Binding="{Binding Path, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                            <DataGridTemplateColumn Header="" Width="70">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="X" Padding="4,0"
                                                                Command="{Binding DataContext.RemoveClassVisualMeshRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Button Content="+ Adicionar mesh da classe" Margin="0,0,0,16"
                                            Command="{Binding AddClassVisualMeshRowCommand}"
                                            Style="{StaticResource ManagerActionOutlinedButton}"/>

                                    <!-- Bloco classificação -->
                                    <TextBlock Text="Classificação" FontWeight="SemiBold" Margin="0,0,0,6" Opacity="0.85"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" ItemsSource="{Binding ItemTypes}"
                                                  SelectedValue="{Binding NewItemType}"
                                                  materialDesign:HintAssist.Hint="Tipo"
                                                  materialDesign:HintAssist.IsFloating="True"/>
                                        <ComboBox Grid.Column="2"
                                                  IsEditable="True"
                                                  ItemsSource="{Binding ItemSubtypes}"
                                                  Text="{Binding NewItemSubtype, UpdateSourceTrigger=PropertyChanged}"
                                                  materialDesign:HintAssist.Hint="Subtipo"
                                                  materialDesign:HintAssist.IsFloating="True"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" ItemsSource="{Binding ItemRarities}"
                                                  SelectedValue="{Binding NewItemRarity}"
                                                  materialDesign:HintAssist.Hint="Raridade"
                                                  materialDesign:HintAssist.IsFloating="True"/>
                                        <ComboBox Grid.Column="2" ItemsSource="{Binding ItemCategories}"
                                                  SelectedValue="{Binding NewItemCategory}"
                                                  materialDesign:HintAssist.Hint="Categoria"
                                                  materialDesign:HintAssist.IsFloating="True"/>
                                    </Grid>
                                    <ComboBox ItemsSource="{Binding ItemEquipmentSlots}"
                                              SelectedValue="{Binding NewItemSlot}"
                                              materialDesign:HintAssist.Hint="Slot equipamento"
                                              materialDesign:HintAssist.IsFloating="True"
                                              Margin="0,0,0,16"/>

                                    <!-- Bloco numérico -->
                                    <TextBlock Text="Atributos" FontWeight="SemiBold" Margin="0,0,0,6" Opacity="0.85"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding NewItemRequiredLevel, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="Nível requerido"
                                                 materialDesign:HintAssist.IsFloating="True"/>
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding NewItemMaxStack, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="Stack máximo"
                                                 materialDesign:HintAssist.IsFloating="True"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding NewItemValue, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="Valor (gold)"
                                                 materialDesign:HintAssist.IsFloating="True"/>
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding NewItemWeight, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="Peso (kg)"
                                                 materialDesign:HintAssist.IsFloating="True"/>
                                    </Grid>
                                    <TextBox Text="{Binding NewItemUseCooldownMs, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Cooldown de uso (ms)"
                                             materialDesign:HintAssist.IsFloating="True"
                                             Margin="0,0,0,10"/>

                                    <!-- Flags -->
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,16">
                                        <CheckBox Content="Negociável" IsChecked="{Binding NewItemTradeable}" Margin="0,0,16,0"/>
                                        <CheckBox Content="Refinável"  IsChecked="{Binding NewItemCanBeRefined}"/>
                                    </StackPanel>

                                    <!-- Stats JSON -->
                                    <TextBlock Text="Stats (JSON)" FontWeight="SemiBold" Margin="0,0,0,6" Opacity="0.85"/>
                                    <TextBox Text="{Binding NewItemStatsJson, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="Consolas" FontSize="11"
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             Height="140" VerticalScrollBarVisibility="Auto"
                                             materialDesign:HintAssist.Hint="{}{&quot;strength&quot;:10,&quot;physical_attack&quot;:50}"
                                             materialDesign:HintAssist.IsFloating="True"/>
                                    <TextBlock FontSize="10" Opacity="0.6" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Text="Chaves aceitas: strength, dexterity, intelligence, vitality, physical_attack, magic_attack, physical_defense, magic_defense, accuracy, dodge, critical, resistance, double_attack_rate, double_attack_resistance, health_bonus, mana_bonus, movement"/>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
</UserControl>
